                    "expression": "(request.operation == 'UPDATE' \u0026\u0026 object.spec == oldObject.spec) || (has(object.spec.provider.vault) \u0026\u0026 object.spec.provider.vault.server in [] \u0026\u0026 has(object.spec.provider.vault.auth) \u0026\u0026 has(object.spec.provider.vault.auth.jwt) \u0026\u0026 !has(object.spec.provider.vault.auth.appRole) \u0026\u0026 !has(object.spec.provider.vault.auth.cert) \u0026\u0026 !has(object.spec.provider.vault.auth.gcp) \u0026\u0026 !has(object.spec.provider.vault.auth.iam) \u0026\u0026 !has(object.spec.provider.vault.auth.kubernetes) \u0026\u0026 !has(object.spec.provider.vault.auth.ldap) \u0026\u0026 !has(object.spec.provider.vault.auth.tokenSecretRef) \u0026\u0026 !has(object.spec.provider.vault.auth.userPass) \u0026\u0026 object.spec.provider.vault.auth.jwt.path in [] \u0026\u0026 !has(object.spec.provider.vault.auth.jwt.secretRef) \u0026\u0026 has(object.spec.provider.vault.auth.jwt.kubernetesServiceAccountToken) \u0026\u0026 object.spec.provider.vault.auth.jwt.kubernetesServiceAccountToken.serviceAccountRef.name == 'reliant-secrets' \u0026\u0026 (!has(object.spec.provider.vault.auth.jwt.kubernetesServiceAccountToken.serviceAccountRef.namespace) || object.spec.provider.vault.auth.jwt.kubernetesServiceAccountToken.serviceAccountRef.namespace == object.metadata.namespace) \u0026\u0026 has(object.spec.provider.vault.auth.jwt.kubernetesServiceAccountToken.audiences) \u0026\u0026 size(object.spec.provider.vault.auth.jwt.kubernetesServiceAccountToken.audiences) == 1 \u0026\u0026 object.spec.provider.vault.auth.jwt.kubernetesServiceAccountToken.audiences[0] in []) || (has(object.spec.provider.gcpsm) \u0026\u0026 object.spec.provider.gcpsm.projectID in [] \u0026\u0026 (!has(object.spec.provider.gcpsm.auth) || (!has(object.spec.provider.gcpsm.auth.secretRef) \u0026\u0026 !has(object.spec.provider.gcpsm.auth.workloadIdentityFederation))) \u0026\u0026 (!has(object.spec.provider.gcpsm.auth) || !has(object.spec.provider.gcpsm.auth.workloadIdentity) || object.spec.provider.gcpsm.auth.workloadIdentity.serviceAccountRef.name == 'reliant-secrets'))",
                    "message": "a SecretStore here may only dial a declared server over JWT auth (a declared mount, audience and the one store service account), or a declared Google project over Workload Identity: any other provider would ship a service-account token or read access somewhere forge did not pin (ExternalSecretsOperator.admission.servers / jwt_mounts / audiences / gcp_projects)",
