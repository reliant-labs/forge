              "spec": {
                "failurePolicy": "Fail",
                "matchConstraints": {
                  "resourceRules": [
                    {
                      "apiGroups": [
                        "external-secrets.io"
                      ],
                      "apiVersions": [
                        "*"
                      ],
                      "operations": [
                        "CREATE",
                        "UPDATE"
                      ],
                      "resources": [
                        "externalsecrets"
                      ]
                    }
                  ]
                },
                "validations": [
                  {
                    "expression": "(request.operation == 'UPDATE' \u0026\u0026 object.spec == oldObject.spec) || !has(object.spec.dataFrom) || size(object.spec.dataFrom) == 0",
                    "message": "an ExternalSecret may not use dataFrom: it copies every key a store path holds, so a Secret would carry whatever the path gains later. List each key under data",
                    "reason": "Forbidden"
                  },
                  {
                    "expression": "(request.operation == 'UPDATE' \u0026\u0026 object.spec == oldObject.spec) || !has(object.spec.secretStoreRef.kind) || object.spec.secretStoreRef.kind == 'SecretStore'",
                    "message": "an ExternalSecret may reference only a namespaced SecretStore: ClusterSecretStore is not installed on this cluster",
                    "reason": "Forbidden"
                  },
                  {
                    "expression": "(request.operation == 'UPDATE' \u0026\u0026 object.spec == oldObject.spec) || (has(object.spec.target.creationPolicy) \u0026\u0026 object.spec.target.creationPolicy in ['Orphan', 'Merge'])",
                    "message": "an ExternalSecret's target.creationPolicy must be Orphan or Merge: Owner deletes the Secret with the ExternalSecret, and None/CreateOrMerge are not part of the design",
                    "reason": "Forbidden"
                  },
                  {
                    "expression": "(request.operation == 'UPDATE' \u0026\u0026 object.spec == oldObject.spec) || (has(object.spec.target.deletionPolicy) \u0026\u0026 object.spec.target.deletionPolicy == 'Retain')",
                    "message": "an ExternalSecret's target.deletionPolicy must be Retain: a store outage or a removed value must never delete a live Secret",
                    "reason": "Forbidden"
                  },
                  {
                    "expression": "(request.operation == 'UPDATE' \u0026\u0026 object.spec == oldObject.spec) || !has(object.spec.target.name) || object.spec.target.name == object.metadata.name",
                    "message": "an ExternalSecret may write only the Secret named like itself (target.name unset or equal to metadata.name): a different name could overwrite another Secret in the namespace",
                    "reason": "Forbidden"
                  },
                  {
                    "expression": "(request.operation == 'UPDATE' \u0026\u0026 object.spec == oldObject.spec) || !has(object.spec.target.manifest)",
                    "message": "an ExternalSecret may not use a generic target (target.manifest): only Secrets are produced",
                    "reason": "Forbidden"
                  },
                  {
                    "expression": "(request.operation == 'UPDATE' \u0026\u0026 object.spec == oldObject.spec) || !has(object.spec.data) || !object.spec.data.exists(d, has(d.sourceRef))",
                    "message": "an ExternalSecret data entry may not name its own sourceRef: every entry reads from the ExternalSecret's SecretStore",
                    "reason": "Forbidden"
                  },
                  {
                    "expression": "(request.operation == 'UPDATE' \u0026\u0026 object.spec == oldObject.spec) || !has(object.spec.refreshInterval) || duration(object.spec.refreshInterval) \u003e= duration('5m')",
                    "message": "an ExternalSecret's refreshInterval must be at least 5m: a faster loop is load on the store",
                    "reason": "Forbidden"
                  }
                ]
