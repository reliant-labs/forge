[
 {
  "apiVersion": "v1",
  "kind": "Namespace",
  "metadata": {
   "labels": {
    "app.kubernetes.io/managed-by": "forge",
    "pod-security.kubernetes.io/audit": "restricted",
    "pod-security.kubernetes.io/enforce": "restricted",
    "pod-security.kubernetes.io/warn": "restricted"
   },
   "name": "acme-prod"
  }
 },
 {
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
   "labels": {
    "app.kubernetes.io/managed-by": "forge",
    "app.kubernetes.io/name": "priv",
    "app.kubernetes.io/part-of": "proj"
   },
   "name": "priv",
   "namespace": "acme-prod"
  },
  "spec": {
   "replicas": 1,
   "selector": {
    "matchLabels": {
     "app.kubernetes.io/name": "priv"
    }
   },
   "template": {
    "metadata": {
     "labels": {
      "app.kubernetes.io/managed-by": "forge",
      "app.kubernetes.io/name": "priv",
      "app.kubernetes.io/part-of": "proj"
     }
    },
    "spec": {
     "containers": [
      {
       "image": "ghcr.io/acme/p:v1",
       "imagePullPolicy": "IfNotPresent",
       "name": "priv",
       "ports": [
        {
         "containerPort": 3000,
         "name": "port-3000",
         "protocol": "TCP"
        }
       ],
       "resources": {
        "limits": {
         "cpu": "250m",
         "memory": "1Gi"
        },
        "requests": {
         "cpu": "250m",
         "memory": "1Gi"
        }
       },
       "securityContext": {
        "allowPrivilegeEscalation": false,
        "capabilities": {
         "drop": [
          "ALL"
         ]
        },
        "readOnlyRootFilesystem": true,
        "runAsGroup": 65532,
        "runAsNonRoot": true,
        "runAsUser": 65532
       }
      }
     ],
     "securityContext": {
      "runAsGroup": 65532,
      "runAsNonRoot": true,
      "runAsUser": 65532,
      "seccompProfile": {
       "type": "RuntimeDefault"
      }
     },
     "serviceAccountName": "priv"
    }
   }
  }
 },
 {
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
   "labels": {
    "app.kubernetes.io/managed-by": "forge",
    "app.kubernetes.io/name": "priv",
    "app.kubernetes.io/part-of": "proj"
   },
   "name": "priv",
   "namespace": "acme-prod"
  },
  "spec": {
   "ports": [
    {
     "name": "port-3000",
     "port": 3000,
     "protocol": "TCP",
     "targetPort": 3000
    }
   ],
   "selector": {
    "app.kubernetes.io/name": "priv"
   }
  }
 },
 {
  "apiVersion": "v1",
  "kind": "ServiceAccount",
  "metadata": {
   "labels": {
    "app.kubernetes.io/managed-by": "forge",
    "app.kubernetes.io/name": "priv",
    "app.kubernetes.io/part-of": "proj"
   },
   "name": "priv",
   "namespace": "acme-prod"
  }
 },
 {
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "Role",
  "metadata": {
   "labels": {
    "app.kubernetes.io/managed-by": "forge",
    "app.kubernetes.io/name": "priv",
    "app.kubernetes.io/part-of": "proj"
   },
   "name": "priv-role",
   "namespace": "acme-prod"
  },
  "rules": [
   {
    "apiGroups": [
     ""
    ],
    "resources": [
     "configmaps",
     "secrets"
    ],
    "verbs": [
     "get",
     "list",
     "watch"
    ]
   }
  ]
 },
 {
  "apiVersion": "rbac.authorization.k8s.io/v1",
  "kind": "RoleBinding",
  "metadata": {
   "labels": {
    "app.kubernetes.io/managed-by": "forge",
    "app.kubernetes.io/name": "priv",
    "app.kubernetes.io/part-of": "proj"
   },
   "name": "priv-rolebinding",
   "namespace": "acme-prod"
  },
  "roleRef": {
   "apiGroup": "rbac.authorization.k8s.io",
   "kind": "Role",
   "name": "priv-role"
  },
  "subjects": [
   {
    "kind": "ServiceAccount",
    "name": "priv",
    "namespace": "acme-prod"
   }
  ]
 }
]
