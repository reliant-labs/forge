# ml.k: the ML stack of this env's cluster.
#
# Generated by `forge ml discover` on 2026-11-25 from kube context "gke_acme-ml_us-east4_inference".
# This file is yours to edit. It adopts what discovery found running (forge never
# upgrades, reconfigures or removes what it did not install) and writes each
# suggested install commented out, under the id of the finding that suggests it.
#
# Wire it into this env's main.k:
#
#     import .ml
#
#     forge.Bundle {
#         ml_stacks = ml.ml_stacks
#     }
import forge

ml_stacks = [forge.MLStack {
    cluster = forge.ClusterTarget {cluster = "gke_acme-ml_us-east4_inference", namespace = "forge-ml"}
    # What discovery found running that forge did not install: the KCL refuses
    # a forge.Install of any of these kinds.
    observed = [
        "dcgm-exporter"
        "gmp"
        "kube-state-metrics"
        "node-problem-detector"
        "nvidia-device-plugin"
    ]
    observed_at = "2026-11-25"
    accelerators = [
        # 2 × nvidia-l4 (nvidia.com/gpu) on 2 nodes, pool g2-pool
        forge.Accelerators {
            vendor = "nvidia"
            # Also running: DaemonSet/monitoring/dcgm-exporter (see finding accel-exporter-duplicate).
            metrics = forge.Adopt {kind = "dcgm-exporter", namespace = "gke-managed-system", version = "3.3.5-3.4.0-gke.3", note = "managed by GKE"}
        }
    ]
    node_health = forge.Adopt {kind = "node-problem-detector", note = "managed by GKE"}
    monitoring = [
        forge.Adopt {kind = "gmp", note = "managed by GKE"}
        forge.Adopt {kind = "kube-state-metrics", namespace = "monitoring", version = "v2.14.0"}
    ]
    # Dismiss a finding until a date:
    # decisions = [forge.RecommendationDecision {id = "<finding id>", reason = "<why>", expires = "YYYY-MM-DD"}]
}]

# The scrapes of the components adopted above: forge.Adopt only records what
# runs, and the collector scrapes what this env's observability lists. Add
# them to its main.k (beside any telemetry it already lists):
#
#     forge.Bundle {
#         observability = forge.Observability {telemetry = ml.ml_telemetry}
#     }
ml_telemetry = [
    forge.Telemetry {
        service_name = "dcgm-exporter", scope = "platform", cluster = "gke_acme-ml_us-east4_inference"
        namespaces = ["gke-managed-system"], selector = {"app.kubernetes.io/name": "gke-managed-dcgm-exporter"}
        # The fields discovery found it exporting (version-default: GKE managed DCGM metric set (cloud.google.com/kubernetes-engine/docs/how-to/dcgm-metrics, 2026-11-26)).
        metrics = [forge.MetricsScrape {port = 9400, allow = "DCGM_FI_DEV_FB_FREE|DCGM_FI_DEV_FB_TOTAL|DCGM_FI_DEV_FB_USED|DCGM_FI_DEV_GPU_TEMP|DCGM_FI_DEV_GPU_UTIL|DCGM_FI_DEV_MEMORY_TEMP|DCGM_FI_DEV_MEM_COPY_UTIL|DCGM_FI_DEV_POWER_USAGE|DCGM_FI_DEV_SM_CLOCK|DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION|DCGM_FI_PROF_DRAM_ACTIVE|DCGM_FI_PROF_GR_ENGINE_ACTIVE|DCGM_FI_PROF_NVLINK_RX_BYTES|DCGM_FI_PROF_NVLINK_TX_BYTES|DCGM_FI_PROF_PCIE_RX_BYTES|DCGM_FI_PROF_PCIE_TX_BYTES|DCGM_FI_PROF_PIPE_FP16_ACTIVE|DCGM_FI_PROF_PIPE_FP32_ACTIVE|DCGM_FI_PROF_PIPE_FP64_ACTIVE|DCGM_FI_PROF_PIPE_TENSOR_ACTIVE|DCGM_FI_PROF_SM_ACTIVE"}]
    }
]
