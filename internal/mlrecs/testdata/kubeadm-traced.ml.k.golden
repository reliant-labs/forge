# ml.k: the ML stack of this env's cluster.
#
# Generated by `forge ml discover` on 2026-11-26 from kube context "kubernetes-admin@gpu-lab".
# This file is yours to edit. It adopts what discovery found running (forge never
# upgrades, reconfigures or removes what it did not install) and writes each
# suggested install commented out, under the id of the finding that suggests it.
#
# Wire it into this env's main.k:
#
#     import .ml
#
#     forge.Bundle {
#         ml_stacks = ml.ml_stacks
#     }
import forge

ml_stacks = [forge.MLStack {
    cluster = forge.ClusterTarget {cluster = "kubernetes-admin@gpu-lab", namespace = "forge-ml"}
    # What discovery found running that forge did not install: the KCL refuses
    # a forge.Install of any of these kinds.
    observed = [
        "beyla"
        "dcgm-exporter"
        "node-problem-detector"
        "nvidia-device-plugin"
        "otel-collector"
        "parca-agent"
        "vllm"
    ]
    observed_at = "2026-11-26"
    accelerators = [
        # 8 × NVIDIA-L40S (nvidia.com/gpu) on 2 nodes
        forge.Accelerators {
            vendor = "nvidia"
            metrics = forge.Adopt {kind = "dcgm-exporter", namespace = "monitoring", version = "3.3.9-3.6.1-ubuntu22.04"}
        }
    ]
    node_health = forge.Adopt {kind = "node-problem-detector", namespace = "kube-system", version = "v0.8.19"}
    # Suggested for finding gpu-jobs-bypass-queue: uncomment to install.
    # queue = forge.Install {
    #     kind = "kueue"
    #     # It ships CRDs, so it is a bootstrap chart: apply it with `forge env deploy <env> --target kueue`.
    #     chart = forge.HelmChart {
    #         name = "kueue"
    #         oci = "oci://registry.k8s.io/kueue/charts/kueue"
    #         version = "0.20.7"
    #         namespace = "forge-ml"
    #         delivery = "bootstrap"
    #     }
    # }
    training = [
        # Suggested for finding gpu-jobs-bypass-queue: uncomment to install.
        # forge.Install {
        #     kind = "jobset"
        #     # It ships CRDs, so it is a bootstrap chart: apply it with `forge env deploy <env> --target jobset`.
        #     chart = forge.HelmChart {
        #         name = "jobset"
        #         oci = "oci://registry.k8s.io/jobset/charts/jobset"
        #         version = "0.13.1"
        #         namespace = "forge-ml"
        #         delivery = "bootstrap"
        #     }
        # }
    ]
    monitoring = [forge.Adopt {kind = "otel-collector", namespace = "observability", version = "0.115.0"}]
    # Model servers found (workloads, not stack components):
    #   vllm Deployment/serving/chat
    # Dismiss a finding until a date:
    # decisions = [forge.RecommendationDecision {id = "<finding id>", reason = "<why>", expires = "YYYY-MM-DD"}]
}]

# The scrapes of the components above: forge.Adopt and forge.Install only
# declare what runs, and the collector scrapes what this env's observability
# lists. Add them to its main.k (beside any telemetry it already lists):
#
#     forge.Bundle {
#         observability = forge.Observability {telemetry = ml.ml_telemetry}
#     }
ml_telemetry = [
    forge.Telemetry {
        service_name = "dcgm-exporter", scope = "platform", cluster = "kubernetes-admin@gpu-lab"
        namespaces = ["monitoring"], selector = {"app.kubernetes.io/name": "dcgm-exporter"}
        # The fields discovery found it exporting (config: ConfigMap/monitoring/dcgm-exporter-metrics key custom.csv).
        metrics = [forge.MetricsScrape {port = 9400, allow = "DCGM_EXP_CLOCK_EVENTS_COUNT|DCGM_FI_DEV_ECC_DBE_VOL_TOTAL|DCGM_FI_DEV_ECC_SBE_VOL_TOTAL|DCGM_FI_DEV_FB_FREE|DCGM_FI_DEV_FB_USED|DCGM_FI_DEV_GPU_TEMP|DCGM_FI_DEV_GPU_UTIL|DCGM_FI_DEV_NVLINK_BANDWIDTH_TOTAL|DCGM_FI_DEV_NVLINK_CRC_FLIT_ERROR_COUNT_TOTAL|DCGM_FI_DEV_PCIE_REPLAY_COUNTER|DCGM_FI_DEV_POWER_USAGE|DCGM_FI_DEV_POWER_VIOLATION|DCGM_FI_DEV_ROW_REMAP_FAILURE|DCGM_FI_DEV_THERMAL_VIOLATION|DCGM_FI_DEV_UNCORRECTABLE_REMAPPED_ROWS|DCGM_FI_DEV_XID_ERRORS|DCGM_FI_PROF_DRAM_ACTIVE|DCGM_FI_PROF_GR_ENGINE_ACTIVE|DCGM_FI_PROF_PIPE_TENSOR_ACTIVE|DCGM_FI_PROF_SM_ACTIVE|DCGM_FI_PROF_SM_OCCUPANCY"}]
    }
]
