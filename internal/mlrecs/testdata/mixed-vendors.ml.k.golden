# ml.k: the ML stack of this env's cluster.
#
# Generated by `forge ml discover` on 2026-11-25 from kube context "lab-mixed".
# This file is yours to edit. It adopts what discovery found running (forge never
# upgrades, reconfigures or removes what it did not install) and writes each
# suggested install commented out, under the id of the finding that suggests it.
#
# Wire it into this env's main.k:
#
#     import .ml
#
#     forge.Bundle {
#         ml_stacks = ml.ml_stacks
#     }
import forge

ml_stacks = [forge.MLStack {
    cluster = forge.ClusterTarget {cluster = "lab-mixed", namespace = "forge-ml"}
    # What discovery found running that forge did not install: the KCL refuses
    # a forge.Install of any of these kinds.
    observed = [
        "amd-device-metrics-exporter"
        "amd-gpu-operator"
        "neuron-device-plugin"
        "node-problem-detector"
    ]
    observed_at = "2026-11-25"
    accelerators = [
        # 8 × AMD_Instinct_MI300X_OAM (amd.com/gpu) on 1 node
        forge.Accelerators {
            vendor = "amd"
            metrics = forge.Adopt {kind = "amd-device-metrics-exporter", namespace = "kube-amd-gpu", version = "v1.2.0"}
        }
        # 4 × tpu-v5-lite-podslice (google.com/tpu) on 1 node
        forge.Accelerators {
            vendor = "tpu"
            # TPU metrics are in Cloud Monitoring, not an in-cluster exporter.
        }
        # 32 × trn1.32xlarge (aws.amazon.com/neuroncore) on 1 node
        forge.Accelerators {
            vendor = "neuron"
        }
        # 8 × dl1.24xlarge (habana.ai/gaudi) on 1 node
        forge.Accelerators {
            vendor = "gaudi"
        }
        # 2 × device (example.com/fpga) on 1 node
        forge.Accelerators {
            vendor = "generic"
            resource = "example.com/fpga"
        }
    ]
    node_health = forge.Adopt {kind = "node-problem-detector", namespace = "kube-system", version = "v0.8.19"}
    queue = forge.Install {
        kind = "kueue"
        # It ships CRDs, so it is a bootstrap chart: apply it with `forge env deploy <env> --target kueue`.
        chart = forge.HelmChart {
            name = "kueue"
            oci = "oci://registry.k8s.io/kueue/charts/kueue"
            version = "0.20.7"
            namespace = "forge-ml"
            delivery = "bootstrap"
        }
    }
    pull_cache = forge.Install {
        kind = "spegel"
        chart = forge.HelmChart {
            name = "spegel"
            oci = "oci://ghcr.io/spegel-org/helm-charts/spegel"
            version = "0.8.2"
            namespace = "forge-ml"
            delivery = "bundle"
        }
    }
    decisions = [
        forge.RecommendationDecision {
            id = "kubelet-tracing-off"
            decision = "dismiss"
            reason = "lab nodes export kubelet traces already"
            expires = "2027-06-01"
        }
    ]
}]

# The scrapes of the components above: forge.Adopt and forge.Install only
# declare what runs, and the collector scrapes what this env's observability
# lists. Add them to its main.k (beside any telemetry it already lists):
#
#     forge.Bundle {
#         observability = forge.Observability {telemetry = ml.ml_telemetry}
#     }
ml_telemetry = [
    forge.Telemetry {
        service_name = "amd-device-metrics-exporter", scope = "platform", cluster = "lab-mixed"
        namespaces = ["kube-amd-gpu"], selector = {"app.kubernetes.io/name": "metrics-exporter"}
        # Metric names from the exporter's docs, unverified: check its /metrics.
        metrics = [forge.MetricsScrape {port = 5000, allow = "gpu_gfx_activity|gpu_used_vram|gpu_total_vram|gpu_power_usage|gpu_junction_temperature|gpu_ecc_uncorrect_total"}]
    }
]
