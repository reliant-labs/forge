import forge

ml_stacks = [forge.MLStack {
    cluster = forge.ClusterTarget {cluster = "gke_acme-web_europe-west1_web", namespace = "forge-ml"}
    # What discovery found running that forge did not install: the KCL refuses
    # a forge.Install of any of these kinds.
    observed = [
        "gmp"
        "kube-state-metrics"
        "node-problem-detector"
    ]
    observed_at = "2026-11-25"
    # No accelerators found: no node has accelerator capacity or labels.
    accelerators = []
    node_health = forge.Adopt {kind = "node-problem-detector", note = "managed by GKE"}
    monitoring = [
        forge.Adopt {kind = "gmp", note = "managed by GKE"}
        forge.Adopt {kind = "kube-state-metrics", namespace = "monitoring", version = "v2.13.0"}
    ]
    # Dismiss a finding until a date:
    # decisions = [forge.RecommendationDecision {id = "<finding id>", reason = "<why>", expires = "YYYY-MM-DD"}]
}]
