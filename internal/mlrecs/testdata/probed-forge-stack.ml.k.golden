# ml.k: the ML stack of this env's cluster.
#
# Generated by `forge ml discover` on 2026-11-26 from kube context "lab-p4d".
# This file is yours to edit. It adopts what discovery found running (forge never
# upgrades, reconfigures or removes what it did not install) and writes each
# suggested install commented out, under the id of the finding that suggests it.
#
# Wire it into this env's main.k:
#
#     import .ml
#
#     forge.Bundle {
#         ml_stacks = ml.ml_stacks
#     }
import forge

ml_stacks = [forge.MLStack {
    cluster = forge.ClusterTarget {cluster = "lab-p4d", namespace = "forge-ml"}
    # What discovery found running that forge did not install: the KCL refuses
    # a forge.Install of any of these kinds.
    observed = [
        "grafana-alloy"
        "nvidia-device-plugin"
        "otel-collector"
        "otel-ebpf-profiler"
        "triton"
    ]
    observed_at = "2026-11-26"
    accelerators = [
        # 16 × NVIDIA-A100-SXM4-40GB (nvidia.com/gpu) on 2 nodes
        forge.Accelerators {
            vendor = "nvidia"
            metrics = forge.Install {
                kind = "dcgm-exporter"
                chart = forge.HelmChart {
                    name = "dcgm-exporter"
                    repo = "https://nvidia.github.io/dcgm-exporter/helm-charts"
                    chart = "dcgm-exporter"
                    version = "4.9.0"
                    namespace = "forge-ml"
                    delivery = "bundle"
                    values = {
                        "affinity": {
                            "nodeAffinity": {
                                "requiredDuringSchedulingIgnoredDuringExecution": {
                                    "nodeSelectorTerms": [
                                        {
                                            "matchExpressions": [
                                                {
                                                    "key": "node.kubernetes.io/instance-type"
                                                    "operator": "In"
                                                    "values": [
                                                        "p4d.24xlarge"
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            }
                        }
                        "serviceMonitor": {
                            "enabled": False
                        }
                        "tolerations": [
                            {
                                "operator": "Exists"
                            }
                        ]
                    }
                }
            }
        }
    ]
    node_health = forge.Install {
        kind = "node-problem-detector"
        chart = forge.HelmChart {
            name = "node-problem-detector"
            repo = "https://charts.deliveryhero.io/"
            chart = "node-problem-detector"
            version = "2.3.14"
            namespace = "forge-ml"
            delivery = "bundle"
            values = {
                "settings": {
                    "log_monitors": [
                        "/config/kernel-monitor.json"
                        "/config/docker-monitor.json"
                    ]
                }
            }
        }
    }
    monitoring = [forge.Adopt {kind = "otel-collector", namespace = "monitoring", version = "0.115.0"}]
    # Model servers found (workloads, not stack components):
    #   triton Deployment/serving/triton
    # Dismiss a finding until a date:
    # decisions = [forge.RecommendationDecision {id = "<finding id>", reason = "<why>", expires = "YYYY-MM-DD"}]
}]

# The scrapes of the components above: forge.Adopt and forge.Install only
# declare what runs, and the collector scrapes what this env's observability
# lists. Add them to its main.k (beside any telemetry it already lists):
#
#     forge.Bundle {
#         observability = forge.Observability {telemetry = ml.ml_telemetry}
#     }
ml_telemetry = [
    forge.Telemetry {
        service_name = "dcgm-exporter", scope = "platform", cluster = "lab-p4d"
        namespaces = ["forge-ml"], selector = {"app.kubernetes.io/name": "dcgm-exporter"}
        metrics = [forge.MetricsScrape {port = 9400, allow = "DCGM_FI_DEV_SM_CLOCK_HERTZ|DCGM_FI_DEV_MEMORY_CLOCK_HERTZ|DCGM_FI_DEV_MEMORY_TEMP_CELSIUS|DCGM_FI_DEV_GPU_TEMP_CELSIUS|DCGM_FI_DEV_BOARD_POWER_WATTS|DCGM_FI_DEV_GPU_ENERGY_JOULES_TOTAL|DCGM_FI_DEV_GPU_POWER_THROTTLE_SECONDS_TOTAL|DCGM_FI_DEV_GPU_THERMAL_THROTTLE_SECONDS_TOTAL|DCGM_FI_DEV_PCIE_REPLAY_TOTAL|DCGM_FI_DEV_GPU_UTIL_RATIO|DCGM_FI_DEV_MEMORY_UTIL_RATIO|DCGM_FI_DEV_ENC_UTIL_RATIO|DCGM_FI_DEV_DEC_UTIL_RATIO|DCGM_FI_DEV_XID_ERROR|DCGM_EXP_CLOCK_EVENTS_TOTAL|DCGM_EXP_XID_ERRORS_TOTAL|DCGM_FI_DEV_FB_CAPACITY_BYTES|DCGM_FI_DEV_FB_FREE_BYTES|DCGM_FI_DEV_FB_USED_BYTES|DCGM_FI_DEV_FB_RESERVED_BYTES|DCGM_FI_DEV_ECC_SBE_VOL_TOTAL|DCGM_FI_DEV_ECC_DBE_VOL_TOTAL|DCGM_FI_DEV_PAGE_RETIRED_SBE_TOTAL|DCGM_FI_DEV_PAGE_RETIRED_DBE_TOTAL|DCGM_FI_DEV_PAGE_RETIRED_PENDING|DCGM_FI_DEV_NVLINK_CRC_ERROR_TOTAL|DCGM_FI_DEV_NVLINK_RECOVERY_TOTAL|DCGM_FI_DEV_NVLINK_REPLAY_TOTAL|DCGM_FI_DEV_NVLINK_THROUGHPUT_BYTES_PER_SECOND|DCGM_FI_DEV_VGPU_LICENSE_STATUS|DCGM_FI_DEV_ROW_REMAP_UNCORRECTABLE_TOTAL|DCGM_FI_DEV_ROW_REMAP_CORRECTABLE_TOTAL|DCGM_FI_DEV_ROW_REMAP_FAILED|DCGM_FI_SYSTEM_DRIVER_VERSION|DCGM_FI_PROF_GR_ENGINE_UTIL_RATIO|DCGM_FI_PROF_SM_UTIL_RATIO|DCGM_FI_PROF_SM_OCCUPANCY_RATIO|DCGM_FI_PROF_TENSOR_UTIL_RATIO|DCGM_FI_PROF_DRAM_UTIL_RATIO|DCGM_FI_PROF_PCIE_TX_BYTES|DCGM_FI_PROF_PCIE_RX_BYTES|DCGM_FI_PROF_NVLINK_TX_BYTES|DCGM_FI_PROF_NVLINK_RX_BYTES"}]
    }
]
