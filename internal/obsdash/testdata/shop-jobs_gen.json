{
  "name": "shop: jobs",
  "tags": [
    "forge",
    "generated"
  ],
  "tiles": [
    {
      "id": "t-restarts",
      "x": 0,
      "y": 0,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Container restarts",
        "source": "Metrics",
        "displayType": "line",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "",
            "alias": "restarts",
            "metricName": "k8s.container.restarts",
            "metricType": "gauge"
          }
        ],
        "where": "match(ResourceAttributes['k8s.workload.name'], '^(shop-migrate|shop-prune)(-[0-9a-f]{6,12})?$')",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['k8s.workload.name']",
        "granularity": "auto",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        }
      }
    },
    {
      "id": "t-error-logs",
      "x": 0,
      "y": 7,
      "w": 24,
      "h": 8,
      "config": {
        "name": "Error logs",
        "source": "Logs",
        "displayType": "search",
        "select": "Timestamp, ServiceName, SeverityText, Body",
        "where": "ServiceName IN ('shop-migrate', 'shop-prune') AND lower(SeverityText) = 'error'",
        "whereLanguage": "sql"
      }
    }
  ],
  "filters": [
    {
      "id": "filter-service",
      "type": "QUERY_EXPRESSION",
      "name": "service.name",
      "expression": "ServiceName",
      "source": "Logs",
      "whereLanguage": "sql"
    },
    {
      "id": "filter-env",
      "type": "QUERY_EXPRESSION",
      "name": "deployment.environment.name",
      "expression": "ResourceAttributes['deployment.environment.name']",
      "source": "Logs",
      "whereLanguage": "sql"
    }
  ]
}
