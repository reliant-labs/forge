# yours: scaffolded once, never touched again — forge will not overwrite this file.
# This CI workflow is a starting point you own — add jobs, secrets, and steps freely.
# Deleting it sticks (.forge/scaffolded.json); `forge project rescaffold <path>` re-creates it.
name: Build & Push Images

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      image_tag:
        description: "Override image tag (default: sha-<short>)"
        required: false
        type: string

concurrency:
  group: build-images-${{"{{"}} github.ref {{"}}"}}
  cancel-in-progress: true

# Supply chain hardening (M-12):
#   * id-token is required for sigstore/cosign's OIDC keyless signing
#     (https://docs.sigstore.dev/cosign/signing/overview/#keyless-signing).
#   * attestations is required by actions/attest-build-provenance@v1 to
#     upload the SLSA provenance statement.
# `contents: read` and `packages: write` are kept minimal so a malicious
# push can't escalate.
permissions:
  contents: read
  packages: write
  id-token: write
  attestations: write

jobs:
  build-push:
    name: Build & Push
    runs-on: ubuntu-latest
    # Built for the first env in the promotion order — the one deploy.yml
    # auto-deploys — through forge, so the image lands in the registry THAT
    # env's KCL declares (deploy/kcl/{{.BuildEnv}}/main.k). This workflow names
    # no registry: forge reads it from the declaration, and so does the deploy
    # that pulls it.
    env:
      FORGE_ENV: {{.BuildEnv}}
    # The pushed image's digest-pinned ref, from `forge registry ref` — what
    # the build recorded, never a literal here. The digest is IMMUTABLE, the
    # value every later step binds to — never the tag, which is a mutable
    # pointer anyone could re-push.
    outputs:
      ref: ${{"{{"}} steps.ref.outputs.ref {{"}}"}}
      digest: ${{"{{"}} steps.ref.outputs.digest {{"}}"}}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Install forge
        # The version comes from the project at run time — go.mod's forge, the
        # one this code compiles against — so bumping forge in go.mod is the
        # whole upgrade.
{{installForgeRun 8}}

      - name: Log in to the declared registry
        # forge logs docker in to the registry each image this env builds
        # names; the workflow supplies only the credential. GITHUB_TOKEN
        # (with `packages: write`) is the credential for GitHub's container
        # registry. For another registry, pipe its credential instead — a GAR
        # key with --username _json_key, an ECR token with --username AWS —
        # from a repository SECRET.
        env:
          LOGIN_TOKEN: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
        run: printf '%s' "$LOGIN_TOKEN" | forge registry login "$FORGE_ENV" --username "${{"{{"}} github.actor {{"}}"}}" --password-stdin

      - name: Build and push
        # `forge build <env> --push` pushes to the env's declared registry
        # and records the tag and digest in .forge/state/. `--target
        # {{.ProjectName}}` builds the project image alone: frontend images
        # are per-env (each renders that env's config.js), so deploy.yml
        # builds them. The tag is the commit's sha-<short> (or the
        # dispatch's override).
        env:
          IMAGE_TAG_OVERRIDE: ${{"{{"}} github.event.inputs.image_tag {{"}}"}}
        run: |
          tag="${IMAGE_TAG_OVERRIDE:-sha-${GITHUB_SHA::7}}"
          forge build "$FORGE_ENV" --target {{.ProjectName}} --push --tag "$tag"

      - name: Pushed image ref
        id: ref
        # <registry>/<image>@<digest>, from what the build just recorded.
        run: forge registry ref "$FORGE_ENV" --github-output

      # ── Supply chain: SBOM + signing + provenance (M-12) ────────────
      # These steps run AFTER the image is pushed and act on the immutable
      # digest forge recorded. Using the digest (not a mutable tag) binds the
      # SBOM/signature/attestation to the exact bytes pushed.

      - name: Install cosign
        uses: sigstore/cosign-installer@v3

      - name: Sign image with cosign (keyless, OIDC)
        env:
          # `--yes` skips the interactive transparency-log confirmation;
          # required for non-interactive CI runs.
          COSIGN_EXPERIMENTAL: "1"
          IMAGE_REF: ${{"{{"}} steps.ref.outputs.ref {{"}}"}}
        run: cosign sign --yes "$IMAGE_REF"

      - name: Generate SBOM (SPDX JSON)
        uses: anchore/sbom-action@v0
        with:
          image: ${{"{{"}} steps.ref.outputs.ref {{"}}"}}
          format: spdx-json
          artifact-name: sbom-{{.ProjectName}}.spdx.json
          output-file: sbom-{{.ProjectName}}.spdx.json

      - name: Upload SBOM artifact
        uses: actions/upload-artifact@v4
        with:
          name: sbom-{{.ProjectName}}
          path: sbom-{{.ProjectName}}.spdx.json
          if-no-files-found: error

      - name: Attest build provenance
        # GitHub's attestation store only accepts public repositories (or
        # private ones on GitHub Enterprise Cloud). Elsewhere the step fails
        # with "Feature not available for user-owned private repositories"
        # AFTER the image is pushed, turning every push to main red. The image
        # is still cosign-signed and ships an SBOM above; this condition only
        # skips the SLSA provenance upload. On Enterprise Cloud, drop it.
        if: ${{"{{"}} !github.event.repository.private {{"}}"}}
        uses: actions/attest-build-provenance@v1
        with:
          subject-name: ${{"{{"}} steps.ref.outputs.image {{"}}"}}
          subject-digest: ${{"{{"}} steps.ref.outputs.digest {{"}}"}}
          push-to-registry: true
{{- if .VulnDocker}}

  trivy-scan:
    name: Vulnerability Scan
    needs: build-push
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install forge
{{installForgeRun 8}}

      - name: Log in to the declared registry
        # The scanner pulls the image, so it needs the same read access.
        env:
          LOGIN_TOKEN: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
        run: printf '%s' "$LOGIN_TOKEN" | forge registry login "{{.BuildEnv}}" --username "${{"{{"}} github.actor {{"}}"}}" --password-stdin

      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@v0.35.0
        with:
          # The digest-pinned ref the build pushed — the exact bytes scanned.
          image-ref: ${{"{{"}} needs.build-push.outputs.ref {{"}}"}}
          format: table
          exit-code: "1"
          severity: CRITICAL,HIGH
{{- end}}
{{- /*
  No frontend job here. A frontend image is ENVIRONMENT-SPECIFIC — each env
  renders its own config.js (API origin, OIDC client, telemetry) into the
  build — so it cannot be built once on main. `forge build <env> --push` in
  deploy.yml builds it, after re-rendering config.js from that env's KCL. The
  raw `docker buildx build frontends/*` this replaced baked whatever
  config.js happened to be on disk (the DEV document, or nothing on a clean
  clone) into every image.
*/}}
{{- if .CutRelease}}

  # ── The CI-to-promote hop ───────────────────────────────────────────
  #
  # This is the step between "the image is in the registry" and "an
  # environment is running it". Two calls, in this order, and the order is
  # the whole design:
  #
  #   1. CUT a release — a version label over the digest that was just
  #      pushed. The control plane records it in an append-only ledger.
  #   2. PROMOTE an environment to that release. Promotion re-points at
  #      digests the release already named; it CANNOT build, because the
  #      request carries no image field in which to name bytes to produce.
  #
  # WHY TWO STEPS AND NOT ONE. A single "deploy this image" call would have
  # to accept an image reference, and a request shape that can name an image
  # is a request shape that can rebuild. Splitting them is what makes "the
  # bytes that passed staging are the bytes that reach prod" an invariant
  # rather than a promise — by the time anything is promoted, the bytes are
  # already fixed and recorded.
  #
  # BOTH CALLS ARE SAFE TO RETRY, and you will retry them: re-run jobs, a
  # transient 502, a cancelled workflow. Re-cutting the same version with the
  # same digest succeeds and creates nothing. Re-promoting to the release an
  # environment is already running appends nothing. Neither needs a cleanup
  # path, which is why there isn't one.
  #
  # IF THE PROMOTE FAILS AFTER THE CUT SUCCEEDS, the release simply exists,
  # un-promoted. That is a legitimate state — it is what every release is
  # before someone ships it — and the recovery is to re-run this workflow:
  # the cut is a no-op the second time and the promote gets another go.
  cut-release:
    name: Cut Release & Promote
    needs: build-push
    runs-on: ubuntu-latest
    # Only on the branch that produces releasable images, and never on a
    # workflow_dispatch with a custom tag — a one-off image under a hand-typed
    # tag is a debugging build, not a release.
    if: github.ref == format('refs/heads/{0}', 'main') && github.event_name == 'push'
    env:
      # The control plane's base URL. A repository VARIABLE rather than a
      # secret: it is not sensitive, and a variable is visible in the UI when
      # somebody is working out why a deploy went to the wrong place.
      CONTROL_PLANE_URL: ${{"{{"}} vars.CONTROL_PLANE_URL {{"}}"}}
      # The bearer token this workflow authenticates with.
      #
      # THE SAME MECHANISM THE SERVER ALREADY VALIDATES — the control plane
      # authenticates every RPC with a bearer token (its SetupAuth validator),
      # and forge's own deploystate.Remote client sends one the same way. This
      # deliberately does NOT invent a second scheme.
      #
      # Mint it as a machine identity scoped to your deploy org, not a
      # person's token: a human's credential in CI stops working the day they
      # leave, at which point deploys break for a reason nobody connects to
      # the cause.
      DEPLOY_TOKEN: ${{"{{"}} secrets.DEPLOY_TOKEN {{"}}"}}
      IMAGE_DIGEST: ${{"{{"}} needs.build-push.outputs.digest {{"}}"}}
    steps:
      - name: Check the deploy credentials are present
        # Fail with a sentence rather than letting curl return 401 and the
        # job report "promotion failed" — an unset secret and a rejected
        # token look identical from the response alone.
        run: |
          missing=""
          [ -n "$CONTROL_PLANE_URL" ] || missing="$missing vars.CONTROL_PLANE_URL"
          [ -n "$DEPLOY_TOKEN" ]      || missing="$missing secrets.DEPLOY_TOKEN"
          if [ -n "$missing" ]; then
            echo "Not configured for release cutting; missing:$missing" >&2
            echo "Set them in the repository settings, or delete the cut-release job." >&2
            exit 1
          fi

      - name: Cut the release
        id: cut
        # VERSION IS DERIVED FROM THE COMMIT, and that is what makes the whole
        # thing idempotent. The same commit always produces the same version
        # label, so a re-run asks for a release that already exists — and the
        # control plane's unique index on (org, version) is what turns that
        # into a no-op rather than a duplicate. A timestamp-based version
        # would cut a new release on every re-run and quietly fill the
        # promote picker with identical entries.
        run: |
          set -euo pipefail
          VERSION="sha-$(echo "${{"{{"}} github.sha {{"}}"}}" | cut -c1-7)"
          echo "version=$VERSION" >> "$GITHUB_OUTPUT"

          BODY=$(jq -n \
            --arg version   "$VERSION" \
            --arg name      "{{.ProjectName}}" \
            --arg digest    "$IMAGE_DIGEST" \
            --arg gitCommit "${{"{{"}} github.sha {{"}}"}}" \
            '{version: $version,
              artifacts: [{name: $name, digest: $digest}],
              gitCommit: $gitCommit}')

          echo "Cutting release $VERSION pinning $IMAGE_DIGEST"
          HTTP=$(curl -sS -o /tmp/cut.json -w '%{http_code}' \
            -X POST "$CONTROL_PLANE_URL/controlplane.v1.DeployService/CutRelease" \
            -H "Authorization: Bearer $DEPLOY_TOKEN" \
            -H 'Content-Type: application/json' \
            -d "$BODY")
          cat /tmp/cut.json
          if [ "$HTTP" != "200" ]; then
            echo "CutRelease failed with HTTP $HTTP" >&2
            exit 1
          fi
          # `created: false` is a SUCCESS, not a warning: it means this
          # workflow already cut this release on an earlier run.
          if [ "$(jq -r '.created // false' /tmp/cut.json)" = "true" ]; then
            echo "Cut release $VERSION"
          else
            echo "Release $VERSION was already cut — nothing to do"
          fi

      - name: Promote
        # Separate step so a promotion failure is legible as a promotion
        # failure. Collapsing the two into one script would report a failed
        # promote as a failed release cut, and send whoever is debugging it to
        # look at the wrong half.
        env:
          ENVIRONMENT_ID: ${{"{{"}} vars.DEPLOY_ENVIRONMENT_ID {{"}}"}}
        run: |
          set -euo pipefail
          if [ -z "$ENVIRONMENT_ID" ]; then
            echo "vars.DEPLOY_ENVIRONMENT_ID is not set — cut the release but promoted nothing."
            echo "The release exists and can be promoted by hand; set the variable to automate it."
            exit 0
          fi

          # NO IMAGE FIELD HERE, and there is nowhere to put one. The
          # promotion names a VERSION; the digests come from the release that
          # version already recorded. That is the entire reason this cannot
          # rebuild.
          BODY=$(jq -n \
            --arg environmentId "$ENVIRONMENT_ID" \
            --arg version       "${{"{{"}} steps.cut.outputs.version {{"}}"}}" \
            '{environmentId: $environmentId,
              version: $version,
              promotedByActor: "ci"}')

          HTTP=$(curl -sS -o /tmp/promote.json -w '%{http_code}' \
            -X POST "$CONTROL_PLANE_URL/controlplane.v1.DeployService/Promote" \
            -H "Authorization: Bearer $DEPLOY_TOKEN" \
            -H 'Content-Type: application/json' \
            -d "$BODY")
          cat /tmp/promote.json
          if [ "$HTTP" != "200" ]; then
            echo "Promote failed with HTTP $HTTP." >&2
            echo "The release IS cut. Re-run this workflow to retry the promotion —" >&2
            echo "the cut will be a no-op and nothing needs cleaning up." >&2
            exit 1
          fi
{{- end}}

  summary:
    name: Build Summary
    needs:
      - build-push
      {{- if .VulnDocker}}
      - trivy-scan
      {{- end}}
      {{- if .CutRelease}}
      - cut-release
      {{- end}}
    runs-on: ubuntu-latest
    if: always()
    steps:
      - name: Summary
        run: |
          echo "## Build Images Summary" >> "$GITHUB_STEP_SUMMARY"
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "| Image | Status |" >> "$GITHUB_STEP_SUMMARY"
          echo "|-------|--------|" >> "$GITHUB_STEP_SUMMARY"
          echo "| {{.ProjectName}} | ${{"{{"}} needs.build-push.result {{"}}"}} |" >> "$GITHUB_STEP_SUMMARY"
          {{- if .VulnDocker}}
          echo "| trivy scan | ${{"{{"}} needs.trivy-scan.result {{"}}"}} |" >> "$GITHUB_STEP_SUMMARY"
          {{- end}}
          {{- if .CutRelease}}
          echo "| release cut + promote | ${{"{{"}} needs.cut-release.result {{"}}"}} |" >> "$GITHUB_STEP_SUMMARY"
          {{- end}}
          echo "" >> "$GITHUB_STEP_SUMMARY"
          echo "**Commit:** \`${{"{{"}} github.sha {{"}}"}}\`" >> "$GITHUB_STEP_SUMMARY"
          echo "**Tag:** \`sha-$(echo ${{"{{"}} github.sha {{"}}"}} | cut -c1-7)\`" >> "$GITHUB_STEP_SUMMARY"
