# yours: scaffolded once, never touched again — forge will not overwrite this file.
# This CI workflow is a starting point you own — add jobs, secrets, and steps freely.
# Deleting it sticks (.forge/scaffolded/); `forge project rescaffold <path>` re-creates it.
name: Build & Push Images

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      image_tag:
        description: "Override image tag (default: sha-<short>)"
        required: false
        type: string

# Never cancel a build in progress on main, so every image push and its
# signing finish instead of dying half-done; a newer push supersedes the
# pending build, so the next one built is the newest commit (ci.yml says why).
# The event keeps a dispatch out of the push group. Only a pull_request run
# would ever be cancelled.
concurrency:
  group: build-images-${{"{{"}} github.event_name {{"}}"}}-${{"{{"}} github.ref {{"}}"}}
  cancel-in-progress: ${{"{{"}} github.event_name == 'pull_request' {{"}}"}}

# Supply chain hardening (M-12):
#   * id-token is required for sigstore/cosign's OIDC keyless signing
#     (https://docs.sigstore.dev/cosign/signing/overview/#keyless-signing).
#   * attestations is required by actions/attest-build-provenance@v1 to
#     upload the SLSA provenance statement.
# `contents: read` and `packages: write` are kept minimal so a malicious
# push can't escalate.
permissions:
  contents: read
  packages: write
  id-token: write
  attestations: write

jobs:
  build-push:
    name: Build & Push
    runs-on: ubuntu-latest
    timeout-minutes: 45
    # Built for the first env in the promotion order — the one deploy.yml
    # auto-deploys — through forge, so the image lands in the registry THAT
    # env's KCL declares (deploy/kcl/{{.BuildEnv}}/main.k). This workflow names
    # no registry: forge reads it from the declaration, and so does the deploy
    # that pulls it.
    env:
      FORGE_ENV: {{.BuildEnv}}
{{- if .Hosted}}
      # ONE TOKEN. {{.BuildEnv}} pushes to the platform registry, which forge
      # authenticates with this same control-plane credential — so there is no
      # registry login step, no second secret, and nothing to rotate. The push
      # logs itself in before its first byte (ADR-0003 F3).
      FORGE_CONTROL_PLANE_TOKEN: ${{"{{"}} secrets.FORGE_CONTROL_PLANE_TOKEN {{"}}"}}
{{- end}}
    # The pushed image's digest-pinned ref, from `forge registry ref` — what
    # the build recorded, never a literal here. The digest is IMMUTABLE, the
    # value every later step binds to — never the tag, which is a mutable
    # pointer anyone could re-push.
    outputs:
      ref: ${{"{{"}} steps.ref.outputs.ref {{"}}"}}
      digest: ${{"{{"}} steps.ref.outputs.digest {{"}}"}}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Install forge
        # The version comes from the project at run time — go.mod's forge, the
        # one this code compiles against — so bumping forge in go.mod is the
        # whole upgrade.
{{installForgeRun 8}}

{{- if not .Hosted}}

      - name: Log in to the declared registry
        # forge logs docker in to the registry each image this env builds
        # names; the workflow supplies only the credential. GITHUB_TOKEN
        # (with `packages: write`) is the credential for GitHub's container
        # registry. For another registry, pipe its credential instead — a GAR
        # key with --username _json_key, an ECR token with --username AWS —
        # from a repository SECRET.
        env:
          LOGIN_TOKEN: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
        run: printf '%s' "$LOGIN_TOKEN" | forge registry login "$FORGE_ENV" --username "${{"{{"}} github.actor {{"}}"}}" --password-stdin
{{- end}}

      - name: Build and push
        # `forge env build <env> --push` pushes to the env's declared registry
        # and records the tag and digest in .forge/state/. `--target
        # {{.ProjectName}}` builds the project image alone: frontend images
        # are per-env (each renders that env's config.js), so deploy.yml
        # builds them. The tag is the commit's sha-<short> (or the
        # dispatch's override).
        env:
          IMAGE_TAG_OVERRIDE: ${{"{{"}} github.event.inputs.image_tag {{"}}"}}
        run: |
          tag="${IMAGE_TAG_OVERRIDE:-sha-${GITHUB_SHA::7}}"
          forge env build "$FORGE_ENV" --target {{.ProjectName}} --push --tag "$tag"

      - name: Pushed image ref
        id: ref
        # <registry>/<image>@<digest>, from what the build just recorded.
        run: forge registry ref "$FORGE_ENV" --github-output

      # ── Supply chain: SBOM + signing + provenance (M-12) ────────────
      # These steps run AFTER the image is pushed and act on the immutable
      # digest forge recorded. Using the digest (not a mutable tag) binds the
      # SBOM/signature/attestation to the exact bytes pushed.

      - name: Install cosign
        uses: sigstore/cosign-installer@v3

      - name: Sign image with cosign (keyless, OIDC)
        env:
          # `--yes` skips the interactive transparency-log confirmation;
          # required for non-interactive CI runs.
          COSIGN_EXPERIMENTAL: "1"
          IMAGE_REF: ${{"{{"}} steps.ref.outputs.ref {{"}}"}}
        run: cosign sign --yes "$IMAGE_REF"

      - name: Generate SBOM (SPDX JSON)
        uses: anchore/sbom-action@v0
        with:
          image: ${{"{{"}} steps.ref.outputs.ref {{"}}"}}
          format: spdx-json
          artifact-name: sbom-{{.ProjectName}}.spdx.json
          output-file: sbom-{{.ProjectName}}.spdx.json

      - name: Upload SBOM artifact
        uses: actions/upload-artifact@v4
        with:
          name: sbom-{{.ProjectName}}
          path: sbom-{{.ProjectName}}.spdx.json
          if-no-files-found: error

      - name: Attach SBOM to the image (cosign attest)
        # The run artifact above expires with the run and is not where a
        # consumer of the image looks. A signed in-toto attestation in the
        # registry, beside the image, is: `cosign verify-attestation --type
        # spdxjson <image>` reads it back. Keyless, like the signature, so it
        # works on a private repository too.
        env:
          IMAGE_REF: ${{"{{"}} steps.ref.outputs.ref {{"}}"}}
        run: cosign attest --yes --type spdxjson --predicate sbom-{{.ProjectName}}.spdx.json "$IMAGE_REF"

      - name: Attest build provenance
        # GitHub's attestation store only accepts public repositories (or
        # private ones on GitHub Enterprise Cloud). Elsewhere the step fails
        # with "Feature not available for user-owned private repositories"
        # AFTER the image is pushed, turning every push to main red. The image
        # is still cosign-signed and ships an SBOM above; this condition only
        # skips the SLSA provenance upload. On Enterprise Cloud, drop it.
        if: ${{"{{"}} !github.event.repository.private {{"}}"}}
        uses: actions/attest-build-provenance@v1
        with:
          subject-name: ${{"{{"}} steps.ref.outputs.image {{"}}"}}
          subject-digest: ${{"{{"}} steps.ref.outputs.digest {{"}}"}}
          push-to-registry: true

      - name: Attest build provenance (private repositories, cosign)
        # Where GitHub's attestation store refuses the upload, the same SLSA
        # v1 provenance goes to the registry as a cosign attestation instead,
        # so a private repository's image is not left without one.
        # `cosign verify-attestation --type slsaprovenance1 <image>` reads it.
        # Every value comes from this step's env, set from the github context
        # (nothing is read from the runner's ambient environment), and the
        # predicate is checked complete before it is signed: a field that
        # resolved empty fails the step rather than attest a provenance that
        # binds the image to nothing.
        if: ${{"{{"}} github.event.repository.private {{"}}"}}
        env:
          IMAGE_REF: ${{"{{"}} steps.ref.outputs.ref {{"}}"}}
          SERVER_URL: ${{"{{"}} github.server_url {{"}}"}}
          REPOSITORY: ${{"{{"}} github.repository {{"}}"}}
          REPOSITORY_ID: ${{"{{"}} github.repository_id {{"}}"}}
          REPOSITORY_OWNER_ID: ${{"{{"}} github.repository_owner_id {{"}}"}}
          SOURCE_REF: ${{"{{"}} github.ref {{"}}"}}
          SOURCE_SHA: ${{"{{"}} github.sha {{"}}"}}
          WORKFLOW_REF: ${{"{{"}} github.workflow_ref {{"}}"}}
          EVENT_NAME: ${{"{{"}} github.event_name {{"}}"}}
          RUNNER_ENV: ${{"{{"}} runner.environment {{"}}"}}
          RUN_ID: ${{"{{"}} github.run_id {{"}}"}}
          RUN_ATTEMPT: ${{"{{"}} github.run_attempt {{"}}"}}
        run: |
          # github.workflow_ref is <owner>/<repo>/<path>@<ref>.
          workflow_path="${WORKFLOW_REF#"$REPOSITORY"/}"
          workflow_path="${workflow_path%%@*}"
          jq -n \
            --arg server "$SERVER_URL" --arg repo "$REPOSITORY" \
            --arg repo_id "$REPOSITORY_ID" --arg owner_id "$REPOSITORY_OWNER_ID" \
            --arg ref "$SOURCE_REF" --arg sha "$SOURCE_SHA" --arg path "$workflow_path" \
            --arg workflow_ref "$WORKFLOW_REF" --arg event "$EVENT_NAME" --arg runner "$RUNNER_ENV" \
            --arg run_id "$RUN_ID" --arg attempt "$RUN_ATTEMPT" '{
            buildDefinition: {
              buildType: "https://actions.github.io/buildtypes/workflow/v1",
              externalParameters: {workflow: {ref: $ref, repository: ($server + "/" + $repo), path: $path}},
              internalParameters: {github: {event_name: $event, repository_id: $repo_id, repository_owner_id: $owner_id, runner_environment: $runner}},
              resolvedDependencies: [{uri: ("git+" + $server + "/" + $repo + "@" + $ref), digest: {gitCommit: $sha}}]
            },
            runDetails: {
              builder: {id: ($server + "/" + $workflow_ref)},
              metadata: {invocationId: ($server + "/" + $repo + "/actions/runs/" + $run_id + "/attempts/" + $attempt)}
            }
          }' > provenance.json
          jq -e '
            def set: type == "string" and length > 0;
            (.buildDefinition.externalParameters.workflow | (.ref | set) and (.repository | set) and (.path | set) and (.path | startswith(".github/workflows/")))
            and (.buildDefinition.resolvedDependencies[0] | (.uri | set) and (.digest.gitCommit | test("^[0-9a-f]{40}$")))
            and (.buildDefinition.internalParameters.github | (.event_name | set))
            and (.runDetails.builder.id | set) and (.runDetails.metadata.invocationId | set)
          ' provenance.json > /dev/null || { echo "provenance predicate is incomplete:" >&2; cat provenance.json >&2; exit 1; }
          cosign attest --yes --type slsaprovenance1 --predicate provenance.json "$IMAGE_REF"
{{- if .VulnDocker}}

  trivy-scan:
    name: Vulnerability Scan
    needs: build-push
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4

      # A job is a fresh runner, and installing forge compiles it — so this
      # job needs Go even though it only scans. From go.mod, never a literal:
      # the runner's preinstalled Go is older than go.mod's `go` directive
      # sooner or later, and `go install` then refuses before forge exists.
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod

      - name: Install forge
{{installForgeRun 8}}

      - name: Log in to the declared registry
        # The scanner pulls the image, so it needs the same read access.
{{- if .Hosted}}
        # The platform registry takes the control-plane credential, so this
        # passes no --username and no password: forge resolves the same rlat_
        # it reaches the control plane with. Unlike the build job, the login
        # IS a step here — nothing in this job pushes, and trivy pulls on its
        # own rather than through forge.
        env:
          FORGE_CONTROL_PLANE_TOKEN: ${{"{{"}} secrets.FORGE_CONTROL_PLANE_TOKEN {{"}}"}}
        run: forge registry login "{{.BuildEnv}}"
{{- else}}
        env:
          LOGIN_TOKEN: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
        run: printf '%s' "$LOGIN_TOKEN" | forge registry login "{{.BuildEnv}}" --username "${{"{{"}} github.actor {{"}}"}}" --password-stdin
{{- end}}

      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@v0.35.0
        with:
          # The digest-pinned ref the build pushed — the exact bytes scanned.
          image-ref: ${{"{{"}} needs.build-push.outputs.ref {{"}}"}}
          format: table
          exit-code: "1"
          severity: CRITICAL,HIGH
{{- end}}
{{- /*
  No frontend job here. A frontend image is ENVIRONMENT-SPECIFIC — each env
  renders its own config.js (API origin, OIDC client, telemetry) into the
  build — so it cannot be built once on main. `forge env build <env> --push` in
  deploy.yml builds it, after re-rendering config.js from that env's KCL. The
  raw `docker buildx build frontends/*` this replaced baked whatever
  config.js happened to be on disk (the DEV document, or nothing on a clean
  clone) into every image.
*/}}

  summary:
    name: Build Summary
    needs:
      - build-push
      {{- if .VulnDocker}}
      - trivy-scan
      {{- end}}
    runs-on: ubuntu-latest
    timeout-minutes: 5
    if: always()
    steps:
      - name: Summary
        run: |
          {
            echo "## Build Images Summary"
            echo ""
            echo "| Image | Status |"
            echo "|-------|--------|"
            echo "| {{.ProjectName}} | ${{"{{"}} needs.build-push.result {{"}}"}} |"
            {{- if .VulnDocker}}
            echo "| trivy scan | ${{"{{"}} needs.trivy-scan.result {{"}}"}} |"
            {{- end}}
            echo ""
            echo "**Commit:** \`$GITHUB_SHA\`"
            echo "**Tag:** \`sha-${GITHUB_SHA::7}\`"
          } >> "$GITHUB_STEP_SUMMARY"
