# yours: scaffolded once, never touched again — forge will not overwrite this file.
# This CI workflow is a starting point you own — add jobs, secrets, and steps freely.
# `forge generate` re-creates it only if you delete it first.
name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

permissions:
  contents: {{.PermContents | default "read"}}

concurrency:
  group: ci-${{"{{"}} github.ref {{"}}"}}
  cancel-in-progress: true

# Go version is read from go.mod's `go` directive via setup-go's
# `go-version-file` input so CI stays in sync with the project's declared
# version without a duplicate env var that drifts.

jobs:
{{- if or .LintGolangci .LintBuf .LintFrontend .LintMigrationSafety}}
  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
{{- if .LintGolangci}}
      - name: golangci-lint
        uses: golangci/golangci-lint-action@v6
        with:
          version: latest
          args: --timeout=5m
          only-new-issues: true
{{- end}}
{{- if and .LintBuf .HasServices}}
      - name: Install buf
        uses: bufbuild/buf-setup-action@v1
      - name: Buf lint
        run: buf lint
{{- end}}
{{- if .LintMigrationSafety}}
      - name: Ensure modules are ready for forge install
        run: go mod download
      - name: Install forge
        # Reuses the same pinned forge version as verify-generated so CI runs
        # migration rules from the generator that created the project.
{{- if and .ForgeVersion (ne .ForgeVersion "dev")}}
        run: go install github.com/reliant-labs/forge/cmd/forge@{{.ForgeVersion}}
{{- else if and .ForgeGitCommit (ne .ForgeGitCommit "unknown")}}
        run: go install github.com/reliant-labs/forge/cmd/forge@{{.ForgeGitCommit}}
{{- else}}
        run: go install github.com/reliant-labs/forge/cmd/forge@main
{{- end}}
      - name: Migration safety lint
        run: forge ci migration-safety
{{- end}}
{{- if and .LintFrontend .HasFrontends}}
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          # Single source of truth: the first frontend's package.json
          # `engines.node` field. Keeps CI, the Dockerfile, and local
          # dev aligned without a duplicated Node version in the workflow.
          node-version-file: '{{(index .Frontends 0).Path}}/package.json'
          cache: 'npm'
          cache-dependency-path: |
{{- range .Frontends}}
            {{.Path}}/package-lock.json
{{- end}}
{{- range .Frontends}}
      - name: Lint {{.Name}}
        working-directory: {{.Path}}
        run: npm ci && npm run lint
      - name: Typecheck {{.Name}}
        working-directory: {{.Path}}
        # tsc --noEmit is not covered by eslint; without a dedicated
        # step, type errors only surface at `next build` time in
        # production deploys. Keep this step right after lint so
        # authors see type failures on the same PR that introduced
        # them.
        run: npm run typecheck
{{- if $.LintFrontendStyles}}
      - name: CSS health {{.Name}}
        working-directory: {{.Path}}
        run: npm run lint:styles --if-present
{{- end}}
{{- end}}
{{- end}}
{{- end}}

  test:
    name: Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
{{- if .HasFrontends}}
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          # Single source of truth: the first frontend's package.json
          # `engines.node` field. Keeps CI, the Dockerfile, and local
          # dev aligned without a duplicated Node version in the workflow.
          node-version-file: '{{(index .Frontends 0).Path}}/package.json'
          cache: 'npm'
          cache-dependency-path: |
{{- range .Frontends}}
            {{.Path}}/package-lock.json
{{- end}}
{{- range .Frontends}}
      # `npm ci` (lockfile-exact install) is CI's job, not the Taskfile's —
      # the workflow owns how the environment is PREPARED, Taskfile.yml owns
      # what "the tests" ARE. `task test` below then runs each frontend's own
      # `npm test` script.
      - name: Install {{.Name}} dependencies
        working-directory: {{.Path}}
        run: npm ci
{{- end}}
{{- end}}
      # Task is the single definition of the test suite: this job, the local
      # edit loop, and `task test:all` all run the same commands out of
      # Taskfile.yml. The workflow deliberately does NOT re-spell `go test`
      # here — that is how the two drifted apart before (CI ran a bare
      # `go test ./...` that skipped the frontend lane entirely, so a broken
      # frontend test could merge green).
      - uses: arduino/setup-task@v2
        with:
          version: 3.x
          repo-token: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
      - name: Tests
        # GOTESTRACE carries forge.yaml's `ci.test.race` through to the
        # Taskfile, which is the one place the `go test` flags are spelled.
        # Without the pass-through the key would go silently dead the moment
        # the test command moved out of this workflow.
        run: task test{{if not .TestRace}} GOTESTRACE={{end}}
{{- if .TestCoverage}}
      # `task coverage` (not a second hand-rolled `go test -coverprofile`):
      # same reason as above, and it keeps the profile flags in one place.
      - name: Go test coverage
        run: task coverage
      - name: Upload coverage
        uses: actions/upload-artifact@v4
        with:
          name: coverage
          path: coverage.out
{{- end}}

  build:
    name: Build
{{- if or .LintGolangci .LintBuf .LintFrontend .LintMigrationSafety}}
    needs: [lint, test]
{{- else}}
    needs: [test]
{{- end}}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - name: Go build
        # -trimpath makes builds reproducible across runners;
        # -buildvcs=true stamps the commit/dirty flag into runtime
        # debug/buildinfo so deployed binaries can be correlated to a
        # source commit without a separate manifest. Both flags must
        # match the Dockerfile / Taskfile so CI, Docker, and local
        # binaries hash identically from the same source.
        run: go build -trimpath -buildvcs=true ./cmd/...
{{- if .HasFrontends}}
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          # Single source of truth: the first frontend's package.json
          # `engines.node` field. Keeps CI, the Dockerfile, and local
          # dev aligned without a duplicated Node version in the workflow.
          node-version-file: '{{(index .Frontends 0).Path}}/package.json'
          cache: 'npm'
          cache-dependency-path: |
{{- range .Frontends}}
            {{.Path}}/package-lock.json
{{- end}}
{{- range .Frontends}}
      - name: Build {{.Name}}
        working-directory: {{.Path}}
        run: npm ci && NODE_ENV=production npm run build
{{- end}}
{{- end}}

{{- if .VerifyGenerated}}
  verify-generated:
    name: Verify Generated Code
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
{{- if .HasServices}}
      - name: Install buf
        uses: bufbuild/buf-setup-action@v1
{{- end}}
      - name: Install forge
        # Version is stamped at scaffold time from the forge binary that
        # produced the project. CI installs that exact ref so this step is
        # reproducible:
        #   1. Tagged/pseudo-version build → pin by module version.
        #   2. Local `dev` build with a known git SHA → pin by SHA
        #      (`go install ...@<sha>` is a valid ref).
        #   3. Neither available → fall back to @main (regenerate from a
        #      tagged release to eliminate this branch).
{{- if and .ForgeVersion (ne .ForgeVersion "dev")}}
        run: go install github.com/reliant-labs/forge/cmd/forge@{{.ForgeVersion}}
{{- else if and .ForgeGitCommit (ne .ForgeGitCommit "unknown")}}
        run: go install github.com/reliant-labs/forge/cmd/forge@{{.ForgeGitCommit}}
{{- else}}
        # TODO: regenerate from a tagged forge release to pin this install.
        run: go install github.com/reliant-labs/forge/cmd/forge@main
{{- end}}
      - name: Verify generated code
        run: forge ci verify-generated
{{- end}}
{{- if .HasKCL}}

  deployability:
    name: Deployability
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      # No KCL CLI install: forge renders through the embedded KCL
      # runtime, so the toolchain travels with the binary.
      - name: Ensure modules are ready for forge install
        run: go mod download
      - name: Install forge
{{- template "install-forge" .}}
      - name: Validate KCL manifests are applyable
        # Asserts the render is something `kubectl apply` accepts — not
        # merely that the KCL evaluates. Evaluating was the old bar, and
        # it reported green over a CD path that died on every apply.
        run: forge ci validate-kcl
      - name: Deployability checks
        # Would an SRE let this reach production: probes, resource
        # requests/limits, credentials sourced from Secrets rather than
        # literal env values, ServiceAccounts actually bound to pods.
        # Answered from the rendered manifests, so it needs no cluster
        # and no image.
        run: forge doctor --signal deploy
{{- end}}
{{- if or .VulnGo .VulnNPM}}

  vuln-scan:
    name: Vulnerability Scan
{{- if or .LintGolangci .LintBuf .LintFrontend .LintMigrationSafety}}
    needs: [lint, test]
{{- else}}
    needs: [test]
{{- end}}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{{- if .VulnGo}}
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - name: Install govulncheck
        # Pinned explicitly: @latest makes CI non-reproducible and lets a
        # compromised upstream release silently alter scan results. The
        # Dependabot config watches this file so bumps arrive as PRs.
        #
        # The pin has a FLOOR, not just a ceiling: govulncheck vendors
        # golang.org/x/tools to build the SSA it traces calls through, and a
        # copy older than the toolchain panics on syntax it cannot parse.
        # v1.1.4 vendored x/tools v0.29.0 and died with
        # `panic: unexpected expr: *ast.KeyValueExpr` under Go 1.27 — a crash,
        # not a finding, so the gate reported nothing at all. Keep this at or
        # above the release that supports the Go version in go.mod.
        run: go install golang.org/x/vuln/cmd/govulncheck@v1.7.0
      - name: Install forge
{{- template "install-forge" .}}
      - name: Go vulnerability check
        run: forge ci vuln-scan --go
{{- end}}
{{- if and .VulnNPM .HasFrontends}}
{{- if not .VulnGo}}
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - name: Install forge
{{- template "install-forge" .}}
{{- end}}
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          # Single source of truth: the first frontend's package.json
          # `engines.node` field. Keeps CI, the Dockerfile, and local
          # dev aligned without a duplicated Node version in the workflow.
          node-version-file: '{{(index .Frontends 0).Path}}/package.json'
          cache: 'npm'
          cache-dependency-path: |
{{- range .Frontends}}
            {{.Path}}/package-lock.json
{{- end}}
      - name: NPM vulnerability check
        run: forge ci vuln-scan --npm
{{- end}}
{{- end}}
{{- if .LicenseCheck}}

  license-check:
    name: License Compliance
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - name: Install go-licenses
        run: go install github.com/google/go-licenses@v1.6.0
      - name: Check licenses
        run: go-licenses check ./... --disallowed_types=forbidden,restricted
{{- end}}

{{- if .HasDocker}}
  docker-build:
    name: Docker Build
    needs: [build]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      - name: Build project image
        uses: docker/build-push-action@v6
        with:
          context: .
          file: Dockerfile
          load: true
          tags: {{.ProjectName}}:ci
          cache-from: type=gha,scope=ci-{{.ProjectName}}
          cache-to: type=gha,scope=ci-{{.ProjectName}},mode=max
{{- if .VulnDocker}}
      - name: Trivy scan
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: '{{.ProjectName}}:ci'
          format: table
          exit-code: '1'
          severity: HIGH,CRITICAL
{{- end}}
{{- if .HasFrontends}}
{{- range .Frontends}}
      - name: Build {{.Name}} image
        uses: docker/build-push-action@v6
        with:
          context: {{.Path}}
          file: {{.Path}}/Dockerfile
          load: true
          tags: {{$.ProjectName}}/{{.Name}}:ci
          cache-from: type=gha,scope=ci-{{.Name}}
          cache-to: type=gha,scope=ci-{{.Name}},mode=max
{{- if $.VulnDocker}}
      - name: Trivy scan {{.Name}}
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: '{{$.ProjectName}}/{{.Name}}:ci'
          format: table
          exit-code: '1'
          severity: HIGH,CRITICAL
{{- end}}
{{- end}}
{{- end}}
{{- end}}
{{- if .E2EEnabled}}

  e2e:
    name: E2E Tests
    needs: [docker-build]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      # Both runtimes below run the suite through `task test:e2e`, so both
      # need Go and Task. The e2e suite is Go (`go test -tags=e2e ./e2e/...`)
      # under every runtime — the runtime only decides what infrastructure it
      # talks to.
      - uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
      - uses: arduino/setup-task@v2
        with:
          version: 3.x
          repo-token: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
{{- if eq .E2ERuntime "docker-compose"}}
      - name: Run E2E tests
        # The generated harness (e2e/<service>/main_test.go) brings its OWN
        # e2e/<service>/docker-compose.e2e.yml up and tears it down. This step
        # must therefore NOT start compose itself: doing so raced the harness
        # for the same ports, and it pointed at a root-level
        # docker-compose.e2e.yml that forge has never written.
        run: task test:e2e
      - name: Upload test artifacts
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: e2e-results
          path: test-results/
{{- else if eq .E2ERuntime "k3d"}}
      - name: Install forge
        # Same pin policy as the verify-generated job — see its comment.
{{- if and .ForgeVersion (ne .ForgeVersion "dev")}}
        run: go install github.com/reliant-labs/forge/cmd/forge@{{.ForgeVersion}}
{{- else if and .ForgeGitCommit (ne .ForgeGitCommit "unknown")}}
        run: go install github.com/reliant-labs/forge/cmd/forge@{{.ForgeGitCommit}}
{{- else}}
        # TODO: regenerate from a tagged forge release to pin this install.
        run: go install github.com/reliant-labs/forge/cmd/forge@main
{{- end}}
      - name: Create k3d cluster
        uses: AbsaOSS/k3d-action@v2
        with:
          cluster-name: e2e
      - name: Build and load images
        run: |
          docker build -t {{.ProjectName}}:ci .
          k3d image import {{.ProjectName}}:ci -c e2e
{{- range .Frontends}}
          if [ -f "{{.Path}}/Dockerfile" ]; then
            docker build -t {{$.ProjectName}}/{{.Name}}:ci {{.Path}}
            k3d image import {{$.ProjectName}}/{{.Name}}:ci -c e2e
          fi
{{- end}}
      - name: Deploy and test
        # Manifests come from `forge env deploy e2e`, which renders
        # deploy/kcl/e2e/. The previous `kubectl apply -f deploy/k8s/e2e/`
        # pointed at a directory forge has never produced — it survived the
        # move to KCL unread, so this job could not have passed.
        #
        # This requires the project to declare an `e2e` environment
        # (deploy/kcl/e2e/main.k). Create one with:
        #   forge env new e2e --from dev
        run: |
          forge env deploy e2e
          kubectl wait --for=condition=ready pod -l app={{.ProjectName}} --timeout=120s
          task test:e2e
      - name: Upload test artifacts
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: e2e-results
          path: test-results/
{{- end}}
{{- end}}
{{- range .ExtraJobs}}

  {{.Name}}:
    name: {{.Name}}
{{- if .Needs}}
    needs: [{{range $i, $n := .Needs}}{{if $i}}, {{end}}{{$n}}{{end}}]
{{- end}}
    runs-on: {{.RunsOn | default "ubuntu-latest"}}
    steps:
      - uses: actions/checkout@v4
{{- range .Steps}}
{{- if .Uses}}
      - name: {{.Name}}
        uses: {{.Uses}}
{{- if .With}}
        with:
{{- range $k, $v := .With}}
          {{$k}}: '{{$v}}'
{{- end}}
{{- end}}
{{- else}}
      - name: {{.Name}}
        run: {{.Run}}
{{- end}}
{{- end}}
{{- end}}{{- define "install-forge"}}
        # Pinned to the forge version that generated this project, so CI
        # runs the same generator, linters and deployability rules the
        # checkout was built with.
{{- if and .ForgeVersion (ne .ForgeVersion "dev")}}
        run: go install github.com/reliant-labs/forge/cmd/forge@{{.ForgeVersion}}
{{- else if and .ForgeGitCommit (ne .ForgeGitCommit "unknown")}}
        run: go install github.com/reliant-labs/forge/cmd/forge@{{.ForgeGitCommit}}
{{- else}}
        run: go install github.com/reliant-labs/forge/cmd/forge@main
{{- end}}
{{- end}}
