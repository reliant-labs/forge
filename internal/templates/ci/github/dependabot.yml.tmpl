# yours: scaffolded once, never touched again — forge will not overwrite this file.
# This CI workflow is a starting point you own — add jobs, secrets, and steps freely.
# Deleting it sticks (.forge/scaffolded.json); `forge project rescaffold <path>` re-creates it.
# Source: internal/templates/ci/github/dependabot.yml.tmpl.
#
# Every Dependabot PR runs the project's whole CI, so one PR per dependency
# multiplies that cost (and each rebase re-runs it). Each ecosystem below is
# grouped: one PR per ecosystem per week. Go and npm groups take minor and patch
# updates only, so a rare major bump stays its own PR and cannot block the batch.
#
# Code generators that stamp their own version into what they generate are
# ignored below. Dependabot edits go.mod or the lockfile but cannot run
# `forge generate`, so a bump of one changes every generated file's header and
# fails Verify Generated Code every time. Bump those by hand, regenerating in
# the same PR.
version: 2
updates:
  # The generated protobuf module lives under /gen with its own go.mod.
  - package-ecosystem: gomod
    directories:
      - /
      - /gen
    schedule:
      interval: weekly
    open-pull-requests-limit: 5
    groups:
      go-minor-patch:
        patterns:
          - "*"
        update-types:
          - minor
          - patch
    ignore:
      # forge_version in forge.yaml must move with this require, and a hop can
      # carry migrations that only `forge project upgrade` runs.
      - dependency-name: github.com/reliant-labs/forge
{{- if .RunsProtocGenGo}}
      # google.golang.org/protobuf's version is also protoc-gen-go's: `forge
      # tools install` installs the plugin at the version go.mod resolves, and
      # protoc-gen-go writes it into every gen/**/*.pb.go header. Bump by hand
      # in both modules, then reinstall the plugin and regenerate:
      #   go get google.golang.org/protobuf@vX && (cd gen && go get google.golang.org/protobuf@vX)
      #   forge tools install --force && forge generate
      # (Another bump can still raise it through a shared requirement; that
      # PR needs the same regenerate.) connectrpc.com/connect drives
      # protoc-gen-connect-go the same way but stamps no version, so its bumps
      # stay here: one only fails the check when the generated code changes.
      - dependency-name: google.golang.org/protobuf
{{- end}}
{{- if .FrontendName}}

  - package-ecosystem: npm
    directory: /frontends/{{.FrontendName}}
    schedule:
      interval: weekly
    open-pull-requests-limit: 2
    groups:
      npm-minor-patch:
        patterns:
          - "*"
        update-types:
          - minor
          - patch
    ignore:
      # protoc-gen-es writes its version into every generated *_pb.ts, and
      # declares an EXACT peer dependency on @bufbuild/protobuf, so the two
      # only ever move together. Bump both by hand in one PR and commit
      # `forge generate`'s output with the lockfile:
      #   npm install -D @bufbuild/protoc-gen-es@X && npm install @bufbuild/protobuf@X
      #   forge generate
      - dependency-name: "@bufbuild/protoc-gen-es"
      - dependency-name: "@bufbuild/protobuf"
{{- end}}

  - package-ecosystem: docker
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 2
    groups:
      docker:
        patterns:
          - "*"

  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 2
    groups:
      github-actions:
        patterns:
          - "*"
