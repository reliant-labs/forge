# yours: scaffolded once, never touched again — forge will not overwrite this file.
# This CI workflow is a starting point you own — add jobs, secrets, and steps freely.
# `forge generate` re-creates it only if you delete it first.
#
# Every deploy goes THROUGH forge: `forge build <env> --push` then
# `forge env deploy <env>` — never a raw KCL render piped to kubectl. forge is what
# resolves `kcl_plugin.forge` (imported by every env render), materializes the
# KCL module this checkout's forge ships, binds the kubectl context the env
# DECLARES (forge.K8sCluster.cluster — never the runner's current context),
# re-renders each frontend's config.js for THIS env before building, pins the
# pushed image by digest, runs the secret/image preflight against the live
# target, and routes a hosted env (forge.ControlPlane) to its control plane
# instead of a cluster. A raw render skips every one of those.
#
# Environments are the ones this project declares — one per
# deploy/kcl/<env>/main.k at scaffold time, `dev` excluded (it runs locally
# via `forge env up`). Add an env later by adding it to the matrix below.
#
# Triggers:
#   * workflow_run (after "Build & Push Images" succeeds on main)
#     → deploys the env marked auto below (the first of several; a lone env
#       is never auto-deployed).
#   * workflow_dispatch → a human deploys any env on demand.
#
# There is deliberately no tag trigger: a tag records what a release IS, it
# does not decide when production changes. Deploying to a protected env is a
# person pressing the button, gated by that env's GitHub environment rules.
#
# Credentials, per env kind (forge decides the kind from the env's own KCL):
#   * forge.K8sCluster env → secrets.KUBECONFIG, a kubeconfig holding a context
#     named exactly the env's declared `cluster`. forge refuses to deploy when
#     that context is missing, rather than falling back to the current one.
#   * hosted env (forge.ControlPlane) → secrets.FORGE_CONTROL_PLANE_TOKEN, a
#     bearer token for the declared control plane (mint a machine identity,
#     not a person's token). No kubeconfig: the control plane owns the cluster.
name: Deploy
{{- if .Environments}}

on:
  workflow_run:
    workflows: ["Build & Push Images"]
    types: [completed]
    branches: [main]
  workflow_dispatch:
    inputs:
      environment:
        description: "Target environment"
        required: true
        type: choice
        options:
          {{- range .Environments}}
          - {{.Name}}
          {{- end}}

permissions:
  contents: read
  packages: write

env:
  {{- if eq .Registry "ghcr"}}
  REGISTRY: "ghcr.io/${{"{{"}} github.repository_owner {{"}}"}}"
  {{- else if eq .Registry "gar"}}
  REGISTRY: "${{"{{"}} vars.GAR_REGISTRY {{"}}"}}"
  {{- else if eq .Registry "ecr"}}
  REGISTRY: "${{"{{"}} vars.ECR_REGISTRY {{"}}"}}"
  {{- else}}
  REGISTRY: "ghcr.io/${{"{{"}} github.repository_owner {{"}}"}}"
  {{- end}}

jobs:
  deploy:
    name: Deploy to ${{"{{"}} matrix.env {{"}}"}}
    runs-on: ubuntu-latest
    # A deploy that has not finished in 30 minutes is stuck, not slow.
    timeout-minutes: 30
    strategy:
      # Each env is an independent deploy: one failing must not cancel another.
      fail-fast: false
      matrix:
        include:
          {{- range .Environments}}
          - env: {{.Name}}
            auto: {{.Auto}}
            {{- if .Protection}}
            protected: true
            {{- end}}
          {{- end}}
    # Auto envs deploy after a green image build on main; every env accepts a
    # dispatch naming it. A workflow_run for a FAILED build deploys nothing.
    if: >-
      (github.event_name == 'workflow_run' && github.event.workflow_run.conclusion == 'success') ||
      github.event_name == 'workflow_dispatch'
    {{- if .Concurrency}}
    concurrency:
      group: deploy-${{"{{"}} matrix.env {{"}}"}}
      cancel-in-progress: {{.CancelInProgress}}
    {{- end}}
    # A protected env runs under its GitHub environment, so its protection
    # rules (required reviewers, branch policy) gate the deploy.
    environment: ${{"{{"}} matrix.protected && matrix.env || '' {{"}}"}}
    env:
      FORGE_CONTROL_PLANE_TOKEN: ${{"{{"}} secrets.FORGE_CONTROL_PLANE_TOKEN {{"}}"}}
    steps:
      - name: Select this run's environments
        id: select
        # The matrix names every env; this decides whether THIS run deploys
        # this one. Steps below are skipped (not failed) for the others.
        run: |
          if [ "${{"{{"}} github.event_name {{"}}"}}" = "workflow_dispatch" ]; then
            [ "${{"{{"}} github.event.inputs.environment {{"}}"}}" = "${{"{{"}} matrix.env {{"}}"}}" ] && run=true || run=false
          else
            run=${{"{{"}} matrix.auto {{"}}"}}
          fi
          echo "run=$run" >> "$GITHUB_OUTPUT"

      - uses: actions/checkout@v4
        if: steps.select.outputs.run == 'true'
        with:
          # Deploy the commit whose image build triggered this run, not
          # whatever main points at by the time the run starts.
          ref: ${{"{{"}} github.event.workflow_run.head_sha || github.sha {{"}}"}}

      - uses: actions/setup-go@v5
        if: steps.select.outputs.run == 'true'
        with:
          go-version-file: go.mod
{{- if .HasFrontends}}

      - uses: actions/setup-node@v4
        if: steps.select.outputs.run == 'true'
        with:
          node-version-file: '{{.FrontendPath}}/package.json'
          cache: 'npm'
          cache-dependency-path: '{{.FrontendPath}}/package-lock.json'
{{- end}}

      - name: Install forge
        if: steps.select.outputs.run == 'true'
        # The version comes from go.mod at run time — the forge this project
        # compiles against — so bumping forge in go.mod is the whole upgrade.
        # A module that does not link forge (a CLI or library) falls back to
        # forge.yaml's forge_version, the generator it was scaffolded with.
        # A `replace` of forge, or a pin no module proxy can serve, fails here
        # by name rather than installing some other forge.
        # CGO is required: kcl_plugin.forge (imported by every env render) is
        # registered by a cgo-only file.
        run: |
          r=$(GOWORK=off go list -m -e -f '{{"{{"}}with .Replace{{"}}"}}{{"{{"}}.Path{{"}}"}} {{"{{"}}.Version{{"}}"}}{{"{{"}}end{{"}}"}}' github.com/reliant-labs/forge)
          if [ -n "$r" ]; then echo "::error file=go.mod::go.mod replaces github.com/reliant-labs/forge with ${r% } — CI cannot install that forge. Bridge a local forge checkout with an uncommitted go.work instead."; exit 1; fi
          v=$(GOWORK=off go list -m -f '{{"{{"}}.Version{{"}}"}}' github.com/reliant-labs/forge 2>/dev/null || sed -n 's/^forge_version:[[:space:]]*//p' forge.yaml | tr -d "\"' ")
          case "$v" in v*+*|""|dev|0.0.0) echo "::error file=go.mod::no installable forge version (got '$v') — require github.com/reliant-labs/forge in go.mod, or set forge_version in forge.yaml to a published version."; exit 1 ;; esac
          CGO_ENABLED=1 go install "github.com/reliant-labs/forge/cmd/forge@${v}"
{{- if .HasFrontends}}

      - name: Install frontend dependencies
        if: steps.select.outputs.run == 'true'
        working-directory: {{.FrontendPath}}
        run: npm ci
{{- end}}

      - name: Log in to registry
        if: steps.select.outputs.run == 'true'
        uses: docker/login-action@v3
        with:
          {{- if eq .Registry "gar"}}
          registry: ${{"{{"}} env.REGISTRY {{"}}"}}
          username: _json_key
          password: ${{"{{"}} secrets.GAR_JSON_KEY {{"}}"}}
          {{- else}}
          registry: ${{"{{"}} env.REGISTRY {{"}}"}}
          username: ${{"{{"}} github.actor {{"}}"}}
          password: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
          {{- end}}

      - name: Set kubeconfig
        # Only a forge.K8sCluster env needs one; a hosted env deploys through
        # its control plane with FORGE_CONTROL_PLANE_TOKEN instead. forge binds
        # the env's DECLARED context from this file — it never uses whatever
        # context happens to be current.
        if: steps.select.outputs.run == 'true'
        env:
          KUBECONFIG_CONTENTS: ${{"{{"}} secrets.KUBECONFIG {{"}}"}}
        run: |
          if [ -z "$KUBECONFIG_CONTENTS" ]; then
            echo "secrets.KUBECONFIG is not set — fine for a hosted env; a forge.K8sCluster env will stop at forge's context check."
            exit 0
          fi
          mkdir -p "$HOME/.kube"
          printf '%s' "$KUBECONFIG_CONTENTS" > "$HOME/.kube/config"
          chmod 600 "$HOME/.kube/config"

      - name: Build and push ${{"{{"}} matrix.env {{"}}"}}
        # Builds what THIS env declares, with this env's frontend config.js
        # rendered into the build, and pushes it. The pushed tag (and digest)
        # land in .forge/state/build-<env>.json, which the deploy below pins.
        if: steps.select.outputs.run == 'true'
        run: forge build "${{"{{"}} matrix.env {{"}}"}}" --push "$REGISTRY"

      - name: Deploy ${{"{{"}} matrix.env {{"}}"}}
        # Applies to exactly the target the env declares and waits for every
        # workload to become ready (--rollout wait, the default). A K8sCluster
        # env gets the live preflight first: every referenced Secret key and
        # image must exist on the target, or nothing is applied.
        if: steps.select.outputs.run == 'true'
        run: forge env deploy "${{"{{"}} matrix.env {{"}}"}}"
{{- end}}
