# yours: scaffolded once, never touched again — forge will not overwrite this file.
# This CI workflow is a starting point you own — add jobs, secrets, and steps freely.
# `forge generate` re-creates it only if you delete it first.
# Triggers:
#   * workflow_run (after "Build & Push Images" on main)
#     → automatically promotes to the first env with `auto: true` (typically
#       "staging"). Other envs ignore this trigger.
#   * push tag v*
#     → runs the retag-release + deploy-release jobs, promoting the image
#       to the last env (typically "prod").
#   * workflow_dispatch
#     → lets a human promote any env on demand.
name: Deploy
{{- if .Environments}}

on:
  workflow_run:
    workflows: ["Build & Push Images"]
    types: [completed]
    branches: [main]
  push:
    tags: ["v*"]
  workflow_dispatch:
    inputs:
      environment:
        description: "Target environment"
        required: true
        type: choice
        options:
          {{- range .Environments}}
          - {{.Name}}
          {{- end}}
      image_tag:
        description: "Image tag to deploy (e.g. sha-abc1234 or v1.0.0)"
        required: true
        type: string

permissions:
  contents: read
  packages: write

env:
  {{- if eq .Registry "ghcr"}}
  REGISTRY: "ghcr.io/${{"{{"}} github.repository_owner {{"}}"}}"
  {{- else if eq .Registry "gar"}}
  REGISTRY: "${{"{{"}} vars.GAR_REGISTRY {{"}}"}}"
  {{- else if eq .Registry "ecr"}}
  REGISTRY: "${{"{{"}} vars.ECR_REGISTRY {{"}}"}}"
  {{- else}}
  REGISTRY: "ghcr.io/${{"{{"}} github.repository_owner {{"}}"}}"
  {{- end}}
  PROJECT: "{{.ProjectName}}"

jobs:
  {{- $data := .}}
  {{- $prevJob := ""}}
  {{- range $i, $env := .Environments}}

  deploy-{{$env.Name}}:
    name: Deploy to {{$env.Name | title}}
    runs-on: ubuntu-latest
    {{- if and $data.Concurrency true}}
    concurrency:
      group: deploy-{{$env.Name}}
      cancel-in-progress: {{$data.CancelInProgress}}
    {{- end}}
    {{- if and (gt $i 0) $env.Auto (index $data.Environments (add $i -1)).Auto}}
    # Ordered promotion within the AUTO chain: both this env and its
    # predecessor fire on the same workflow_run, so `needs` sequences
    # them. A manually-dispatched env must NOT depend on the env before
    # it — that env's `if:` is false on this dispatch, so it is SKIPPED,
    # and a skipped dependency skips its dependents. Making prod need
    # staging is what made the manual prod promotion path unreachable.
    needs: [deploy-{{(index $data.Environments (add $i -1)).Name}}]
    {{- end}}
    # Auto-deploy envs (e.g. staging) fire on workflow_run success after
    # "Build & Push Images" completes on main. Every env also accepts an
    # explicit workflow_dispatch targeted at it. Prod-style envs without
    # `auto: true` must be dispatched manually or reached via a v* tag
    # (handled by the deploy-release job below).
    if: >-
      {{- if $env.Auto}}
      (github.event_name == 'workflow_run' && github.event.workflow_run.conclusion == 'success') ||
      {{- end}}
      (github.event_name == 'workflow_dispatch' && github.event.inputs.environment == '{{$env.Name}}')
    {{- if $env.Protection}}
    environment:
      name: {{$env.Name}}
      {{- if $env.URL}}
      url: {{$env.URL}}
      {{- end}}
    {{- end}}
    env:
      # The namespace the manifests declare. Mirrors `_namespace` in
      # deploy/kcl/{{$env.Name}}/main.k — change both together. Every
      # verification step below is namespace-scoped: without it kubectl
      # queries the kubeconfig's default namespace, finds nothing, and
      # passes vacuously.
      NAMESPACE: {{$data.ProjectName}}-{{$env.Name}}
    steps:
      - uses: actions/checkout@v4

      - name: Configure kubectl
        uses: azure/setup-kubectl@v4

      - name: Set kubeconfig
        env:
          KUBECONFIG_CONTENTS: ${{"{{"}} secrets.KUBECONFIG {{"}}"}}
        run: |
          mkdir -p $HOME/.kube
          printf '%s' "$KUBECONFIG_CONTENTS" > $HOME/.kube/config
          chmod 600 $HOME/.kube/config

      - name: Determine image tag
        id: tag
        run: |
          if [ "${{"{{"}} github.event_name {{"}}"}}" = "workflow_dispatch" ]; then
            echo "tag=${{"{{"}} github.event.inputs.image_tag {{"}}"}}" >> "$GITHUB_OUTPUT"
          else
            echo "tag=sha-$(echo ${{"{{"}} github.event.workflow_run.head_sha {{"}}"}} | cut -c1-7)" >> "$GITHUB_OUTPUT"
          fi

      - name: Cache KCL CLI
        uses: actions/cache@v4
        id: kcl-cache
        with:
          path: ~/.kcl
          key: kcl-cli-${{"{{"}} runner.os {{"}}"}}

      - name: Install KCL
        if: steps.kcl-cache.outputs.cache-hit != 'true'
        run: curl -fsSL https://kcl-lang.io/script/install-cli.sh | bash

      - name: Add KCL to PATH
        run: echo "$HOME/.kcl/bin" >> "$GITHUB_PATH"
      {{- if and $data.MigrationTest (ne $env.Name "staging")}}

      - name: Dry-run against the live API server
        # Renders the same manifests the deploy step applies and pushes
        # them through server-side validation (admission, CRD presence,
        # schema) WITHOUT mutating anything. Note this validates the
        # workload manifests only — forge does not yet render a schema
        # migration Job, so nothing here exercises the database.
        run: |
          kcl run deploy/kcl/{{$env.Name}}/main.k \
            -D image_tag=${{"{{"}} steps.tag.outputs.tag {{"}}"}} \
            -D registry=${{"{{"}} env.REGISTRY {{"}}"}} \
            -S manifests | \
            kubectl apply --dry-run=server -f -
      {{- end}}

      - name: Deploy to {{$env.Name}}
        # `-S manifests` is REQUIRED. Without it `kcl run` emits the
        # module's top-level variables as a YAML MAPPING (`manifests:` +
        # `output:`), and `kubectl apply` rejects that root with
        # "apiVersion not set, kind not set". `-S manifests` selects the
        # manifest list and emits it as a `---`-separated document
        # stream, which is what kubectl consumes.
        run: |
          kcl run deploy/kcl/{{$env.Name}}/main.k \
            -D image_tag=${{"{{"}} steps.tag.outputs.tag {{"}}"}} \
            -D registry=${{"{{"}} env.REGISTRY {{"}}"}} \
            -S manifests | \
            kubectl apply --server-side -f -

      - name: Wait for rollouts
        # An EMPTY match is a failure, not a pass: a `for` over no
        # results exits 0 and reports a green deploy that verified
        # nothing. The selector must find the objects the apply above
        # created — same namespace, same `part-of` label the renderer
        # stamps.
        run: |
          set -euo pipefail
          mapfile -t deploys < <(kubectl get deployments -n "$NAMESPACE" \
            -l app.kubernetes.io/part-of="$PROJECT" -o name)
          if [ ${#deploys[@]} -eq 0 ]; then
            echo "::error::no Deployments matched app.kubernetes.io/part-of=$PROJECT in namespace $NAMESPACE — nothing was verified"
            exit 1
          fi
          for deploy in "${deploys[@]}"; do
            kubectl rollout status -n "$NAMESPACE" "$deploy" --timeout=300s
          done

      - name: Verify service endpoints
        # The rollout wait above proves every pod reached Ready, i.e.
        # its readiness probe passed. This proves the Services actually
        # SELECT those pods: a selector/label mismatch yields Ready pods
        # behind an endpointless Service — a total outage a rollout wait
        # cannot see.
        run: |
          set -euo pipefail
          mapfile -t svcs < <(kubectl get svc -n "$NAMESPACE" \
            -l app.kubernetes.io/part-of="$PROJECT" -o name)
          if [ ${#svcs[@]} -eq 0 ]; then
            echo "::error::no Services matched app.kubernetes.io/part-of=$PROJECT in namespace $NAMESPACE — nothing was verified"
            exit 1
          fi
          failed=0
          for svc in "${svcs[@]}"; do
            name=${svc#service/}
            ready=$(kubectl get endpointslices -n "$NAMESPACE" \
              -l kubernetes.io/service-name="$name" \
              -o jsonpath='{range .items[*].endpoints[*]}{.conditions.ready}{"\n"}{end}' \
              | grep -c '^true$' || true)
            if [ "$ready" -eq 0 ]; then
              echo "::error::Service $name has no ready endpoints in $NAMESPACE"
              failed=1
            else
              echo "  ✓ $name: $ready ready endpoint(s)"
            fi
          done
          [ "$failed" -eq 0 ]
  {{- end}}

  retag-release:
    name: Retag for Release
    runs-on: ubuntu-latest
    if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v')
    outputs:
      version: ${{"{{"}} steps.version.outputs.tag {{"}}"}}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Get version tag
        id: version
        run: echo "tag=${GITHUB_REF#refs/tags/}" >> "$GITHUB_OUTPUT"

      - name: Install crane
        uses: imjasonh/setup-crane@v0.4

      - name: Log in to registry
        uses: docker/login-action@v3
        with:
          {{- if eq .Registry "ghcr"}}
          registry: ${{"{{"}} env.REGISTRY {{"}}"}}
          username: ${{"{{"}} github.actor {{"}}"}}
          password: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
          {{- else if eq .Registry "gar"}}
          registry: ${{"{{"}} env.REGISTRY {{"}}"}}
          username: _json_key
          password: ${{"{{"}} secrets.GAR_JSON_KEY {{"}}"}}
          {{- else}}
          registry: ${{"{{"}} env.REGISTRY {{"}}"}}
          username: ${{"{{"}} github.actor {{"}}"}}
          password: ${{"{{"}} secrets.GITHUB_TOKEN {{"}}"}}
          {{- end}}

      - name: Retag images
        run: |
          SHA_TAG="sha-$(git rev-parse --short HEAD)"
          VERSION="${{"{{"}} steps.version.outputs.tag {{"}}"}}"
          echo "Retagging {{.ProjectName}}: $SHA_TAG -> $VERSION, latest"
          crane tag "${{"{{"}} env.REGISTRY {{"}}"}}/{{.ProjectName}}:$SHA_TAG" "$VERSION"
          crane tag "${{"{{"}} env.REGISTRY {{"}}"}}/{{.ProjectName}}:$SHA_TAG" "latest"
          {{- if .HasFrontends}}
          for fe_dir in frontends/*/; do
            fe_name=$(basename "$fe_dir")
            echo "Retagging $fe_name: $SHA_TAG -> $VERSION, latest"
            crane tag "${{"{{"}} env.REGISTRY {{"}}"}}/$fe_name:$SHA_TAG" "$VERSION"
            crane tag "${{"{{"}} env.REGISTRY {{"}}"}}/$fe_name:$SHA_TAG" "latest"
          done
          {{- end}}

  deploy-release:
    name: Deploy Release
    needs: retag-release
    runs-on: ubuntu-latest
    if: github.event_name == 'push' && startsWith(github.ref, 'refs/tags/v')
    {{- $lastEnv := index .Environments (add (len .Environments) -1)}}
    {{- if $lastEnv.Protection}}
    environment:
      name: {{$lastEnv.Name}}
      {{- if $lastEnv.URL}}
      url: {{$lastEnv.URL}}
      {{- end}}
    {{- end}}
    {{- if .Concurrency}}
    concurrency:
      group: deploy-{{$lastEnv.Name}}
      cancel-in-progress: false
    {{- end}}
    env:
      # Mirrors `_namespace` in deploy/kcl/{{$lastEnv.Name}}/main.k —
      # change both together. See the per-env deploy job above.
      NAMESPACE: {{.ProjectName}}-{{$lastEnv.Name}}
    steps:
      - uses: actions/checkout@v4

      - name: Configure kubectl
        uses: azure/setup-kubectl@v4

      - name: Set kubeconfig
        env:
          KUBECONFIG_CONTENTS: ${{"{{"}} secrets.KUBECONFIG {{"}}"}}
        run: |
          mkdir -p $HOME/.kube
          printf '%s' "$KUBECONFIG_CONTENTS" > $HOME/.kube/config
          chmod 600 $HOME/.kube/config

      - name: Cache KCL CLI
        uses: actions/cache@v4
        id: kcl-cache
        with:
          path: ~/.kcl
          key: kcl-cli-${{"{{"}} runner.os {{"}}"}}

      - name: Install KCL
        if: steps.kcl-cache.outputs.cache-hit != 'true'
        run: curl -fsSL https://kcl-lang.io/script/install-cli.sh | bash

      - name: Add KCL to PATH
        run: echo "$HOME/.kcl/bin" >> "$GITHUB_PATH"
      {{- if .MigrationTest}}

      - name: Dry-run against the live API server
        # See the per-env deploy job: server-side validation of the same
        # manifests, no mutation. Workload manifests only — forge does
        # not yet render a schema migration Job.
        run: |
          kcl run deploy/kcl/{{$lastEnv.Name}}/main.k \
            -D image_tag=${{"{{"}} needs.retag-release.outputs.version {{"}}"}} \
            -D registry=${{"{{"}} env.REGISTRY {{"}}"}} \
            -S manifests | \
            kubectl apply --dry-run=server -f -
      {{- end}}

      - name: Deploy to {{$lastEnv.Name}}
        # `-S manifests` is REQUIRED — see the per-env deploy job.
        run: |
          kcl run deploy/kcl/{{$lastEnv.Name}}/main.k \
            -D image_tag=${{"{{"}} needs.retag-release.outputs.version {{"}}"}} \
            -D registry=${{"{{"}} env.REGISTRY {{"}}"}} \
            -S manifests | \
            kubectl apply --server-side -f -

      - name: Wait for rollouts
        run: |
          set -euo pipefail
          mapfile -t deploys < <(kubectl get deployments -n "$NAMESPACE" \
            -l app.kubernetes.io/part-of="$PROJECT" -o name)
          if [ ${#deploys[@]} -eq 0 ]; then
            echo "::error::no Deployments matched app.kubernetes.io/part-of=$PROJECT in namespace $NAMESPACE — nothing was verified"
            exit 1
          fi
          for deploy in "${deploys[@]}"; do
            kubectl rollout status -n "$NAMESPACE" "$deploy" --timeout=300s
          done

      - name: Verify service endpoints
        # Mirrors the per-env deploy job: a release must fail on an
        # endpointless Service, and must fail rather than pass vacuously
        # when the selector matches nothing.
        run: |
          set -euo pipefail
          mapfile -t svcs < <(kubectl get svc -n "$NAMESPACE" \
            -l app.kubernetes.io/part-of="$PROJECT" -o name)
          if [ ${#svcs[@]} -eq 0 ]; then
            echo "::error::no Services matched app.kubernetes.io/part-of=$PROJECT in namespace $NAMESPACE — nothing was verified"
            exit 1
          fi
          failed=0
          for svc in "${svcs[@]}"; do
            name=${svc#service/}
            ready=$(kubectl get endpointslices -n "$NAMESPACE" \
              -l kubernetes.io/service-name="$name" \
              -o jsonpath='{range .items[*].endpoints[*]}{.conditions.ready}{"\n"}{end}' \
              | grep -c '^true$' || true)
            if [ "$ready" -eq 0 ]; then
              echo "::error::Service $name has no ready endpoints in $NAMESPACE"
              failed=1
            else
              echo "  ✓ $name: $ready ready endpoint(s)"
            fi
          done
          [ "$failed" -eq 0 ]
{{- end}}
