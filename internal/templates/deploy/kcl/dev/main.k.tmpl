"""
The `{{.EnvName}}` environment of {{.ProjectName}}: the local dev loop.

YOURS. forge scaffolds this file once and never rewrites it.

This file BINDS; it does not declare. `deploy/kcl/workloads.k` states what
each workload is (build, subcommand, ports, credentials). This file says
where each one runs HERE, and states the values only this environment
knows: ports on this machine, the dev database, the dev identity provider.

Each workload is bound HERE, one line each, to where it runs in dev. The
services and jobs run as HOST PROCESSES (`forge.OnHost`): `forge env up`
derives `go run ./cmd/{{.ProjectName}} <args>` from the declaration, so
there is no docker build in the loop and no container runtime required.
An operator or cron runs in the local k3d cluster, which a host process
cannot be. The Dockerfile is still there and still correct; the cluster
envs ship the image built from it.

RENDER THIS THROUGH FORGE (`forge env render {{.EnvName}}`, `forge env up
{{.EnvName}}`), not a bare `kcl run`: the ports below are declared with forge
builtins (`plugin.resolve_port` / `plugin.allocate_port`) that exist only
when forge evaluates the file. `output = forge.render(bundle)` is the one
entrypoint.
"""

import forge
import forge.workloads as fw

# The port primitives — forge builtins, imported from the plugin namespace.
import kcl_plugin.forge as plugin

# What this project RUNS — declared once, shared by every env.
import ..workloads as wl

# Per-environment config values (the typed AppConfig instance in config.k,
# next to this file); `config_gen.appConfigEnvMap` projects them into each
# workload's env.
import config_gen
import .config as appcfg
{{- if .IngressEnabled}}

# Gateway API ingress topology — user-owned. Base lives in
# `deploy/kcl/ingress.k`; this env may override hosts, ports, or TLS.
import .ingress as ing
{{- end}}

# ---------------------------------------------------------------------------
# PORTS — declared HERE, once, and referenced everywhere else.
# ---------------------------------------------------------------------------
# A port is a fact TWO things have to agree on: whatever binds it and
# whatever dials it. Each one is a variable, and every reference reads it.
#
#   plugin.resolve_port(name, preferred) is AVAILABILITY-CHECKED: it takes
#   `preferred` when free, steps to the next free port when not, and
#   remembers the answer (.forge/ports-{{.EnvName}}.json). Use it for a port
#   only this project's own declarations name.
#
#   plugin.allocate_port(base, key) is DETERMINISTIC: it does NOT step off a
#   busy port. Use it when something outside these declarations was already
#   told the number (the IdP's issuer, baked into every token it mints).

# The dev database. On a machine already running another stack on 5432 this
# steps to 5433 and stays there, and the DSN below follows it.
_postgres_port = plugin.resolve_port("{{.ProjectName}}-{{.EnvName}}-postgres", 5432)

# The port each long-running host process BINDS (a service's mux, a
# worker's or operator's health endpoint). Host processes share this
# machine, so each one gets its own availability-checked port instead of the
# container convention (every pod owns :8080). The first service keeps the
# `{{.ProjectName}}-{{.EnvName}}-api` key, which the frontend's dev config
# (config.k) reads to find the API.
_port_of = lambda name: str -> int {
    plugin.resolve_port("{{.ProjectName}}-{{.EnvName}}-api" if name == "{{.PrimaryWorkload}}" else "{{.ProjectName}}-{{.EnvName}}-" + name, 8085)
}
{{- if .HasFrontend}}

# The dev IdP cannot float: Zitadel derives the `iss` of every token it
# mints from the origin it is reached on. allocate_port keeps it at 8080 for
# this checkout and gives a second worktree its own stable block (8180, ...).
# If 8080 is taken on your machine, change the base here.
_idp_port = plugin.allocate_port(8080, option("worktree") or "")
_idp_origin = "http://localhost:${_idp_port}"

# The frontend's dev-server port. resolve_port: the one external consumer
# (the issuer's registered login URI) is re-told by the idp-provision job
# on the same run, so stepping off a busy 3000 is safe.
_frontend_port = plugin.resolve_port("{{.ProjectName}}-{{.EnvName}}-web", 3000)
_frontend_origin = "http://localhost:${_frontend_port}"
{{- end}}

# The dev database's connection string, composed from the port declared
# above rather than written out a second time.
_database_url = "postgres://postgres:postgres@localhost:${_postgres_port}/{{.ProjectName}}?sslmode=disable"

# ---------------------------------------------------------------------------
# Each workload's env here.
# ---------------------------------------------------------------------------
# The kinds that run as a long-lived process (and so bind a port).
_LONG_RUNNING = ["service", "worker", "operator"]

# The env every workload sees here, layered LAST-wins (a map, so a later
# layer replaces an earlier one by name):
#
#   1. the typed per-env config (config.k), projecting a credential only
#      into the workloads that list it in `config_secrets`;
#   2. the workload's own declared env;
#   3. this machine's facts. DATABASE_URL is composed from the port above
#      and overrides the secret reference: a DSN seeded into the secret
#      store at scaffold time names whatever port was free THEN, and a stale
#      port is exactly what connects an app to another project's database.
_env = lambda w: fw.Workload -> {str:} {
    _machine = {
        OTEL_SERVICE_NAME = w.name
        DATABASE_URL = _database_url
    }
    _port = {PORT = str(_port_of(w.name))} if w.kind in _LONG_RUNNING else {}
{{- if .HasFrontend}}
    # NATIVE SIGN-IN's redirect URI, and where the server reaches the issuer.
    # Composed from the origins above, which this file owns.
    _sign_in = {
        OIDC_REDIRECT_URI = _frontend_origin + "/auth/callback"
        IDP_BASE = _idp_origin
    } if w.kind == "service" else {}
    # The idp-provision job is TOLD where the IdP is, from the same
    # `_idp_port` it is published on. IDP_LOGIN_URI is the API-only sign-in
    # switch: delete it to go back to the issuer's own login pages.
    _idp_job = {
        IDP_BASE = _idp_origin
        IDP_BROWSER_ORIGIN = _idp_origin
        FRONTEND_ORIGIN_GLOB = _frontend_origin
        IDP_LOGIN_URI = _frontend_origin + "/auth/sign-in"
    } if w.name == "idp-provision" else {}
    config_gen.appConfigEnvMap(appcfg.app_config, w.config_secrets) | w.env | _machine | _port | _sign_in | _idp_job
{{- else}}
    config_gen.appConfigEnvMap(appcfg.app_config, w.config_secrets) | w.env | _machine | _port
{{- end}}
}

# The local k3d cluster (deploy/k3d.yaml, created by `forge cluster up`).
# It runs what a host process cannot be — an operator watches the
# Kubernetes API, a cron is scheduled by it — and this env's ingress Gateway.
_k3d = forge.ClusterTarget {
    cluster = "k3d-{{.ProjectName}}"
    namespace = "{{.ProjectName}}-{{.EnvName}}"
}

# The k3d registry deploy/k3d.yaml creates. A workload declares its image
# against a real registry (deploy/kcl/workloads.k); this env re-points that
# same reference onto the local one, because a k3d node can only pull from a
# host-local registry. The declaration stays single-sourced — dev states only
# the difference — and `forge env up {{.EnvName}}` pushes here.
_LOCAL_REGISTRY = "localhost:5050"

# ---------------------------------------------------------------------------
# THE BINDINGS: where each workload runs in this env.
# ---------------------------------------------------------------------------
# There is no env-wide runtime. Every workload below states its own, through
# one of these binders (each also applies this env's env vars). Rebinding a
# workload is editing its one line:
#
#     _on_k3d(wl.{{.PrimaryIdent}})       # run it as a pod in the local cluster instead
#
# A pod reaches the host processes through the target's `host_gateway`
# (host.k3d.internal) when a workload names them with forge.WorkloadURL.

# A long-running host process: `go run ./cmd/{{.ProjectName}} <args>`, on its
# own port (`listen_ports`, so the pre-flight names a collision before
# anything starts).
_on_host = lambda w: fw.Workload -> fw.Workload {
    w | {env = _env(w), runtime = forge.OnHost {runner = "go-run", listen_ports = [_port_of(w.name)]}}
}
# A host job: run to completion, before whatever it gates.
_on_host_job = lambda w: fw.Workload -> fw.Workload {
    w | {env = _env(w), runtime = forge.OnHost {runner = "go-run"}}
}
# A pod in the local k3d cluster, from the image `forge build {{.EnvName}}`
# pushes to the local registry.
_on_k3d = lambda w: fw.Workload -> fw.Workload {
    w | {
        env = _env(w)
        image = forge.image_on_registry(w.image, _LOCAL_REGISTRY)
        runtime = forge.OnCluster {target = _k3d}
    }
}
# Built, never run.
_build_only = lambda w: fw.Workload -> fw.Workload {
    w | {runtime = forge.BuildOnly {}}
}

# Every workload this env runs, one binding each. `forge scaffold` appends
# a line here when it adds a workload; drop a line to not run it here.
_workloads = [
{{.Bindings}}
]

_bundle = forge.Bundle {
    project = "{{.ProjectName}}"
    # Where the env's support objects (Namespace, gateways, routes) land.
    cluster_target = _k3d
    workloads = _workloads
    # ── THIS ENVIRONMENT'S INFRASTRUCTURE ─────────────────────────────────
    #
    # The servers the app DIALS but does not build, as HOST PROCESSES: forge
    # fetches a pinned, checksummed binary once, caches it, supervises it,
    # and reports it up only once it accepts connections. A REAL postgres
    # (the one forge introspects your migrations with), with its data dir
    # (.forge/hostinfra/postgres) persisting across runs.
    #
    # WANT CONTAINERS INSTEAD? docker-compose.yml still defines them; drop
    # the entry here and add a compose-bound workload:
    #
    #     fw.Workload {name = "postgres", runtime = forge.OnCompose {service = "postgres"}}
    infra = [
        forge.HostInfra {
            name = "postgres"
            port = _postgres_port
            database = "{{.ProjectName}}"
        }
{{- if .HasFrontend}}
        # The dev identity provider — a single static binary, supervised the
        # same way. `idp-steps.yaml` is its declarative bootstrap; its state
        # lives in its OWN database on the postgres above.
        #
        # NO SIGN-IN LOOP AT ALL? Drop this entry and the `idp-provision`
        # workload; the frontend then runs against its mock auth provider.
        forge.HostInfra {
            name = "idp"
            engine = "zitadel"
            port = _idp_port
            idp_database_port = _postgres_port
        }
{{- end}}
    ]
    # ── OBSERVABILITY — OPT-IN ───────────────────────────────────────────
    #
    # docker-compose.yml also defines `lgtm` (Grafana + Loki + Tempo + Mimir)
    # and `alloy`. They are not run by default: an LGTM stack is ~1 GB
    # resident to look at a service running in your terminal. To add them,
    # append to `_workloads`:
    #
    #     fw.Workload {name = "lgtm", runtime = forge.OnCompose {service = "lgtm"}}
    #     fw.Workload {name = "alloy", runtime = forge.OnCompose {service = "alloy"}}
{{- if .HasFrontend}}
    # The frontend's dev server (forge.OnHost — the same runtime a workload
    # binds), with its port declared above so everything that must agree on
    # it reads one variable.
    frontends = [forge.Frontend {
        name = "{{.FrontendName}}"
        path = "frontends/{{.FrontendName}}"
        port = _frontend_port
        runtime = forge.OnHost {}
    }]
{{- end}}
    # SECRET VALUES for this env: the gitignored `secrets/{{.EnvName}}.yaml`, a
    # flat map of env-var name to value. A value reaches only a workload that
    # names it (`config_secrets`, or a forge.SecretRef in its env). Populate
    # it with `forge secret set --env {{.EnvName}} <KEY>` (value on stdin).
    secret_provider = forge.FileSecrets {path = "secrets/{{.EnvName}}.yaml"}
{{- if .IngressEnabled}}
    gateways = ing.GATEWAYS
    http_routes = ing.HTTP_ROUTES
    grpc_routes = ing.GRPC_ROUTES
{{- end}}
}

output = forge.render(_bundle)
