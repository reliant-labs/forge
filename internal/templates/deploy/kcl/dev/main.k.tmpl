"""
Development environment configuration for {{.ProjectName}}.

DEPLOY-AS-DATA: forge no longer hand-writes a `forge.Service` per
component here. It serializes the denormalized component base shape to
`deploy/kcl/components_gen.json`, and the forge.components KCL schema
hierarchy (Server / Worker / Cron / Operator / Binary) owns ALL
normalization into k8s resources. This file LOADS that data, overlays
the per-env knobs (replicas, registry, resources, secrets), and renders.

Two outputs:

  * `manifests` — Kubernetes manifest list rendered for the env from
    components_gen.json + the forge.components schemas. Pipe to
    `kubectl apply -f -` or `forge env deploy dev`. Select with
    `kcl run deploy/kcl/dev -S manifests --format yaml`.

  * `output` — JSON contract the forge CLI consumes (`forge build`,
    `forge env up`, `forge env deploy`) for host-vs-cluster dispatch + builds.
    Bridged from the same component data. Select with
    `kcl run deploy/kcl/dev -S output --format json`.

Per-env tag/registry overrides are consumed by `forge.image_tag(env)`
(reads `option("image_tag")`) and the `registry` field. The forge CLI
passes `-D image_tag=` on every build/deploy.

Path note: `forge.components.load_components` reads
components_gen.json relative to the project root — the directory forge
runs `kcl run deploy/kcl/<env>` from, and where the documented manual
command `kcl run deploy/kcl/dev` is run from.
"""

import forge
import forge.components as fc

# Per-environment config — KCL-native path: the typed AppConfig values
# live in the user-owned `config.k` next to this file; the generated
# `config_projection.appConfigEnvMap` projects them into env vars.
import config_projection
import .config as appcfg
{{- if .IngressEnabled}}

# Gateway API ingress topology — user-owned. Base lives in
# `deploy/kcl/ingress.k`; this env may override hosts, ports, or TLS.
import .ingress as ing
{{- end}}

# Env-wide deploy target. Overridable via `kcl run -D registry=...`.
# Local dev defaults to the k3d registry created by `deploy/k3d.yaml`.
_registry = forge.registry("localhost:5050")
_namespace = "{{.ProjectName}}-dev"
_cluster = forge.ClusterTarget {
    cluster = "k3d-{{.ProjectName}}"
    namespace = _namespace
    registry = _registry
}

# Base env every component sees (COMMON_ENV + per-env config.k projection),
# assembled with forge.env_merge (name-keyed, LAST-wins) so a later layer
# overrides an earlier one by name instead of the `+`-concat footgun (which
# emits duplicate keys kubectl rejects).
_base_env = forge.env_merge(forge.env_merge(forge.COMMON_ENV, forge.env_project(config_projection.appConfigEnvMap(appcfg.app_config))), [
    forge.EnvVar {name = "SERVICE_NAME", value = "{{.ProjectName}}"}
])

# Load the denormalized components forge emitted and overlay the dev
# knobs. The `|` merge layers per-env config onto each loaded component;
# all components run the project image (one image, cobra subcommands per
# binary).
_components = [c | {
    image = "{{.ProjectName}}"
    registry = _registry
    namespace = _namespace
    replicas = 1
    env_vars = forge.env_merge(_base_env, [forge.EnvVar {name = "OTEL_SERVICE_NAME", value = c.name}])
} for c in fc.load_components(fc.COMPONENTS_GEN)]

_component_env = fc.ComponentEnv {
    # Deploy-time schema migrations. `load_migrate` reads the argv forge
    # emits into components_gen.json (`/app/<project> db migrate up`, over the
    # migrations EMBEDDED in the image) — empty until the project ships its
    # first db/migrations/*.sql, populated from then on with no edit here.
    #
    # It renders as an initContainer on every Deployment-shaped workload, so
    # the schema is current BEFORE any new pod serves a request and a failed
    # migration stalls the rollout with the old pods still serving. Concurrent
    # replicas are safe — golang-migrate takes a postgres advisory lock.
    migrate = fc.load_migrate(fc.COMPONENTS_GEN)
    namespace = _namespace
    project = "{{.ProjectName}}"
    registry = _registry
    image_tag = forge.image_tag("dev")
    network_policies = False
}

# Support resources (ConfigMaps + ingress) come from a Bundle the forge
# render layer projects; the workloads come from the component
# expansion. render_support omits namespace/netpol (render_components
# owns those).
_support = forge.Bundle {
    cluster_target = _cluster
    # Config rides the appConfigEnvMap projection on every component env;
    # no standalone ConfigMap resources on the native config path.
    config_maps = []
{{- if .IngressEnabled}}
    gateways = ing.GATEWAYS
    http_routes = ing.HTTP_ROUTES
    grpc_routes = ing.GRPC_ROUTES
{{- end}}
}

# k8s manifests for `kubectl apply -f -`.
manifests = fc.render_components(_components, _component_env) \
    + forge.render_support(_support)

# JSON contract consumed by forge build/run/deploy. Bridges the loaded
# components into forge.Service / CronJob / Operator entities so the
# build + host/cluster dispatch contract is unchanged. Binaries deploy
# build-only (forge orchestrates them via the CLI); servers/workers run
# in-cluster.
_svc_components = [c for c in _components if c.kind in ["server", "worker"]]
_bin_components = [c for c in _components if c.kind == "binary"]
_cron_components = [c for c in _components if c.kind == "cron"]
_op_components = [c for c in _components if c.kind == "operator"]

_bundle = forge.Bundle {
    cluster_target = _cluster
    services = [forge.RenderedWorkload {
        name = c.name
        image = "{{.ProjectName}}"
        command = c.command
        env_vars = c.env_vars
        # Ports come from THIS file, never from components_gen.json: a port is a
        # deploy fact. Add them to the `_components` overlay above
        # (`ports = [fc.ComponentPort {name = "http", port = 9090, expose = True}]`)
        # and they flow to both the manifests and this build/dispatch contract.
        # Empty is the normal case — the Server expansion serves the standard
        # :8080 mux, which is the one port the binary actually binds.
        deploy = _cluster.deploy | {ports = [p.port for p in c.ports]}
        if c.build:
            build = forge.build_of(c.build)
    } for c in _svc_components] + [forge.RenderedWorkload {
        name = c.name
        image = "{{.ProjectName}}"
        command = c.command
        env_vars = c.env_vars
        deploy = forge.BuildOnly {}
        if c.build:
            build = forge.build_of(c.build)
    } for c in _bin_components]
    cronjobs = [forge.CronJob {
        name = c.name
        image = "{{.ProjectName}}"
        schedule = c.schedule
        command = c.command
        env_vars = c.env_vars
    } for c in _cron_components]
    operators = [forge.Operator {
        name = c.name
        image = "{{.ProjectName}}"
        crds = c.crds
        env_vars = c.env_vars
    } for c in _op_components]
    config_maps = []
    # SECRET VALUES for this env. Every config field marked `sensitive: true`
    # in proto/config/v1/config.proto projects into the manifest as a
    # valueFrom.secretKeyRef — a REFERENCE — so the values have to come from
    # somewhere forge can read WITHOUT putting them in git. On a local cluster
    # that is the gitignored `.env.dev`: forge resolves each declared ref from
    # it, renders the backing Secret CLI-side, and applies it BEFORE the
    # Deployments roll out so every secretKeyRef resolves on first schedule.
    # It also layers the same values onto host processes (`forge run`).
    #
    # LOCAL CLUSTERS ONLY — forge refuses to project a dotenv-rendered
    # plaintext Secret into a non-local cluster. Cloud envs use
    # `forge.ExternalSecrets {}` (see staging/prod).
    secret_provider = forge.DotenvSecrets {path = ".env.dev"}
{{- if .IngressEnabled}}
    gateways = ing.GATEWAYS
    http_routes = ing.HTTP_ROUTES
    grpc_routes = ing.GRPC_ROUTES
{{- end}}
}

output = forge.render(_bundle)
