"""
The `{{.EnvName}}` environment of {{.ProjectName}}: HOSTED on a forge control plane.

YOURS. forge scaffolds this file once and never rewrites it.

This file BINDS; it does not declare. `deploy/kcl/workloads.k` states what
each workload is. Here every workload binds `forge.OnHosted {}`: forge
publishes its spec as a `forge.dev/v1alpha1 Workload` to the control plane,
and the PLATFORM renders and runs it. You do not name a cluster, a
namespace, a registry or a node pool — the platform owns placement.

WHAT THE HOSTED RUNTIME ACCEPTS (the Restricted profile). A hosted workload
shares nodes with other hosted users, so the platform admits only fields it
can run safely there, and forge runs the same check at render time so a
refusal names the field here rather than after a publish:

  allowed  kinds service, worker and job; replicas, resources, command/args,
           ports (the platform routes the `expose = True` one), probes,
           storageGiB, activeDeadlineSeconds; env from a literal,
           forge.ManagedSecret, forge.DatabaseRef or forge.WorkloadURL
  refused  cron (not metered yet), operator and every Kubernetes RBAC or
           ServiceAccount field (no Kubernetes API access on shared nodes),
           sidecars and volumes (the platform composes the pod), node
           selectors and tolerations (the platform places pods), a raw
           secretRef / configMapRef / fieldRef env (they address namespace
           objects you did not write)

Probes need nothing from you: forge writes `/readyz` readiness and
`/healthz` liveness on each service's `http` port into its spec, which is
what the scaffolded server serves, and the platform derives the grace
period from PRE_STOP_DELAY + SHUTDOWN_TIMEOUT.

Images come from a RELEASE: `forge release cut <version> --env {{.EnvName}}`
builds and pins every artifact by digest, and `forge env deploy {{.EnvName}}`
publishes the pinned specs. `forge env render {{.EnvName}}` shows the specs
and the platform's rendering of them without publishing anything.
"""

import forge
import forge.workloads as fw

# What this project RUNS — declared once, shared by every env.
import ..workloads as wl

# Per-environment config values (the typed AppConfig instance in config.k).
import config_gen
import .config as appcfg

# ---------------------------------------------------------------------------
# WHAT THIS ENVIRONMENT RUNS.
# ---------------------------------------------------------------------------
# Every declared workload except the dev-IdP convergence job (a hosted env's
# issuer is a real one). Anything the hosted runtime refuses (an operator, a
# cron) is refused at render naming the workload: drop it here, or bind it
# to a cluster you operate (`| {runtime = forge.OnCluster {target = ...}}`).
_workloads = [w for w in wl.ALL if w.name != "idp-provision"]
{{- if .HasDatabase}}

# The database. The control plane provisions and runs it; a workload reads
# its connection string through forge.DatabaseRef, never a literal DSN.
_db = forge.ManagedDatabase {name = "db"}
{{- end}}

# The per-workload binding for this env: the typed config projected into
# its env (a `sensitive` field lowers to a forge.ManagedSecret of the same
# name, so its value comes from this env's secret store){{if .HasDatabase}}, and the
# managed database's DSN for every workload that reads DATABASE_URL{{end}}. A tool
# is built into the release but never scheduled.
_bind = lambda w: fw.Workload -> fw.Workload {
    w | {
        env = config_gen.appConfigEnvMap(appcfg.app_config, w.config_secrets) | w.env | {OTEL_SERVICE_NAME = w.name}
{{- if .HasDatabase}}
            | ({DATABASE_URL = forge.DatabaseRef {name = _db.name}} if "DATABASE_URL" in w.config_secrets else {})
{{- end}}
        if w.kind == "tool":
            runtime = forge.BuildOnly {}
    }
}

_bundle = forge.Bundle {
    project = "{{.ProjectName}}"
    # Every workload runs on the control plane unless it binds its own runtime.
    runtime = forge.OnHosted {}
    # WHICH control plane. Empty means Reliant cloud; set `endpoint` to use
    # another one. The credential is read from FORGE_CONTROL_PLANE_TOKEN
    # (`forge login` stores one); `token_env` names a different variable.
    control_plane = forge.ControlPlane {}
    # Secret VALUES live in that control plane, write-only: `forge secret set
    # {{.EnvName}} <KEY>` stores one; no laptop or CI runner ever reads it back.
    secret_provider = forge.HostedSecrets {}
    workloads = [_bind(w) for w in _workloads]
{{- if .HasDatabase}}
    databases = [_db]
{{- end}}
{{- if .HasFrontend}}
    # The frontend is a HOSTED static site: a StaticSite with no `bucket` is
    # published into the platform's bucket and CDN. `runtime_config` is the
    # browser's window.__FORGE_CONFIG__, and a forge.WorkloadURL in it is
    # resolved BY THE PLATFORM to the hosted workload's public URL after
    # every sync, so one release artifact promotes across environments.
    frontends = [forge.Frontend {
        name = "{{.FrontendName}}"
        path = "frontends/{{.FrontendName}}"
        type = "{{.FrontendType}}"
{{- if .HasPrimaryService}}
        runtime_config = {API_URL = forge.WorkloadURL {workload = "{{.PrimaryWorkload}}"}}
{{- end}}
        # The static export's output directory.{{if eq .FrontendType "nextjs"}} A Next.js frontend
        # exports statically with `output: static` on its forge.yaml entry.{{end}}
        deploy = forge.StaticSite {public_dir = "{{.FrontendPublicDir}}"}
    }]
{{- end}}
}

output = forge.render(_bundle)
