[package]
name = "{{.ProjectName}}-deploy"
edition = "v0.11.0"
version = "0.0.1"

# The `forge` KCL module ships the typed schemas this package's env
# main.k files import (Service / Operator / Frontend / CronJob, plus
# the polymorphic deploy union).
#
# `forge generate` materializes the module embedded in the forge binary
# into `.forge-kcl/` at the project root and maintains the dependency
# below (marker-delimited). That copy travels with the repo, so
# containers and CI resolve the identical module with no network and no
# git auth — commit `.forge-kcl/` along with this file.
[dependencies]
forge = { path = "../../.forge-kcl" }
