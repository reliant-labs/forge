"""
Staging environment configuration for {{.ProjectName}}.

YOURS. forge scaffolds this file once and never rewrites it.

It answers WHICH workloads staging runs and HOW they differ here.
`deploy/kcl/workloads.k` declares each workload COMPLETELY — ports and
all — and this file REFINES what staging changes, using KCL's `|` merge.
Only the difference is stated; everything else is inherited.

Refinement is type-checked: `|` preserves the schema, so every `check:`
in forge.workloads re-runs on the merged result. A bad override fails
HERE, in staging, naming the field. This env may also add a workload only
staging has, or omit one it does not want. See the header in `dev/main.k`
for the `manifests` / `output` two-output contract.

Per-env tag/registry overrides are consumed by `forge.image_tag(env)`
(reads `option("image_tag")`) and the `registry` field. The forge CLI
passes `-D image_tag=` on every build/deploy.
"""

import forge
import forge.workloads as fw

# What this project DEPLOYS — user-owned, shared by every env.
# This file refines what is specific to THIS environment.
import ..workloads as wl

import config_gen
import .config as appcfg
{{- if .IngressEnabled}}
import .ingress as ing
{{- end}}

# Overridable via `kcl run -D registry=...`. The default is a visibly
# placeholder ("ghcr.io/OWNER") so a missing CI `-D registry=` surfaces
# as a wrong image reference rather than silently deploying from an
# unrelated registry.
_registry = forge.registry("ghcr.io/OWNER")
_namespace = "{{.ProjectName}}-staging"
_replicas = 2
_resources = forge.Resources {
    cpu_request_millicores = forge.cpu(0.25)   # 250m
    memory_request_bytes = forge.mib(256)      # 256Mi
    cpu_limit_millicores = forge.cpu(1)        # 1000m
    memory_limit_bytes = forge.mib(512)        # 512Mi
}
_cluster = forge.ClusterTarget {
    # Set to the kubectl context name for the staging cluster.
    cluster = "{{.ProjectName}}-staging"
    namespace = _namespace
    registry = _registry
}

# Base env every workload sees, assembled with forge.env_merge (name-keyed,
# LAST-wins) so a later layer overrides an earlier one by name instead of the
# `+`-concat footgun (which emits duplicate keys kubectl rejects).
# A LAMBDA of the workload's declared config_secrets, not a flat value, because
# the CONFIG projection is now per-workload. Non-sensitive config still
# reaches every workload identically (inline values — no credential, no
# start-time dependency), but a `sensitive` field is projected only into the
# workloads that NAME it in `config_secrets` in deploy/kcl/workloads.k.
#
# It was one flat map layered under every workload, and that was an outage
# waiting to happen: adding one credential to the shared config added a
# secretKeyRef to every Deployment, CronJob and Job. A pod whose secretKeyRef
# names a key that does not exist never starts — CreateContainerConfigError,
# no application log — so one feature's missing secret took down everything
# in the namespace rather than that feature.
_base_env = lambda config_secrets: [str] -> [forge.EnvVar] {
    forge.env_merge(forge.env_merge(forge.COMMON_ENV, forge.env_project(config_gen.appConfigEnvMap(appcfg.app_config, config_secrets))), [
    forge.EnvVar {name = "SERVICE_NAME", value = "{{.ProjectName}}"}
])
}

# WHAT THIS ENVIRONMENT DEPLOYS.
#
# `wl.ALL` is every workload the project declares. This list is yours:
# drop one staging does not run, or append a workload only staging has.
_declared = wl.ALL

# PER-WORKLOAD refinement for staging. Name a workload and state only
# what differs here; everything else is inherited from its base
# declaration. Because `|` preserves the schema type, forge.workloads'
# `check:` rules re-run on the result, so an invalid override fails
# HERE, in staging.
#
#     _declared = [w | {replicas = 2} if w.name == "{{.PrimaryWorkload}}" else w for w in _declared]

# ENV-WIDE PLACEMENT + the staging capacity floor. Every field here is
# mechanical: derived from this environment or from the workload's own
# name. Nothing that describes the workload ITSELF (ports, command, kind,
# build) is set here — that lives in workloads.k, stated once and
# inherited by every environment.
_workloads = [c | {
    image = "{{.ProjectName}}"
    registry = _registry
    namespace = _namespace
    replicas = c.replicas if c.replicas > _replicas else _replicas
    resources = _resources
    # `c.config_secrets` is this workload's own declared credential list, so the
    # config projection under it carries only the secretKeyRefs this workload
    # reads. A workload that declares none (the common case) gets none.
    env_vars = forge.env_merge(_base_env(c.config_secrets), [forge.EnvVar {name = "OTEL_SERVICE_NAME", value = c.name}])
} for c in _declared]

_workload_env = fw.WorkloadEnv {
    # Deploy-time schema migrations are NOT configured here. They are an
    # ordinary workload — the `migrate` one-shot in deploy/kcl/workloads.k,
    # a `kind = "job"` with `before = [fw.BEFORE_ALL]` — which this env
    # inherits through `wl.ALL` like everything else it deploys.
    #
    # That job renders as an initContainer on every workload here, so the
    # schema is current BEFORE any new pod serves a request and a failed
    # migration stalls the rollout with the old pods still serving.
    #
    # If THIS environment migrates out of band, drop the workload from
    # `_declared` above rather than editing anything in this block:
    #
    #     _declared = [w for w in wl.ALL if w.name != "migrate"]
    namespace = _namespace
    project = "{{.ProjectName}}"
    registry = _registry
    image_tag = forge.image_tag("staging")
    network_policies = True
    # NetworkPolicy inputs. `default-deny` blackholes every egress the
    # allow-list misses, so these are what keep the app's database,
    # collector and ingress reachable at all.
    #
    # TCP ports the workload may dial outside the cluster: 443 for
    # HTTPS (JWKS, object storage, third-party APIs) and 5432 for a
    # managed Postgres, which normally lives OFF-cluster. Add the port
    # of any other external dependency (6379, 9092, ...).
    egress_ports = [443, 5432]
    # Namespace running the OTLP collector `OTEL_EXPORTER_OTLP_ENDPOINT`
    # points at (forge's OTEL_ENV bundle defaults to
    # `otel-collector.observability`). Clear it if you export telemetry
    # somewhere else, and add that destination's port to egress_ports.
    telemetry_namespace = "observability"
    # Namespace running the Gateway controller that terminates public
    # traffic — `forge cluster up` installs Envoy Gateway here. It MUST
    # match where the controller for this env's `gateway_class_name`
    # runs, or ingress is denied and the Gateway serves 503s.
    ingress_namespace = "envoy-gateway-system"
}

_support = forge.Bundle {
    cluster_target = _cluster
    # The PROJECT every rendered object is labelled
    # `app.kubernetes.io/part-of` with — the handle a CD pipeline uses to
    # select one release's workloads (`kubectl get deployments -n <ns>
    # -l app.kubernetes.io/part-of=<project>`). It must be the PROJECT, not a
    # workload name: when each object labels itself that selector matches
    # nothing, and a rollout wait that iterates it verifies nothing while
    # reporting success. Twin of the workload path's `WorkloadEnv.project`.
    project = "{{.ProjectName}}"
    config_maps = []
{{- if .IngressEnabled}}
    gateways = ing.GATEWAYS
    http_routes = ing.HTTP_ROUTES
    grpc_routes = ing.GRPC_ROUTES
{{- end}}
}

manifests = fw.render_workloads(_workloads, _workload_env) \
    + forge.render_support(_support)

_svc_workloads = [c for c in _workloads if c.kind in ["service", "worker"]]
_tool_workloads = [c for c in _workloads if c.kind == "tool"]
_cron_workloads = [c for c in _workloads if c.kind == "cron"]
_op_workloads = [c for c in _workloads if c.kind == "operator"]
# One-shot jobs (the scaffolded `migrate` step is one). These reach the
# HOST runner through the bundle: k8s and compose lower `before`
# themselves — an initContainer, and
# `depends_on: {condition: service_completed_successfully}` — but the host
# runner is a process launcher with no orchestrator underneath it, so it
# has to be TOLD to run the argv and wait for exit 0 before starting the
# services the job gates.
_job_workloads = [c for c in _workloads if c.kind == "job"]

_bundle = forge.Bundle {
    cluster_target = _cluster
    # The PROJECT every rendered object is labelled
    # `app.kubernetes.io/part-of` with — the handle a CD pipeline uses to
    # select one release's workloads (`kubectl get deployments -n <ns>
    # -l app.kubernetes.io/part-of=<project>`). It must be the PROJECT, not a
    # workload name: when each object labels itself that selector matches
    # nothing, and a rollout wait that iterates it verifies nothing while
    # reporting success. Twin of the workload path's `WorkloadEnv.project`.
    project = "{{.ProjectName}}"
    services = [forge.RenderedWorkload {
        name = c.name
        image = "{{.ProjectName}}"
        command = c.command
        env_vars = c.env_vars
        # Ports come from the workload declaration in workloads.k, where a
        # workload states its own ports. An env that genuinely differs refines
        # not. Add them to the `_workloads` overlay above
        # (`| {ports = [fw.Port {name = "http", port = 9090, expose = True}]}`)
        # and they flow to both the manifests and this build/dispatch contract.
        # The scaffolded default is the standard
        # :8080 mux, which is the one port the binary actually binds.
        deploy = _cluster.deploy | {replicas = c.replicas if c.replicas > _replicas else _replicas, resources = _resources, ports = [p.port for p in c.ports]}
        if c.build:
            build = forge.build_of(c.build)
    } for c in _svc_workloads] + [forge.RenderedWorkload {
        name = c.name
        image = "{{.ProjectName}}"
        command = c.command
        env_vars = c.env_vars
        deploy = forge.BuildOnly {}
        if c.build:
            build = forge.build_of(c.build)
    } for c in _tool_workloads]
    cronjobs = [forge.CronJob {
        name = c.name
        image = "{{.ProjectName}}"
        schedule = c.schedule
        command = c.command
        env_vars = c.env_vars
    } for c in _cron_workloads]
    operators = [forge.Operator {
        name = c.name
        image = "{{.ProjectName}}"
        crds = c.crds
        env_vars = c.env_vars
    } for c in _op_workloads]
    jobs = [forge.OneShotJob {
        name = c.name
        image = "{{.ProjectName}}"
        command = c.command
        before = c.before
        env_vars = c.env_vars
    } for c in _job_workloads]
    config_maps = []
    # SECRET VALUES for this env come from OUTSIDE forge. Every config field
    # marked `sensitive: true` in proto/config/v1/config.proto projects into
    # the manifest as a valueFrom.secretKeyRef, and `external` means forge
    # renders + validates that WIRING but never sees, writes, or stores a
    # value: no dotenv, no plaintext Secret in the render, nothing to leak
    # through a `kubectl get -o yaml` of a git-tracked file.
    #
    # Provision the Secret out of band — External Secrets Operator, sealed
    # secrets, your cloud's secret manager, or, once, by hand:
    #
    #   kubectl -n {{.ProjectName}}-staging create secret generic {{.ProjectName}}-secrets \
    #     --from-literal=database_url='postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require'
    #
    # `required_secrets` below turns "it is missing" from a silent
    # CreateContainerConfigError minutes after a green apply into a
    # pre-apply BLOCK naming the Secret and the key.
    secret_provider = forge.ExternalSecrets {}
    required_secrets = [forge.ExternalSecret {
        name = "{{.ProjectName}}-secrets"
        namespace = _namespace
        keys = ["database_url"]
        reason = "backs every `sensitive` config field (DATABASE_URL); the workloads read it via valueFrom.secretKeyRef and will not start without it"
    }]
{{- if .IngressEnabled}}
    gateways = ing.GATEWAYS
    http_routes = ing.HTTP_ROUTES
    grpc_routes = ing.GRPC_ROUTES
{{- end}}
}

output = forge.render(_bundle)
