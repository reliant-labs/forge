# dependencies
node_modules/

# next.js (.next = dev server, .next-prod = production builds — split so
# `npm run build` can't clobber a live dev server's cache)
.next/
.next-prod/
out/

# production
build/

# ── Generated code (regenerated by buf generate / forge generate) ──
# Proto TypeScript client code
src/gen/
# Pre-`_gen` per-service React Query hooks, from a tree generated before
# forge renamed the emitter's output. Nothing writes these names anymore;
# the rule stays so an un-upgraded checkout still ignores its leftovers.
#
# The CURRENT output — src/hooks/<svc>-hooks_gen.ts — and the src/hooks/
# index.ts barrel that re-exports it are deliberately NOT ignored. They
# are Tier-1 files exactly like src/lib/apiurl_gen.ts and src/mocks/
# *_gen.ts, which this project commits, and `forge ci verify-generated`
# compares a fresh `forge generate` against the checkout with `git status
# --porcelain`: an ignored generated file is invisible to that gate, so
# codegen drift in it passes CI silently. Ignoring them also broke a real
# upgrade — all 28 renamed hook files landed untracked, and a fresh clone
# had no hooks for the pages that import them.
#
# Do NOT collapse this into `src/hooks/*_gen.ts` or `src/lib/*_gen.ts`:
# apiurl_gen.ts, basepath_gen.ts and config_gen.ts are forge-emitted and
# ARE committed, so a blanket glob silently untracks them.
src/hooks/*-hooks.ts

# test coverage
coverage/

