        <span className="rounded-full bg-accent-surface p-1.5 text-accent group-hover:bg-accent-border">
          <ChevronRight aria-hidden className="h-4 w-4" strokeWidth={2} />
        </span>
      </div>
      {/* String() because a total_count declared int64 arrives as a bigint. */}
      <p className="mt-2 text-3xl font-semibold text-ink">{count === undefined ? "—" : String(count)}</p>
      <p className="mt-1 text-xs text-ink-subtle">Manage {{.LabelLower}}</p>
