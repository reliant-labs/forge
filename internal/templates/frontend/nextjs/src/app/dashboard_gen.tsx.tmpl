{{- range .Pages}}

function {{.ComponentIdent}}Tile() {
{{- if .HasTotalCount}}
  // Live count from the SERVER's total, not the length of the page this
  // fetched. `data.{{.ItemsField}}.length` is capped by page_size, so a tile
  // built that way reads "25" forever once the table outgrows one page —
  // and this file is the exemplar every hand-written tile is copied from.
  //
  // {{if .HasPageSize}}pageSize: 1 because the rows are not rendered here; only the
  // count is.{{else}}This List RPC has no page_size, so the request stays empty.{{end}}
  const { data } = {{.ListHook}}({{if .HasPageSize}}{ pageSize: 1 }{{else}}{}{{end}});
  const count = data?.{{.TotalCountField}};
{{- else}}
  // This List response declares no total_count, so the honest count is the
  // number of rows the server returned. Add `int32 total_count` (or
  // `int64`) to the List response and re-run `forge generate` to make the
  // tile report the real total instead of one page of it.
  const { data } = {{.ListHook}}({});
  const count = data?.{{.ItemsField}}?.length;
{{- end}}
  return (
    <Link
      href="/{{.Slug}}"
      className="group rounded-lg border border-border bg-surface p-5 shadow-sm transition-all hover:border-accent hover:shadow-md"
    >
      <div className="flex items-center justify-between">
