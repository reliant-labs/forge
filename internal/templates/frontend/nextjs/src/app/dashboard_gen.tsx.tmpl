/**
 * EntityTiles renders the per-entity stat-card grid. One card per CRUD
 * entity, linking into its list page, with a live count from the entity's
 * list hook. Empty state ("No resources yet") surfaces when the project
 * has no CRUD services yet.
 */
export function EntityTiles() {
  if (ALL_ROUTES.length === 0) {
    return (
      <div className="rounded-lg border border-dashed border-border-strong p-12 text-center">
        <Inbox aria-hidden className="mx-auto h-10 w-10 text-ink-subtle" strokeWidth={1.5} />
        <p className="mt-3 text-sm font-medium text-ink">No resources yet</p>
        <p className="mt-1 text-sm text-ink-muted">
          Add services with CRUD RPCs and run <code className="rounded bg-surface-muted px-1.5 py-0.5 text-xs font-mono">forge generate</code> to populate this dashboard.
        </p>
      </div>
    );
  }

  return (
    <div className="mb-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {{- range .Pages}}
      <{{.ComponentIdent}}Tile />
      {{- end}}
    </div>
  );
}

/**
 * QuickActions renders a "Create <Entity>" button for every CRUD entity
 * whose service has a Create RPC — and ONLY those, so each button targets
 * a create page the generator actually emitted. Returns null when no
 * entity is creatable.
 */
export function QuickActions() {
  const createRoutes = ALL_ROUTES.filter((route) => route.hasCreate);
  if (createRoutes.length === 0) {
    return null;
  }
  return (
    <div>
      <h2 className="mb-3 text-sm font-semibold uppercase tracking-wider text-ink-muted">Quick Actions</h2>
      <div className="flex flex-wrap gap-3">
        {createRoutes.map((route) => (
          <Link
            key={route.slug}
            href={`${route.path}/new`}
            className="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface px-4 py-2 text-sm font-medium text-ink shadow-sm transition-colors hover:bg-surface-muted hover:border-border-strong"
          >
            <Plus aria-hidden className="h-4 w-4 text-ink-subtle" strokeWidth={2} />
            Create {route.labelSingular}
          </Link>
        ))}
      </div>
    </div>
  );
}
