{
  "expo": {
    "name": "{{.FrontendName}}",
    "slug": "{{.FrontendName}}",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "{{nativeAppID .ProjectName .FrontendName}}",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "{{nativeAppID .ProjectName .FrontendName}}"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "{{nativeAppID .ProjectName .FrontendName}}"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "faceIDPermission": false }],
      "./plugins/with-forge-links"
    ]
  }
}
