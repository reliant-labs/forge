import { Stack } from "expo-router";
import { StatusBar } from "expo-status-bar";
import { QueryClientProvider } from "@tanstack/react-query";
import { queryClient } from "../src/lib/query-client";
import { EventBusProvider } from "../src/lib/event-context";
import { AuthContextProvider } from "../src/lib/auth/context";
import { setupQueryLifecycle } from "../src/lib/query-lifecycle";
import { useEffect } from "react";
import { ActivityIndicator, StyleSheet, View } from "react-native";
import { useAuth } from "../src/lib/auth/use-auth";

// Dev only: forward console output and uncaught errors to Metro, which prints
// them as `[browser:<level>]` lines into .forge/logs/<env>/frontend_<name>.log.
// A require inside `if (__DEV__)` is dropped from production bundles, so the
// forwarder is not even included there. Delete the next two lines to turn it off.
// eslint-disable-next-line @typescript-eslint/no-require-imports -- the require is what keeps this out of production bundles
if (__DEV__) require("../src/lib/devlog").installNativeDevLogging();

// Auth is wired in src/lib/auth/context: with EXPO_PUBLIC_FORGE_OIDC_* set it
// signs in through the system browser and feeds the token to the transport
// itself, so there is nothing to bridge here. Without them the app runs on the
// mock session provider (no sign-in, no Authorization header), as before.
//
// AuthStack is the guard. Signed-in screens are protected while the app is
// configured for native sign-in and nobody is signed in; sign-in is the
// reverse. In mock mode nothing is protected. expo-router sends a guarded-out
// user to the first screen still reachable, so a sign-out lands on sign-in and
// a sign-in lands on the app, with no navigation code of your own.
//
// /oauthredirect and /signedout are deliberately NOT guarded: they receive the
// deep link the browser returns (see app/oauthredirect.tsx) and bounce home.
// Add your own signed-in screens inside the first <Stack.Protected>.
function AuthStack() {
  const { isLoading, isAuthenticated, requiresSignIn } = useAuth();

  // Until the saved session has been restored we cannot know which side of the
  // guard the user is on; showing either would flash the wrong screen.
  if (isLoading && requiresSignIn) {
    return (
      <View style={styles.restoring}>
        <ActivityIndicator />
      </View>
    );
  }

  const signedIn = !requiresSignIn || isAuthenticated;
  return (
    <Stack>
      <Stack.Protected guard={signedIn}>
        <Stack.Screen name="index" options={{"{{"}} title: "{{.FrontendName}}" {{"}}"}} />
      </Stack.Protected>
      <Stack.Protected guard={!signedIn}>
        <Stack.Screen name="sign-in" options={{"{{"}} title: "Sign in", headerShown: false {{"}}"}} />
      </Stack.Protected>
    </Stack>
  );
}

const styles = StyleSheet.create({
  restoring: { flex: 1, alignItems: "center", justifyContent: "center" },
});

export default function RootLayout() {
  const isDev = process.env.NODE_ENV === "development";
  // AppState -> focusManager, network state -> onlineManager (see query-lifecycle).
  useEffect(() => setupQueryLifecycle(queryClient), []);

  return (
    <QueryClientProvider client={queryClient}>
      <EventBusProvider devMode={isDev}>
        <AuthContextProvider>
          <AuthStack />
          <StatusBar style="auto" />
        </AuthContextProvider>
      </EventBusProvider>
    </QueryClientProvider>
  );
}
