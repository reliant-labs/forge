{
  "name": "{{.FrontendName}}",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@{{pnpmVersion}}",
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "start": "expo start",
    "dev": "node expo-dev.cjs",
    "build": "expo export --platform web --output-dir dist",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@bufbuild/protobuf": "^2.5.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-web": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@reliantlabs/forge-web-runtime": "^0.13.0",
    "@tanstack/react-query": "^5.62.0",
{{- if .Workspaces}}
    "{{.APIPackage}}": "workspace:*",
    "{{.HooksPackage}}": "workspace:*",
    "{{.UINativePackage}}": "workspace:*",
{{- end}}
    "expo": "~58.0.24",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@bufbuild/protoc-gen-es": "^2.5.0",
    "@jest/globals": "^30.0.0",
    "@react-native/jest-preset": "~0.88.1",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.25",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
    "prettier": "3.5.3",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  }
}
