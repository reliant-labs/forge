//
// VerifyEmailForm — the /auth/verify page a "confirm your address" email
// opens. Like the magic-link page it is inert until the button is pressed,
// so a mail scanner opening the link spends nothing.
//
// Confirming issues no session by itself. An account created without a
// password (where passkeys are offered) may add one right here; anyone else
// signs in as usual.

import { useState } from "react";

import Button from "@/components/ui/button";
import { AuthError, passkeySignIn, registerPasskey, verifyEmail } from "@/lib/auth/native-login";

export interface VerifyEmailFormProps {
  userID: string | null;
  code: string | null;
  signInHref: string;
  onSignedIn: () => void | Promise<void>;
}

export function VerifyEmailForm({ userID, code, signInHref, onSignedIn }: VerifyEmailFormProps) {
  const [state, setState] = useState<"ready" | "verified" | "enroll">("ready");
  const [error, setError] = useState<string | null>(null);
  const [busy, setBusy] = useState(false);

  if (!userID || !code) {
    return (
      <div className="rounded-xl border border-border bg-surface p-8 shadow-sm">
        <h1 className="text-xl font-semibold tracking-tight text-ink">Confirm your email</h1>
        <p role="alert" className="mt-4 text-sm text-ink">
          This link is incomplete. Open the link from the email again, or ask for a new one from the
          sign-in screen.
        </p>
        <SignInLink href={signInHref} />
      </div>
    );
  }

  async function act(action: () => Promise<void>) {
    setBusy(true);
    setError(null);
    try {
      await action();
    } catch (err) {
      setError(err instanceof AuthError ? err.message : "That did not work. Please try again.");
    } finally {
      setBusy(false);
    }
  }

  return (
    <div className="rounded-xl border border-border bg-surface p-8 shadow-sm">
      <h1 className="text-xl font-semibold tracking-tight text-ink">Confirm your email</h1>

      {state === "ready" ? (
        <Button
          type="button"
          size="xl"
          fullWidth
          loading={busy}
          className="mt-6"
          onClick={() =>
            void act(async () => {
              const result = await verifyEmail(userID, code);
              setState(result.enroll ? "enroll" : "verified");
            })
          }
        >
          Confirm my email
        </Button>
      ) : null}

      {state === "verified" ? (
        <p role="status" className="mt-4 text-sm text-ink">
          Your email is confirmed. You can sign in now.
        </p>
      ) : null}

      {state === "enroll" ? (
        <>
          <p role="status" className="mt-4 text-sm text-ink">
            Your email is confirmed. Create a passkey to sign in with this device.
          </p>
          <Button
            type="button"
            size="xl"
            fullWidth
            loading={busy}
            className="mt-6"
            onClick={() =>
              void act(async () => {
                await registerPasskey();
                await passkeySignIn();
                await onSignedIn();
              })
            }
          >
            Create a passkey
          </Button>
        </>
      ) : null}

      {error ? (
        <p
          role="alert"
          className="mt-4 break-words rounded-md border border-danger-border bg-danger-surface p-3 text-sm text-danger-ink"
        >
          {error}
        </p>
      ) : null}
      <SignInLink href={signInHref} />
    </div>
  );
}

function SignInLink({ href }: { href: string }) {
  return (
    <p className="mt-4 text-center text-sm text-ink-muted">
      <a className="font-medium text-accent underline" href={href}>
        Go to sign in
      </a>
    </p>
  );
}
