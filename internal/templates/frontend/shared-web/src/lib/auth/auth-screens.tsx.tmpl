{{end}}// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// The sign-in and callback SCREENS, framework-agnostic.
//
// ── Why these are components and not pages ────────────────────────────
//
// Next.js and Vite disagree about routing and about nothing else here. The
// App Router wants a default-exported `page.tsx` in a directory that names the
// route; TanStack Router wants a `createRoute({...})` entry in `routes.tsx`.
// Both then render the SAME two screens.
//
// So the screens live here, once, and each framework's route file is a
// four-line adapter that supplies the two things that genuinely differ:
//
//   - `search`   — how to read the query string (Next: useSearchParams; Vite:
//                  window.location.search, since the callback's params are
//                  not part of the typed route).
//   - `navigate` — how to go somewhere after a successful exchange (Next:
//                  useRouter().replace; Vite: router.navigate).
//
// Injecting those two rather than importing a router keeps this file testable
// with no router mounted at all, which is what `auth-screens.test.tsx` does.

import { useEffect, useRef, useState } from "react";

import Button from "@/components/ui/button";

import { OAuthError } from "./oidc";
import { handleAuthCallback, isOidcConfigured } from "./oidc-provider";

/** How a screen leaves. Supplied by whichever router is in play. */
export type Navigate = (path: string) => void;

/**
 * SignInScreen — one button that hands off to the identity provider.
 *
 * There is NO username/password form here — but that is a choice, not a
 * limitation. Two different claims are easy to conflate, so spelled out:
 *
 *   - TRUE: this app must not POST a password to its OWN backend. forge's
 *     backend is validation-only and mints no tokens, so there is no
 *     `/auth/login` endpoint to send one to — collecting a credential here
 *     would just be a field with nowhere legitimate to go.
 *   - FALSE: "a first-party form is therefore impossible." It is not. A form
 *     CAN send the password straight to the IdP's own API from the browser —
 *     this app still never handles it, and PKCE is unaffected. forge does not
 *     scaffold one because every such API is provider-proprietary (there is
 *     no standard for it the way OIDC discovery generalizes this flow), so
 *     generated code would only ever fit one vendor. Build it against your
 *     IdP's API if leaving your product mid-signup is the wrong experience;
 *     this screen stays the better default otherwise, since it is portable
 *     across IdPs and inherits MFA, social sign-in and password reset for
 *     free.
 *
 * `login` is passed in (from `useAuth()`) rather than imported so this screen
 * renders identically against the mock provider — which is what makes a
 * signed-out-first product's routes developable with no IdP.
 */
export function SignInScreen({
  login,
  isAuthenticated,
  navigate,
  returnTo = "/",
  appName = "{{.ProjectName}}",
}: {
  login: () => Promise<void>;
  isAuthenticated: boolean;
  navigate: Navigate;
  returnTo?: string;
  /**
   * Shown if this screen ever has to render — an error, or the no-IdP
   * notice. Defaults to the project name captured at scaffold time.
   */
  appName?: string;
}) {
  const [error, setError] = useState<string | null>(null);
  const configured = isOidcConfigured();

  // Already signed in: this route is a waypoint, not a destination.
  useEffect(() => {
    if (isAuthenticated) {
      navigate(returnTo);
    }
  }, [isAuthenticated, navigate, returnTo]);

  // ── THE REDIRECT IS THE PAGE ──────────────────────────────────────────
  //
  // A signed-out visitor is sent to the identity provider immediately. There
  // is no "Sign in" button to press first, because pressing it is the only
  // thing that button could ever do — an interstitial whose sole content is
  // a single control that the user did not choose to visit is a click that
  // communicates nothing.
  //
  // This is how a production app behaves: hitting a gated URL signed out
  // lands you on the IdP's login form, not on your own app's doorstep asking
  // whether you would like to knock.
  //
  // The screen below still exists, and matters, for the cases where the
  // redirect CANNOT happen: no IdP configured, WebCrypto unavailable on an
  // insecure origin, storage blocked. Those need a human-readable
  // explanation, and silently rendering nothing would be a blank page.
  const startedRef = useRef(false);
  useEffect(() => {
    if (isAuthenticated || !configured || startedRef.current) return;
    // StrictMode mounts effects twice in development. A second login() would
    // overwrite the first one's PKCE verifier mid-flight, so the redirect is
    // fired exactly once per mount.
    startedRef.current = true;
    void (async () => {
      try {
        await login();
        // Not reached in the normal case: the browser has navigated away.
      } catch (err) {
        startedRef.current = false;
        setError(err instanceof Error ? err.message : String(err));
      }
    })();
  }, [isAuthenticated, configured, login]);

  // The redirect is in flight (or the session is being restored). Render a
  // quiet placeholder rather than a sign-in card that is about to vanish —
  // a card that flashes for 200ms and disappears reads as a glitch.
  if (configured && !error) {
    return (
      <main className="flex min-h-screen flex-col items-center justify-center bg-surface-muted p-6">
        <div
          className="h-8 w-8 animate-spin rounded-full border-2 border-border border-t-accent"
          role="status"
          aria-label="Redirecting to sign in"
        />
      </main>
    );
  }

  // Either the redirect failed, or there is no IdP to redirect to. Both need
  // saying out loud.
  return (
    <main className="flex min-h-screen flex-col items-center justify-center bg-surface-muted p-6">
      <div className="w-full max-w-sm">
        <div className="rounded-xl border border-border bg-surface p-8 shadow-sm">
          <h1 className="text-xl font-semibold tracking-tight text-ink">
            {error ? "Sign-in unavailable" : `Sign in to ${appName}`}
          </h1>

          {error ? (
            <p
              role="alert"
              className="mt-3 break-words rounded-md border border-danger-border bg-danger-surface p-3 text-sm text-danger-ink"
            >
              {error}
            </p>
          ) : (
            <p className="mt-2 text-sm text-ink-muted">
              This app has no identity provider configured, so it is using a
              local development session.
            </p>
          )}

          <Button
            onClick={() => {
              setError(null);
              startedRef.current = false;
              void login();
            }}
            className="mt-6 w-full"
          >
            {error ? "Try again" : "Continue"}
          </Button>
        </div>

        {!configured ? (
          <p className="mt-4 rounded-md border border-warning-border bg-warning-surface px-3 py-2 text-center text-xs text-warning-ink">
            No identity provider configured — this authenticates no one.
          </p>
        ) : null}
      </div>
    </main>
  );
}

/**
 * Which query string has already been redeemed, and the in-flight promise for
 * it. Module-level, NOT a ref or a piece of state.
 *
 * This is the StrictMode double-invoke guard, and where it lives is the whole
 * point. React 18+ StrictMode mounts an effect, tears it down, and mounts it
 * AGAIN in development. A `useRef` guard does not help: the second mount gets
 * a fresh ref, so it re-runs. An authorization code is single-use, so that
 * second run redeems a spent code and shows the user `invalid_grant` on a
 * login that actually succeeded — a bug that appears only in development and
 * only intermittently, which is the worst possible place for it.
 *
 * Keyed by the search string so a genuinely new callback (a second sign-in in
 * the same page session) is not blocked by the first one's entry.
 */
const redemptions = new Map<string, Promise<string>>();

/**
 * Forgets every recorded redemption.
 *
 * Exported for tests, which mount this screen repeatedly with the same
 * fixture query string — without a reset, case two would reuse case one's
 * cached promise and assert against an exchange that never ran.
 *
 * There is no reason to call this from application code: a real callback URL
 * is visited once, and forgetting a redemption is precisely what re-enables
 * the double-redeem this cache exists to prevent.
 */
export function resetRedemptionsForTests(): void {
  redemptions.clear();
}

/**
 * AuthCallbackScreen — completes the flow, then leaves.
 *
 * The exchange runs exactly once per callback URL; see `redemptions` above.
 *
 * On success it REPLACES the history entry rather than pushing: the callback
 * URL carries a spent code, and leaving it in history means Back returns to a
 * page that can only fail.
 */
export function AuthCallbackScreen({
  search,
  navigate,
}: {
  search: string;
  navigate: Navigate;
}) {
  const [error, setError] = useState<{ message: string; detail: string } | null>(
    null,
  );

  useEffect(() => {
    let cancelled = false;
    void (async () => {
      try {
        // Reuse the in-flight or completed redemption for this exact URL
        // rather than starting a second one.
        let redemption = redemptions.get(search);
        if (!redemption) {
          redemption = handleAuthCallback(search);
          redemptions.set(search, redemption);
        }
        const returnTo = await redemption;
        if (!cancelled) {
          navigate(returnTo);
        }
      } catch (err) {
        // A failed redemption is not retried on remount either: the code is
        // spent (or was never valid), so a retry can only fail differently.
        // The user is offered "Try again", which starts a fresh login.
        if (cancelled) {
          return;
        }
        // An IdP-reported failure and a local failure read very differently
        // to whoever has to fix them, so they are told apart here.
        if (err instanceof OAuthError) {
          setError({
            message:
              err.code === "access_denied"
                ? "Sign-in was cancelled."
                : "The identity provider rejected this sign-in.",
            detail: err.description || err.code,
          });
        } else {
          setError({
            message: "This sign-in could not be completed.",
            detail: err instanceof Error ? err.message : String(err),
          });
        }
      }
    })();
    return () => {
      cancelled = true;
    };
  }, [search, navigate]);

  // Same shell as the sign-in screen — this is the same moment in the same
  // flow, and a differently-framed error page reads as a different app.
  if (error) {
    return (
      <main className="flex min-h-screen flex-col items-center justify-center bg-surface-muted p-6">
        <div className="w-full max-w-sm rounded-xl border border-border bg-surface p-8 text-center shadow-sm">
          <h1 className="text-xl font-semibold tracking-tight text-ink">
            {error.message}
          </h1>
          <p
            role="alert"
            className="mt-3 break-words rounded-md border border-danger-border bg-danger-surface p-3 text-left text-sm text-danger-ink"
          >
            {error.detail}
          </p>
          <Button
            variant="outline"
            className="mt-6 w-full"
            onClick={() => navigate("/auth/sign-in")}
          >
            Try again
          </Button>
        </div>
      </main>
    );
  }

  return (
    <main className="flex min-h-screen flex-col items-center justify-center bg-surface-muted p-6">
      <div
        className="h-8 w-8 animate-spin rounded-full border-2 border-border border-t-accent"
        role="status"
        aria-label="Completing sign-in"
      />
    </main>
  );
}
