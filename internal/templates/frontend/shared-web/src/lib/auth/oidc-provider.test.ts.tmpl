// Which provider the app runs on, and the mock still working.
//
// `selectAuthProvider()` is the one switch between real OIDC and the mock, so
// it is the one place a project can silently end up doing the wrong thing:
// a fake session against a real backend, or a redirect to an IdP that was
// never configured. These tests derive from the BEHAVIOUR of the provider
// that comes back — what login() does, what getToken() returns — rather than
// from any flag, because the flag is what could be wrong.
//
{{if .HasTypedConfig}}// Settings are read through the generated typed config (@/lib/config_gen),
// which memoizes the validated result at module scope, so each case
// re-imports the module with the environment it wants via vi.resetModules()
// — that reset is what drops the memo along with the module.{{else}}// Env vars are read at module scope in oidc-provider.ts (which is what lets a
// bundler inline them), so each case re-imports the module with the
// environment it wants via vi.resetModules().{{end}}

import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";

/**
 * Loads a fresh copy of the provider module under a given environment.
 *
 * EVERY key this module reads is stubbed on every call, not just the ones the
 * caller names. The module reads its env at module scope (which is what lets
 * a bundler inline the values), so a key left over from a previous case would
 * leak into the next one — and the leak is invisible: a test meaning "client
 * id only" would silently also have an issuer, and pass for the wrong reason.
 */
async function loadWithEnv(
  vars: Record<string, string | undefined>,
): Promise<typeof import("./oidc-provider")> {
  vi.resetModules();
  for (const key of ALL_ENV_KEYS) {
    vi.stubEnv(key, vars[key] ?? "");
  }
  return import("./oidc-provider");
}

{{if .HasTypedConfig}}// The typed-config build reads its settings through loadConfig() (@/lib/
// config_gen), whose server-side branch reads the UNPREFIXED env names —
// the proto's env_var spelling, the same one a deployed workload receives.
// These constants must therefore name what config_gen reads, NOT the
// build-time-inlined NEXT_PUBLIC_/VITE_ names the other branches use: a
// prefixed key stubbed here would never reach the provider, readOidcConfig()
// would return null, and every case below would die in setup.
const ISSUER = "OIDC_ISSUER";
const CLIENT_ID = "OIDC_CLIENT_ID";
const REDIRECT_URI = "OIDC_REDIRECT_URI";
const SCOPES = "OIDC_SCOPES";
const MOCK = "MOCK_API";{{else}}{{if eq .Platform "vite-spa"}}const ISSUER = "VITE_OIDC_ISSUER";
const CLIENT_ID = "VITE_OIDC_CLIENT_ID";
const REDIRECT_URI = "VITE_OIDC_REDIRECT_URI";
const SCOPES = "VITE_OIDC_SCOPES";
const MOCK = "VITE_MOCK_API";{{else}}const ISSUER = "NEXT_PUBLIC_OIDC_ISSUER";
const CLIENT_ID = "NEXT_PUBLIC_OIDC_CLIENT_ID";
const REDIRECT_URI = "NEXT_PUBLIC_OIDC_REDIRECT_URI";
const SCOPES = "NEXT_PUBLIC_OIDC_SCOPES";
const MOCK = "NEXT_PUBLIC_MOCK_API";{{end}}{{end}}

/** Every env key the provider module reads. See loadWithEnv. */
const ALL_ENV_KEYS = [ISSUER, CLIENT_ID, REDIRECT_URI, SCOPES, MOCK];

beforeEach(() => {
  vi.unstubAllEnvs();
});

afterEach(() => {
  vi.unstubAllEnvs();
  vi.resetModules();
});

describe("provider selection", () => {
  it("clears every env key it knows about, and knows about a non-empty set", async () => {
    // Guards the guard: if ALL_ENV_KEYS were empty (or went stale), every
    // case below would run under whatever the ambient environment happened
    // to be and could pass for the wrong reason.
    expect(ALL_ENV_KEYS.length).toBeGreaterThan(0);
    for (const key of ALL_ENV_KEYS) {
      expect(key).toMatch(/OIDC|MOCK/);
    }
    // And the isolation actually works: an issuer set by one load must not
    // survive into the next.
    await loadWithEnv({ [ISSUER]: "https://idp.example.com", [CLIENT_ID]: "c" });
    const clean = await loadWithEnv({});
    expect(clean.readOidcConfig()).toBeNull();
  });

  it("uses the MOCK when no IdP is configured", async () => {
    const mod = await loadWithEnv({});
    expect(mod.isOidcConfigured()).toBe(false);
    expect(mod.readOidcConfig()).toBeNull();

    // The behavioural tell: the mock's login() RESOLVES and never navigates,
    // where the real provider's redirects.
    const provider = mod.selectAuthProvider();
    await expect(provider.login()).resolves.toBeUndefined();
  });

  it("uses the MOCK in pure-mock mode even when an IdP IS configured", async () => {
    // Every RPC is answered locally, so there is no server to authenticate to
    // and redirecting to an IdP would be pure friction.
    const mod = await loadWithEnv({
      [MOCK]: "true",
      [ISSUER]: "https://idp.example.com",
      [CLIENT_ID]: "client-1",
    });
    const provider = mod.selectAuthProvider();
    await expect(provider.login()).resolves.toBeUndefined();
    // The mock hands out its fixture session, which is what gives scaffolded
    // UI a user to render offline.
    expect(provider.getUser()).not.toBeNull();
    expect(await provider.getToken()).toBe("mock-token-dev");
  });

  it("uses the REAL provider once an issuer and client id exist", async () => {
    const mod = await loadWithEnv({
      [ISSUER]: "https://idp.example.com",
      [CLIENT_ID]: "client-1",
    });
    expect(mod.isOidcConfigured()).toBe(true);

    const provider = mod.selectAuthProvider();
    // Signed out with no fixture: the real provider invents no session.
    expect(provider.getUser()).toBeNull();
    expect(await provider.getToken()).toBeNull();
    expect(provider.isAuthenticated()).toBe(false);
  });

  it("REFUSES a half-configured IdP instead of quietly using the mock", async () => {
    // An issuer with no client id is someone mid-setup. Falling back to the
    // mock there produces a fake session against a real backend — the most
    // confusing state this file could create.
    const mod = await loadWithEnv({ [ISSUER]: "https://idp.example.com" });
    expect(() => mod.readOidcConfig()).toThrow(/half-configured/);

    const other = await loadWithEnv({ [CLIENT_ID]: "client-1" });
    expect(() => other.readOidcConfig()).toThrow(/half-configured/);
  });

  it("defaults the redirect URI to this origin's callback path", async () => {
    const mod = await loadWithEnv({
      [ISSUER]: "https://idp.example.com",
      [CLIENT_ID]: "client-1",
    });
    const config = mod.readOidcConfig();
    expect(config?.redirectUri).toBe(
      `${window.location.origin}${mod.CALLBACK_PATH}`,
    );
    expect(mod.CALLBACK_PATH).toBe("/auth/callback");
  });

  it("defaults to the OIDC scopes an app actually needs", async () => {
    const mod = await loadWithEnv({
      [ISSUER]: "https://idp.example.com",
      [CLIENT_ID]: "client-1",
    });
    // "openid" is what makes this OIDC rather than bare OAuth 2.0 — without
    // it there is no id_token and so no user to render.
    expect(mod.readOidcConfig()?.scopes).toContain("openid");
  });

  it("hardcodes no identity provider anywhere in its configuration", async () => {
    // Derived from the RESOLVED CONFIG, not a grep: whatever the issuer is
    // set to is what comes out, so no vendor can be baked in.
    for (const issuer of [
      "https://tenant.us.auth0.com",
      "https://accounts.example.okta.com",
      "https://keycloak.internal/realms/app",
      "https://zitadel.example.com",
    ]) {
      const mod = await loadWithEnv({ [ISSUER]: issuer, [CLIENT_ID]: "c" });
      expect(mod.readOidcConfig()?.issuer).toBe(issuer);
    }
  });
});

// ═══════════════════════════════════════════════════════════════════════
//  REFRESH ON EXPIRY — single-flight, rotation, and failing closed
// ═══════════════════════════════════════════════════════════════════════
//
// These drive the REAL provider (createOidcAuthProvider) with a fake discovery
// document and a fake token endpoint that COUNTS ITS OWN HITS. The hit count is
// the single-flight oracle: nothing here reads the provider's source or trusts
// a flag, it counts requests that actually left.
//
// The endpoint also rotates and revokes-on-reuse — the strictest provider
// behaviour in the wild — so a missing single-flight does not merely inflate a
// counter: it destroys the session the way it would in production.

/**
 * A token endpoint that counts hits, rotates, and revokes on reuse.
 *
 * `block()`/`release()` make concurrency deterministic: every caller is
 * guaranteed to be in flight before any response resolves, so the test cannot
 * pass by accident of scheduling.
 */
class CountingTokenEndpoint {
  tokenHits = 0;
  discoveryHits = 0;
  minted = 0;
  live = "refresh-1";
  readonly consumed = new Set<string>();
  revoked = false;
  private blocked = false;
  private readonly waiters: (() => void)[] = [];

  constructor(readonly opts: { fail?: boolean } = {}) {}

  block(): void {
    this.blocked = true;
  }
  release(): void {
    this.blocked = false;
    for (const w of this.waiters.splice(0)) w();
  }

  private json(status: number, payload: unknown): Response {
    return new Response(JSON.stringify(payload), {
      status,
      headers: { "Content-Type": "application/json" },
    });
  }

  readonly fetch: typeof fetch = async (url, init) => {
    const href = String(url);
    if (href.includes(".well-known/openid-configuration")) {
      this.discoveryHits += 1;
      return this.json(200, {
        issuer: ISSUER_URL,
        authorization_endpoint: `${ISSUER_URL}/auth`,
        token_endpoint: `${ISSUER_URL}/token`,
        end_session_endpoint: `${ISSUER_URL}/session/end`,
        jwks_uri: `${ISSUER_URL}/jwks`,
        code_challenge_methods_supported: ["S256"],
      });
    }

    this.tokenHits += 1;
    if (this.blocked) {
      await new Promise<void>((resolve) => this.waiters.push(resolve));
    }
    if (this.opts.fail) {
      return this.json(400, {
        error: "invalid_grant",
        error_description: "the refresh token has expired",
      });
    }

    const presented =
      new URLSearchParams(String(init?.body ?? "")).get("refresh_token") ?? "";
    if (this.revoked) {
      return this.json(400, { error: "invalid_grant", error_description: "grant revoked" });
    }
    if (this.consumed.has(presented)) {
      // Reuse detection: the whole grant dies, exactly as a real provider does
      // outside its brief grace window.
      this.revoked = true;
      return this.json(400, {
        error: "invalid_grant",
        error_description: "refresh token already used",
      });
    }
    this.consumed.add(presented);
    this.minted += 1;
    this.live = `refresh-${this.minted + 1}`;
    return this.json(200, {
      access_token: `access-for-${presented}`,
      token_type: "Bearer",
      expires_in: 3600,
      refresh_token: this.live,
      scope: "openid profile offline_access",
    });
  };
}

const ISSUER_URL = "https://idp.example.com/oidc";

describe("refresh on expiry", () => {
  afterEach(async () => {
    const storage = await import("./oidc-storage");
    storage.clearSession();
  });

  /** Loads the provider module and seeds an EXPIRED session. */
  async function providerWithExpiredSession(idp: CountingTokenEndpoint) {
    vi.stubGlobal("fetch", idp.fetch);
    const mod = await loadWithEnv({
      [ISSUER]: ISSUER_URL,
      [CLIENT_ID]: "spa-client",
    });
    const storage = await import("./oidc-storage");
    storage.clearSession();
    // Genuinely past expiry, so getAccessToken() alone would return null and
    // the session would be silently dead — which is the bug being fixed.
    storage.setSession({
      accessToken: "expired-access-token",
      refreshToken: idp.live,
      idToken: "",
      expiresIn: -1,
    });
    const config = mod.readOidcConfig();
    if (!config) throw new Error("test setup: config must not be null");
    return { provider: mod.createOidcAuthProvider(config), mod, storage };
  }

  it("makes exactly ONE token request for ten concurrent getToken() calls", async () => {
    const idp = new CountingTokenEndpoint();
    const { provider } = await providerWithExpiredSession(idp);

    // Hold the response so all ten callers are provably in flight at once.
    idp.block();
    const calls = Array.from({ length: 10 }, () => provider.getToken());
    // Let every call reach the fetch boundary before anything resolves.
    await Promise.resolve();
    idp.release();
    const tokens = await Promise.all(calls);

    // THE assertion: one refresh, not ten.
    expect(idp.tokenHits).toBe(1);
    // Every caller got the same live token — none got null or a stale value.
    expect(new Set(tokens).size).toBe(1);
    expect(tokens[0]).toBe("access-for-refresh-1");
    // And the grant survived, because no consumed token was ever replayed.
    expect(idp.revoked).toBe(false);
  });

  it("stores the rotated token, so a LATER refresh also succeeds", async () => {
    const idp = new CountingTokenEndpoint();
    const { provider, storage } = await providerWithExpiredSession(idp);

    const first = await provider.getToken();
    expect(first).toBe("access-for-refresh-1");
    expect(storage.getRefreshToken()).toBe("refresh-2");

    // Expire again and refresh a second time. The provider must present the
    // ROTATED token; presenting the original would trip reuse detection and
    // revoke the grant.
    storage.setSession({
      accessToken: "expired-again",
      refreshToken: storage.getRefreshToken() ?? "",
      expiresIn: -1,
    });
    const second = await provider.getToken();
    expect(second).toBe("access-for-refresh-2");
    expect(idp.revoked).toBe(false);
    expect(idp.tokenHits).toBe(2);
  });

  it("CLEARS the session when refresh fails, rather than leaving a stale one", async () => {
    const idp = new CountingTokenEndpoint({ fail: true });
    const { provider, storage } = await providerWithExpiredSession(idp);
    // The failure path logs a warning by design; keep the test output clean.
    const warn = vi.spyOn(console, "warn").mockImplementation(() => {});

    const seen: (unknown | null)[] = [];
    provider.onAuthStateChange((user) => seen.push(user));

    expect(await provider.getToken()).toBeNull();

    // Session gone: no access token, no refresh token, not authenticated.
    expect(storage.getAccessToken()).toBeNull();
    expect(storage.getRefreshToken()).toBeNull();
    expect(provider.isAuthenticated()).toBe(false);
    // And subscribers were told, which is what lets an app react.
    expect(seen).toContain(null);
    // Failing closed means it warned rather than throwing into an unrelated RPC.
    expect(warn).toHaveBeenCalled();
    warn.mockRestore();
  });

  it("does NOT retry in a loop against a provider that is refusing", async () => {
    const idp = new CountingTokenEndpoint({ fail: true });
    const { provider } = await providerWithExpiredSession(idp);
    const warn = vi.spyOn(console, "warn").mockImplementation(() => {});

    await provider.getToken();
    const afterFirst = idp.tokenHits;
    // Subsequent calls find no session at all, so they must not keep asking.
    await provider.getToken();
    await provider.getToken();

    expect(afterFirst).toBe(1);
    expect(idp.tokenHits).toBe(1);
    warn.mockRestore();
  });

  it("returns null cleanly for an expired token with NO refresh token", async () => {
    // The anonymous / browse case: a public RPC must keep working, and there
    // must be no attempt to refresh with a credential that does not exist.
    const idp = new CountingTokenEndpoint();
    vi.stubGlobal("fetch", idp.fetch);
    const mod = await loadWithEnv({
      [ISSUER]: ISSUER_URL,
      [CLIENT_ID]: "spa-client",
    });
    const storage = await import("./oidc-storage");
    storage.clearSession();
    // Genuinely PAST expiry (negative expiresIn), not merely inside the skew:
    // this is the case where getAccessToken() itself returns null, and the only
    // question is whether the provider tries to refresh anyway.
    storage.setSession({
      accessToken: "expired-access-token",
      refreshToken: "",
      expiresIn: -1,
    });
    const config = mod.readOidcConfig();
    if (!config) throw new Error("test setup: config must not be null");
    const provider = mod.createOidcAuthProvider(config);

    // Proves the precondition: the token really is expired, so this test is
    // about the missing refresh token and not about an unexpired token.
    expect(storage.getAccessToken()).toBeNull();

    // Nothing may be logged. A provider that ATTEMPTS a refresh without a
    // credential fails somewhere — locally in oidc.ts ("missing required
    // field") or at the endpoint — and either way calls onRefreshFailed, which
    // warns. So a silent call is the real evidence that no attempt was made;
    // asserting only tokenHits === 0 would pass even when the attempt was made
    // and rejected before the fetch, which is a bug with a confusing log line.
    const warn = vi.spyOn(console, "warn").mockImplementation(() => {});

    expect(await provider.getToken()).toBeNull();

    // No refresh token means no request and no complaint: anonymous browsing
    // of a public RPC is a normal state, not a failure to report.
    expect(idp.tokenHits).toBe(0);
    expect(warn).not.toHaveBeenCalled();
    warn.mockRestore();
  });

  it("does not refresh a token that is still comfortably valid", async () => {
    const idp = new CountingTokenEndpoint();
    vi.stubGlobal("fetch", idp.fetch);
    const mod = await loadWithEnv({
      [ISSUER]: ISSUER_URL,
      [CLIENT_ID]: "spa-client",
    });
    const storage = await import("./oidc-storage");
    storage.clearSession();
    storage.setSession({
      accessToken: "still-good",
      refreshToken: "refresh-1",
      expiresIn: 3600,
    });
    const config = mod.readOidcConfig();
    if (!config) throw new Error("test setup: config must not be null");
    const provider = mod.createOidcAuthProvider(config);

    expect(await provider.getToken()).toBe("still-good");
    expect(idp.tokenHits).toBe(0);
  });

  it("refreshes EARLY, inside the skew, rather than at the expiry boundary", async () => {
    const idp = new CountingTokenEndpoint();
    vi.stubGlobal("fetch", idp.fetch);
    const mod = await loadWithEnv({
      [ISSUER]: ISSUER_URL,
      [CLIENT_ID]: "spa-client",
    });
    const storage = await import("./oidc-storage");
    storage.clearSession();
    // Not expired — but inside REFRESH_SKEW_MS, so a request issued now could
    // outlive the token. This must refresh.
    const withinSkew = Math.floor(mod.REFRESH_SKEW_MS / 1000) - 5;
    expect(withinSkew).toBeGreaterThan(0);
    storage.setSession({
      accessToken: "about-to-expire",
      refreshToken: "refresh-1",
      expiresIn: withinSkew,
    });
    const config = mod.readOidcConfig();
    if (!config) throw new Error("test setup: config must not be null");
    const provider = mod.createOidcAuthProvider(config);

    // The token is STILL VALID at this instant, so a naive implementation
    // would hand it back untouched.
    expect(storage.getAccessToken()).toBe("about-to-expire");
    expect(await provider.getToken()).toBe("access-for-refresh-1");
    expect(idp.tokenHits).toBe(1);
  });
});

describe("offline_access implies prompt=consent", () => {
  it("asks for consent when offline_access is requested, and not otherwise", async () => {
    const mod = await loadWithEnv({
      [ISSUER]: ISSUER_URL,
      [CLIENT_ID]: "spa-client",
    });
    // OIDC Core §11: without prompt=consent the server MUST ignore
    // offline_access — silently. So requesting the scope without the prompt
    // yields no refresh token and no error, which is the bug this prevents.
    expect(mod.promptFor(["openid", "profile", "offline_access"])).toEqual({
      prompt: "consent",
    });
    // No offline_access means no reason to force a consent screen on the user.
    expect(mod.promptFor(["openid", "profile", "email"])).toBeUndefined();
  });

  it("puts prompt=consent on the actual authorization URL", async () => {
    // Derived from the URL the flow WOULD navigate to, not from promptFor in
    // isolation — that is what proves the two are actually wired together.
    const idp = new CountingTokenEndpoint();
    vi.stubGlobal("fetch", idp.fetch);
    const mod = await loadWithEnv({
      [ISSUER]: ISSUER_URL,
      [CLIENT_ID]: "spa-client",
      [SCOPES]: "openid profile email offline_access",
    });
    const config = mod.readOidcConfig();
    if (!config) throw new Error("test setup: config must not be null");
    expect(config.scopes).toContain("offline_access");

    // login() navigates; capture the destination instead of leaving jsdom.
    // The whole location object is replaced rather than spying on `assign`,
    // because jsdom defines it non-configurably ("Cannot redefine property").
    let assigned = "";
    const realLocation = window.location;
    vi.stubGlobal("location", {
      ...realLocation,
      origin: realLocation.origin,
      pathname: "/dashboard",
      search: "",
      assign: (url: string | URL) => {
        assigned = String(url);
      },
    });

    await mod.createOidcAuthProvider(config).login();

    expect(assigned).not.toBe("");
    const params = new URL(assigned).searchParams;
    expect(params.get("prompt")).toBe("consent");
    expect(params.get("scope")).toContain("offline_access");
    vi.unstubAllGlobals();
  });
});

describe("the mock provider is still reachable", () => {
  it("keeps working as a signed-out-first session under pure mock", async () => {
    const mod = await loadWithEnv({ [MOCK]: "true" });
    const provider = mod.selectAuthProvider();

    // logout() and login() move the fixture session for real, which is what
    // lets a product build its public and gated routes with no IdP at all.
    await provider.logout();
    expect(provider.getUser()).toBeNull();
    expect(provider.isAuthenticated()).toBe(false);

    await provider.login();
    expect(provider.getUser()).not.toBeNull();
    expect(provider.isAuthenticated()).toBe(true);
  });

  it("notifies subscribers through the mock too", async () => {
    const mod = await loadWithEnv({ [MOCK]: "true" });
    const provider = mod.selectAuthProvider();
    const seen: (string | null)[] = [];
    const off = provider.onAuthStateChange((user) => seen.push(user?.id ?? null));
    await provider.logout();
    await provider.login();
    off();
    await provider.logout();
    expect(seen).toEqual([null, "mock-user-1"]);
  });
});
