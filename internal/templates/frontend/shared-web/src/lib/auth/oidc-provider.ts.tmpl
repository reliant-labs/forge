// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// The real {@link AuthProvider}: OIDC authorization-code flow with PKCE,
// against ANY compliant identity provider.
//
// This is the sibling of `session-provider.ts` (the mock, which is still
// there and still the right choice for pure-UI development). Which one your
// app runs on is decided by CONFIGURATION, in `selectAuthProvider()` at the
// bottom of this file — not by an environment flag that says "pretend".
//
// ── How the flow works, and where forge is not involved ───────────────
//
// forge's backend is validation-only: it checks bearer tokens and never mints
// them. Token acquisition is a conversation between this browser and your
// IdP that the forge server never sees, which is why there is no
// `/auth/login` endpoint anywhere in your project:
//
//   1. login()   — mint a PKCE verifier + state, stash them (see
//                  oidc-storage.ts), redirect to the IdP's /authorize.
//   2. the IdP   — authenticates the user itself, then redirects back to
//                  this app's callback with ?code= and ?state=.
//   3. callback  — verify state, take the verifier, POST both to the IdP's
//                  /token, hold the resulting token in memory.
//   4. every RPC — the Connect transport calls getToken() and attaches
//                  `Authorization: Bearer …`. The forge server validates it
//                  against the same issuer's JWKS.
//
// Step 4 is why `jwt_issuer` / `jwt_jwks_url` in your backend config must
// point at the SAME issuer configured here. That is the only coupling
// between the two halves.
//
// ── Configuring it: one issuer URL is enough ──────────────────────────
//
// Set these in your environment (they are inlined into the bundle at build
// time, and all three are PUBLIC values — a client id is an identifier, not
// a secret, and this is a public OAuth client by design):
//
{{- if eq .Platform "vite-spa"}}
//   VITE_OIDC_ISSUER       https://your-tenant.example.com/oidc
//   VITE_OIDC_CLIENT_ID    the client/application id from your IdP
//   VITE_OIDC_REDIRECT_URI optional; defaults to <origin>/auth/callback
//   VITE_OIDC_SCOPES       optional; defaults to "openid profile email offline_access"
{{- else}}
//   NEXT_PUBLIC_OIDC_ISSUER       https://your-tenant.example.com/oidc
//   NEXT_PUBLIC_OIDC_CLIENT_ID    the client/application id from your IdP
//   NEXT_PUBLIC_OIDC_REDIRECT_URI optional; defaults to <origin>/auth/callback
//   NEXT_PUBLIC_OIDC_SCOPES       optional; defaults to "openid profile email offline_access"
{{- end}}
//
// Everything else — the authorization endpoint, the token endpoint, the
// sign-out endpoint — is read from the issuer's OIDC discovery document, so
// nothing in this file names a provider. Auth0, Clerk, Keycloak, Zitadel,
// Okta and Logto all work by changing the issuer and client id, with no code
// change. Register `<origin>/auth/callback` as an allowed redirect URI with
// whichever one you use.

import {
  buildAuthorizeUrl,
  createState,
  createVerifier,
  discover,
  exchangeCode,
  OAuthError,
  refreshToken as redeemRefreshToken,
  statesMatch,
  type ProviderMetadata,
} from "./oidc";
import {
  accessTokenExpiresWithin,
  clearSession,
  getAccessToken,
  getIdToken,
  getRefreshToken,
  onSessionChange,
  setSession,
  storePendingLogin,
  takePendingLogin,
  updateSessionTokens,
} from "./oidc-storage";
import { createSessionAuthProvider } from "./session-provider";

import type { AuthProvider, AuthUser } from "./provider";

{{if eq .Platform "vite-spa"}}const env = {
  issuer: import.meta.env.VITE_OIDC_ISSUER as string | undefined,
  clientId: import.meta.env.VITE_OIDC_CLIENT_ID as string | undefined,
  redirectUri: import.meta.env.VITE_OIDC_REDIRECT_URI as string | undefined,
  scopes: import.meta.env.VITE_OIDC_SCOPES as string | undefined,
  mockMode: import.meta.env.VITE_MOCK_API as string | undefined,
};{{else}}const env = {
  issuer: process.env.NEXT_PUBLIC_OIDC_ISSUER,
  clientId: process.env.NEXT_PUBLIC_OIDC_CLIENT_ID,
  redirectUri: process.env.NEXT_PUBLIC_OIDC_REDIRECT_URI,
  scopes: process.env.NEXT_PUBLIC_OIDC_SCOPES,
  mockMode: process.env.NEXT_PUBLIC_MOCK_API,
};{{end}}

/**
 * How early to refresh, in milliseconds before the access token expires.
 *
 * Refreshing AT the boundary races it: a token with 200ms of life left passes
 * an `expired?` check, gets attached to a request, and 401s in flight — having
 * been spent on a request that was already doomed. 30 seconds comfortably
 * covers a slow request plus clock skew between this browser and the IdP,
 * without materially shortening the token's useful life.
 */
export const REFRESH_SKEW_MS = 30_000;

/** The path this app serves its OAuth callback on. */
export const CALLBACK_PATH = "/auth/callback";

/** The path this app serves its sign-in page on. */
export const SIGN_IN_PATH = "/auth/sign-in";

/** Resolved, validated OIDC configuration. */
export interface OidcConfig {
  issuer: string;
  clientId: string;
  redirectUri: string;
  scopes: string[];
}

/**
 * Reads OIDC config from the environment, or returns null when this app has
 * no IdP configured.
 *
 * Null is a legitimate, supported state — it is what a project has before
 * anyone wires an IdP, and what a pure-mock frontend has forever. It is NOT
 * an error, which is why this returns null rather than throwing;
 * `selectAuthProvider()` treats it as "use the mock".
 *
 * A PARTIAL configuration is a different thing entirely and does throw: an
 * issuer with no client id is someone halfway through setup, and silently
 * falling back to the mock there produces a fake session against a real
 * backend — the single most confusing state this file could put you in.
 */
export function readOidcConfig(): OidcConfig | null {
  const issuer = env.issuer?.trim() ?? "";
  const clientId = env.clientId?.trim() ?? "";

  if (!issuer && !clientId) {
    return null;
  }
  if (!issuer || !clientId) {
    const missing = !issuer ? "issuer" : "client id";
    throw new Error(
      `auth: OIDC is half-configured — the ${missing} is missing. Set both ` +
{{- if eq .Platform "vite-spa"}}
        "VITE_OIDC_ISSUER and VITE_OIDC_CLIENT_ID, or neither (which selects " +
{{- else}}
        "NEXT_PUBLIC_OIDC_ISSUER and NEXT_PUBLIC_OIDC_CLIENT_ID, or neither (which selects " +
{{- end}}
        "the mock provider for UI-only development).",
    );
  }

  const origin =
    typeof window === "undefined" ? "" : window.location.origin;
  return {
    issuer,
    clientId,
    redirectUri: env.redirectUri?.trim() || `${origin}${CALLBACK_PATH}`,
    // offline_access is in the DEFAULT because without it the access token
    // expires after its hour and the session ends mid-task — see promptFor()
    // for why the scope alone is not sufficient, and the backend's
    // `oidc_scopes` config for the matching default on that side.
    scopes: (env.scopes?.trim() || "openid profile email offline_access").split(
      /\s+/,
    ),
  };
}

/**
 * Extra authorization parameters implied by the requested scopes.
 *
 * ── Why asking for offline_access is not enough ───────────────────────
 *
 * OIDC Core §11 says an authorization server MUST IGNORE `offline_access`
 * unless the `prompt` parameter contains `consent`. Providers implement this
 * literally, and they do it SILENTLY: you ask for `offline_access`, the
 * authorization succeeds, and the token response simply arrives with no
 * `refresh_token` and a granted `scope` that quietly dropped it. Nothing
 * errors. The session then dies an hour later with no clue as to why.
 *
 * Verified against Logto 1.41.0 (whose embedded oidc-provider does exactly
 * this): with `openid profile email offline_access` and no prompt, the token
 * response carried NO refresh token and the granted scope came back as
 * `openid profile email`. Adding `prompt=consent` produced the refresh token.
 *
 * So the prompt is DERIVED from the scopes here rather than being a second
 * setting a user must know to turn on. Requesting offline_access without the
 * prompt is never what someone means; it is the shape of a bug.
 *
 * The cost is that a provider may show a consent screen on first sign-in.
 * That is the spec's intent — a refresh token is long-lived access granted on
 * the user's behalf while they are away — and providers generally remember the
 * grant, so it is a one-time interstitial rather than a per-login prompt.
 */
export function promptFor(
  scopes: string[],
): Record<string, string> | undefined {
  if (!scopes.includes("offline_access")) {
    return undefined;
  }
  return { prompt: "consent" };
}

/**
 * Derives the UI's user from the id token's claims.
 *
 * This is presentation only, and the distinction matters: these claims are
 * read WITHOUT signature verification, because the browser has no business
 * verifying a token it is merely displaying. Authorization is the backend's
 * job — it validates the same token's signature against the issuer's JWKS on
 * every RPC. Never gate anything that matters on a value derived here.
 */
function userFromIdToken(idToken: string | null): AuthUser | null {
  if (!idToken) {
    return null;
  }
  const parts = idToken.split(".");
  if (parts.length !== 3) {
    return null;
  }
  try {
    const payload = parts[1] ?? "";
    const padded = payload.padEnd(
      payload.length + ((4 - (payload.length % 4)) % 4),
      "=",
    );
    const json = atob(padded.replace(/-/g, "+").replace(/_/g, "/"));
    const claims = JSON.parse(json) as Record<string, unknown>;
    const sub = typeof claims["sub"] === "string" ? claims["sub"] : "";
    if (!sub) {
      return null;
    }
    return {
      id: sub,
      email: typeof claims["email"] === "string" ? claims["email"] : undefined,
      name:
        typeof claims["name"] === "string"
          ? claims["name"]
          : typeof claims["preferred_username"] === "string"
            ? claims["preferred_username"]
            : undefined,
    };
  } catch {
    return null;
  }
}

// ═══════════════════════════════════════════════════════════════════════
//  WHAT HAPPENS WHEN A REFRESH FAILS — your decision, and the tradeoff
// ═══════════════════════════════════════════════════════════════════════
//
// A refresh can fail for reasons no retry can fix: the refresh token expired,
// an admin revoked the session, or the provider rotated it and something
// presented a stale copy. At that moment the app knows the user is no longer
// authenticated. What it should DO about it is an APPLICATION POLICY question,
// not a mechanism question, which is why it lives in this user-owned file
// instead of inside a forge library.
//
// ── What forge chose: EMIT SIGNED-OUT, DO NOT REDIRECT ────────────────
//
// The default below clears the session, notifies `onAuthStateChange`
// subscribers (so `useAuth()` re-renders as signed out and any RouteGuard on a
// protected route reacts), and logs a warning. It does NOT navigate.
//
// The tradeoff, stated plainly:
//
//   COST: nothing visibly happens on a page with no guard. A user on a public
//   page may not learn they were signed out until their next action fails.
//
//   BENEFIT: an unprompted `window.location.assign` to the IdP DESTROYS
//   IN-FLIGHT WORK. The half-filled checkout form, the half-written comment,
//   the unsaved editor buffer — all gone, with no way to get them back and no
//   warning. That is a far worse outcome than a stale-looking header, and it
//   happens at the least predictable moment: an hour into a session, mid-task.
//
// Emitting a state is also RECOVERABLE by the app in a way a redirect is not:
// an app that wants the redirect can add it in three lines (below), whereas an
// app that wants to prompt cannot undo a navigation that already happened.
//
// ── If you want the redirect instead (kiosks, dashboards, internal tools) ──
//
// An app with no unsaved state — a wall display, a read-only dashboard — is
// better off bouncing straight through the IdP, which is usually silent because
// the IdP's own session cookie is still valid. Replace the body below with:
//
//     window.location.assign(SIGN_IN_PATH);
//
// ── If you want to prompt (apps with unsaved work) ────────────────────
//
// Surface it and let the user decide when to re-authenticate, so they can save
// first. Subscribe to `onAuthStateChange` in your layout and show a
// "your session expired — sign in again" banner whose button calls `login()`.
// `login()` captures the current path and returns the user to it afterwards.
//
/**
 * Called when a token refresh fails and the session has been cleared.
 *
 * Read the block above before changing this: the choice between notifying and
 * redirecting is a real tradeoff, and the redirect is the one that can lose a
 * user's work.
 */
function onRefreshFailed(cause: unknown): void {
  // Deliberately a warning rather than a thrown error: this runs inside
  // getToken(), which the Connect transport calls on every RPC. Throwing here
  // would turn "the session ended" into an unhandled rejection on an unrelated
  // request, reported far from its cause.
  console.warn(
    "auth: token refresh failed, so this session has been signed out. The " +
      "identity provider refused to renew it (expired, revoked, or already " +
      "rotated), and retrying cannot change that answer. Call login() to " +
      "start a new sign-in.",
    cause,
  );
}

/**
 * Builds the real provider.
 *
 * Discovery is memoised per provider instance, not per call: `login()` and
 * the callback both need endpoints, and re-fetching the document on each one
 * would add a round trip to every sign-in for a document that does not
 * change.
 */
export function createOidcAuthProvider(config: OidcConfig): AuthProvider {
  const listeners = new Set<(user: AuthUser | null) => void>();
  // Seeded from whatever session already exists. A provider constructed
  // AFTER completeLogin() ran — which is what happens when the callback
  // route mounts a fresh tree — must not report signed out.
  let current: AuthUser | null = userFromIdToken(getIdToken());
  let loading = false;
  let metadataPromise: Promise<ProviderMetadata> | null = null;

  const metadata = (): Promise<ProviderMetadata> => {
    metadataPromise ??= discover(config.issuer);
    return metadataPromise;
  };

  const emit = (next: AuthUser | null) => {
    current = next;
    for (const cb of listeners) cb(next);
  };

  // ── SINGLE-FLIGHT REFRESH ─────────────────────────────────────────────
  //
  // The in-flight refresh, or null. This one variable is the whole mechanism,
  // and it is the most important line in this file.
  //
  // Ten concurrent RPCs each call getToken(). Without this, ten refreshes go
  // out at once; against a provider that ROTATES (most of them), the first
  // consumes the refresh token and the other nine present one that has just
  // been invalidated. A provider with reuse detection reads nine replays of a
  // consumed token as token theft and revokes the ENTIRE grant — so the user
  // is signed out completely, by the very mechanism meant to keep them signed
  // in.
  //
  // Sharing one promise makes the second through tenth callers await the first
  // caller's request instead of starting their own. There is no lock and no
  // queue because JavaScript is single-threaded: the assignment below happens
  // before any caller can observe a gap.
  //
  // NOTE for anyone tempted to "improve" this: providers often allow a few
  // seconds' grace in which a consumed token is still accepted (Logto allows
  // 3), so REMOVING this will usually appear to work. It fails only when a
  // straggler lands after the window — under load, in production — and then it
  // fails by destroying the session rather than by erroring visibly.
  let refreshInFlight: Promise<string | null> | null = null;

  /**
   * Refreshes the access token, coalescing concurrent callers into one request.
   *
   * Returns the new access token, or null when there is nothing to refresh with
   * or the refresh failed.
   */
  const refreshAccessToken = (): Promise<string | null> => {
    // A caller that arrives while a refresh is in flight joins it.
    if (refreshInFlight) {
      return refreshInFlight;
    }

    const stored = getRefreshToken();
    if (!stored) {
      // No refresh token: nothing to do. This is NOT an error — it is an
      // anonymous visitor, or a provider/scope combination that issues none
      // (a refresh token requires `offline_access`, and OIDC Core §11 also
      // requires `prompt=consent`). The caller gets null and the transport
      // sends no Authorization header, so public RPCs keep working.
      return Promise.resolve(null);
    }

    refreshInFlight = (async () => {
      try {
        const meta = await metadata();
        const result = await redeemRefreshToken({
          endpoint: meta.tokenEndpoint,
          clientId: config.clientId,
          refreshToken: stored,
        });
        // ROTATION: result.refreshToken is what to present NEXT — the rotated
        // token when the provider sent one, otherwise the one just used. It is
        // stored unconditionally, in memory, replacing the old one.
        updateSessionTokens({
          accessToken: result.token.accessToken,
          refreshToken: result.refreshToken,
          idToken: result.token.idToken,
          expiresIn: result.token.expiresIn,
        });
        return result.token.accessToken;
      } catch (cause) {
        // ── FAIL CLOSED, AND HONESTLY ─────────────────────────────────
        //
        // The refresh failed, so this session cannot be renewed. The local
        // session is dropped rather than left in place: keeping a dead access
        // token would make every subsequent call retry a refresh the IdP has
        // already refused, and `isAuthenticated()` would keep claiming a
        // session that no longer exists.
        //
        // There is deliberately NO RETRY. A failed refresh is a provider
        // saying no — invalid_grant because the token was rotated away,
        // revoked, or expired — and retrying cannot change that answer. Worse,
        // against reuse detection a retry re-presents a consumed token, which
        // is the signal that revokes the whole grant.
        //
        // See onRefreshFailed below for the POLICY question (redirect vs.
        // notify) that this scaffold leaves to you.
        clearSession();
        emit(null);
        onRefreshFailed(cause);
        return null;
      } finally {
        // Cleared unconditionally so a failure cannot wedge the app into a
        // state where every future getToken() awaits a settled, failed promise
        // forever.
        refreshInFlight = null;
      }
    })();

    return refreshInFlight;
  };

  // The session is module-level state that `completeLogin()` writes without
  // going through this closure, so the provider LISTENS rather than being
  // notified by its caller. That is what makes the callback route's only
  // obligation "call completeLogin and navigate".
  onSessionChange(() => {
    emit(userFromIdToken(getIdToken()));
  });

  return {
    // Reads the CURRENT token on every call rather than caching one: the
    // transport asks per request, and a token that expired mid-session must
    // stop being offered. Returns null when signed out — which the
    // interceptor treats as "send no Authorization header", so anonymous
    // access to a public RPC keeps working.
    //
    // When the token is expired (or within REFRESH_SKEW_MS of it) and a refresh
    // token exists, this REFRESHES rather than returning null. That is the
    // difference between a session that survives past the access token's hour
    // and one that silently ends mid-task.
    getToken: async () => {
      if (accessTokenExpiresWithin(REFRESH_SKEW_MS) && getRefreshToken()) {
        return refreshAccessToken();
      }
      // Either still valid, or there is nothing to refresh with. getAccessToken
      // returns null for an expired token, which is the correct answer for an
      // anonymous caller and for a session whose provider issued no refresh
      // token.
      return getAccessToken();
    },
    getUser: () => current,
    isAuthenticated: () => getAccessToken() !== null,
    isLoading: () => loading,

    /**
     * Starts the redirect. Does not resolve in the normal case — the browser
     * navigates away — so callers must not sequence work after awaiting it.
     */
    login: async () => {
      loading = true;
      try {
        const meta = await metadata();
        const verifier = createVerifier();
        const state = createState();
        // Where to land after the round trip. Captured BEFORE the redirect
        // because it is the page the user was actually on; the callback URL
        // cannot know it.
        const returnTo =
          window.location.pathname === CALLBACK_PATH ||
          window.location.pathname === SIGN_IN_PATH
            ? "/"
            : `${window.location.pathname}${window.location.search}`;

        storePendingLogin({ verifier, state, returnTo });

        window.location.assign(
          buildAuthorizeUrl({
            endpoint: meta.authorizationEndpoint,
            clientId: config.clientId,
            redirectUri: config.redirectUri,
            scopes: config.scopes,
            state,
            challenge: await verifier.challenge(),
            // DERIVED from the scopes rather than configured separately, so
            // the two cannot drift apart. See promptFor().
            extra: promptFor(config.scopes),
          }),
        );
      } catch (err) {
        loading = false;
        throw err;
      }
    },

    /**
     * Clears the local session first, then asks the IdP to end its own.
     *
     * The order is deliberate: if the provider publishes no end-session
     * endpoint, or the redirect fails, this app is still signed out. The
     * reverse order can leave a browser holding a live token because a
     * navigation did not happen.
     */
    logout: async () => {
      const idToken = getIdToken();
      clearSession();
      emit(null);

      let endSession = "";
      try {
        endSession = (await metadata()).endSessionEndpoint;
      } catch {
        // Discovery failing must not strand the user in a half-signed-out
        // state — local sign-out has already happened.
        return;
      }
      if (!endSession) {
        // Not every provider has one. Local sign-out is the whole of what
        // this app can do, and it is already done.
        return;
      }
      const url = new URL(endSession);
      url.searchParams.set(
        "post_logout_redirect_uri",
        window.location.origin,
      );
      if (idToken) {
        // RFC 7009-adjacent: OIDC RP-Initiated Logout asks for the id token
        // as a hint so the provider knows WHICH session to end.
        url.searchParams.set("id_token_hint", idToken);
      }
      window.location.assign(url.toString());
    },

    onAuthStateChange: (cb) => {
      listeners.add(cb);
      return () => {
        listeners.delete(cb);
      };
    },
  };
}

/**
 * Runs the callback leg using configuration read from the environment. This
 * is the one function the callback ROUTE needs, in either framework.
 *
 * Discovery happens here rather than being handed in, so the route component
 * stays free of OIDC plumbing: it reads `window.location.search`, calls this,
 * and navigates to what comes back.
 */
export async function handleAuthCallback(search: string): Promise<string> {
  const config = readOidcConfig();
  if (!config) {
    throw new Error(
      "auth: this app has no IdP configured, so an OAuth callback cannot be " +
        "completed. Set the OIDC issuer and client id — see the header of " +
        "src/lib/auth/oidc-provider.ts.",
    );
  }
  const meta = await discover(config.issuer);
  return completeLogin(config, meta, search);
}

/**
 * Completes the callback leg: verify state, redeem the code, store the
 * session. Returns the path to land on.
 *
 * A FREE FUNCTION rather than a method on AuthProvider, on purpose. The
 * existing AuthProvider interface is what every consumer in the app is
 * written against — the Connect transport bridge, `useAuth()`, SessionNav,
 * the runtime's RouteGuard — and the callback is needed by exactly one route
 * component. Widening a six-consumer interface to serve one caller would
 * make every other implementation (starting with the mock) carry a method it
 * has no use for. So: the interface is unchanged, and the callback route
 * imports this directly.
 *
 * The order of checks is the security-relevant part and is the same order
 * forge/pkg/oauth2 uses:
 *
 *   1. an `error` in the query is surfaced immediately — the IdP is telling
 *      us the flow failed, and there is no code to redeem;
 *   2. state is compared BEFORE the code is touched, because a code arriving
 *      with the wrong state is a forged callback and must not be exchanged;
 *   3. only then is the verifier taken and the code redeemed.
 */
export async function completeLogin(
  config: OidcConfig,
  meta: ProviderMetadata,
  search: string,
): Promise<string> {
  const params = new URLSearchParams(search);

  // 1. The IdP reported a failure instead of issuing a code (RFC 6749
  //    §4.1.2.1): access_denied when the user declined, invalid_scope when
  //    the client asks for something it may not have, and so on.
  const error = params.get("error");
  if (error) {
    throw new OAuthError({
      code: error,
      description: params.get("error_description") ?? "",
      uri: params.get("error_uri") ?? "",
    });
  }

  const code = params.get("code");
  const returnedState = params.get("state");

  // 2. CSRF check first. takePendingLogin() also DELETES the stored values,
  //    so a replayed callback finds nothing on its second visit.
  const pending = takePendingLogin();
  if (!pending) {
    throw new Error(
      "auth: no sign-in is pending in this browser, so this callback cannot " +
        "be completed. This happens when the callback URL is reloaded, " +
        "opened in a different tab from the one that started sign-in, or " +
        "bookmarked. Start sign-in again.",
    );
  }
  if (!statesMatch(pending.state, returnedState ?? "")) {
    throw new Error(
      "auth: the state returned by the identity provider does not match the " +
        "state this browser sent. Treating this as CSRF and abandoning the " +
        "sign-in without redeeming the code.",
    );
  }

  if (!code) {
    throw new Error(
      "auth: the identity provider's callback carried neither a code nor an " +
        "error. Check that the client is configured for the authorization " +
        "code flow (response_type=code) rather than an implicit flow.",
    );
  }

  // 3. State is proven; redeem.
  const token = await exchangeCode({
    endpoint: meta.tokenEndpoint,
    clientId: config.clientId,
    redirectUri: config.redirectUri,
    code,
    verifier: pending.verifier,
  });

  setSession({
    accessToken: token.accessToken,
    refreshToken: token.refreshToken,
    idToken: token.idToken,
    expiresIn: token.expiresIn,
  });

  return pending.returnTo;
}

/**
 * Selects the provider this app runs on. THIS is the mock-vs-real switch.
 *
 *   - pure mock (MOCK_API=true) → the mock provider, always. Every RPC is
 *     answered locally, so there is no server to authenticate to and no
 *     point redirecting to an IdP. This is what keeps UI-only development
 *     working with no IdP in the loop.
 *   - OIDC configured             → the real provider.
 *   - neither                     → the mock provider, signed out, which
 *     warns on first use that it is driving a real backend with no
 *     credential.
 *
 * Deliberately NOT a "use real auth" boolean flag. The provider is chosen by
 * what the app was actually GIVEN, so there is no state where the app claims
 * to do real auth without the configuration to do it.
 */
export function selectAuthProvider(): AuthProvider {
  if (env.mockMode === "true") {
    return createSessionAuthProvider();
  }
  const config = readOidcConfig();
  if (!config) {
    return createSessionAuthProvider();
  }
  return createOidcAuthProvider(config);
}

/** True when this app has an IdP configured — the sign-in page reads it. */
export function isOidcConfigured(): boolean {
  return readOidcConfig() !== null;
}
