{{if eq .Platform "nextjs"}}"use client";

{{end}}// yours: scaffolded once, never touched again — forge will not overwrite this file
{{- if eq .Platform "react-native"}}
//
// The app's auth state.
//
// ── Two providers, chosen once at mount ───────────────────────────────
//
// The browser frontends sign in NATIVELY: they POST credentials to the
// app's own API, the server runs the whole OIDC flow against the identity
// provider, and the answer comes back as an HttpOnly session cookie. React
// Native has neither half of what makes that work — no automatic cookie
// jar on fetch, and no same-origin — so a native app is an OAuth public
// client instead: system-browser sign-in (authorization code + PKCE),
// tokens in the OS keystore, a bearer token on every request.
//
//   EXPO_PUBLIC_FORGE_OIDC_* set     → the OIDC provider (./native). forge
//                                      delivers these when the project has
//                                      native sign-in; see ./config.
//   not set                          → the MOCK session provider, exactly as
//                                      before: no sign-in screen, no token.
//   set but INVALID                  → NEITHER. The app stays signed out and
//                                      `configError` carries the reason: a
//                                      typo must be loud, never a silent
//                                      fallback to a mock identity.
//
// Swap the IdP by implementing AuthProvider (./provider) and constructing it
// in `chooseAuth` below; nothing else in the app changes.
//
// ── The context value is the same on every platform ───────────────────
//
// Deliberately: a component written against `useAuth()` moves between the
// mobile and browser trees unchanged. What it exposes is an IDENTITY — who
// is signed in, for rendering — and never a token. Use it to decide what to
// SHOW. Never to decide what is ALLOWED: the server validates the real
// credential on every request, and a caller who edits anything here changes
// the UI and nothing else.
{{- else}}
//
// The app's auth state, read from THIS APP'S API.
//
// ── What changed, and why it is simpler than it used to be ────────────
//
// Sign-in is native: the browser POSTs credentials to this app's server,
// the server runs the whole OIDC flow against the identity provider, and
// the answer comes back as an HttpOnly session cookie. See
// src/lib/auth/native-login.ts and internal/app/login_broker.go.
//
// So there is no OIDC provider object in the browser to hold state for, no
// token to keep in memory, no refresh timer, and no silent-restore dance.
// There is one question — "who is signed in?" — and one way to answer it:
// ask the server.
//
// ── The token is deliberately unreachable ─────────────────────────────
//
// The session cookie is HttpOnly, so nothing here can read it. That is the
// property the design exists for: a token no script can reach is a token
// an XSS cannot steal. The cookie is attached automatically to same-origin
// requests, so no code has to set an Authorization header.
//
// What this context exposes is an IDENTITY — who is signed in, for
// rendering. Use it to decide what to SHOW. Never to decide what is
// ALLOWED: the server validates the real token on every request, and a
// caller who edits anything here changes the UI and nothing else.
//
// ── Mock mode is the one exception ────────────────────────────────────
//
// With MOCK_API set ("true" or "hybrid") the identity is the FIXTURE user
// from ./session-provider, and GET /auth/session is never sent. Pure mock
// has no server to ask: the request failed, the context read signed-out,
// and the route guard bounced every page to a sign-in form that posts to a
// server that is not there.
//
// Hybrid renders the same fixture user, and that is a statement about the
// UI ONLY. Nothing here becomes a credential — the fixture token is handed
// out in pure mock alone, where only the mock transport sees it. A
// forwarded hybrid RPC carries whatever real session cookie the browser
// already holds and nothing more, so an identity-gated RPC that no
// scenario stubs still answers 401 until you sign in to the real server at
// /auth/sign-in (that form still posts to it).
{{- end}}
//
// ── This file exports one component ───────────────────────────────────
//
// The context object and useAuth() live in ./use-auth, so React Fast Refresh
// can hot-swap this provider when you edit it. Import the hook from there.

{{if eq .Platform "react-native"}}import {
  useCallback,
  useContext,
  useEffect,
  useLayoutEffect,
  useRef,
  useState,
  type ReactNode,
} from "react";{{else}}import { useCallback, useContext, useEffect, useRef, useState, type ReactNode } from "react";{{end}}

import { EventBusContext } from "../use-event";

{{if eq .Platform "react-native"}}// React Native does not share the web's cookie model — there is no cookie
// jar on fetch by default and no same-origin to be same as — so the web's
// native-login flow does not apply here (it would typecheck, since RN's
// tsconfig includes the DOM lib, and silently never authenticate).
import { useQueryClient } from "@tanstack/react-query";

import { setAuthTokenGetter, setTokenRejectedHandler } from "../connect";
import { OidcConfigError, readOidcConfig, type OidcConfig } from "./config";
import { createNativeAuthProvider } from "./native";
import type { AuthProvider, AuthUser } from "./provider";
import { endSession } from "./session";
import { createSessionAuthProvider } from "./session-provider";
import { AuthContext, type AuthContextValue, type Identity } from "./use-auth";

type Auth =
  | { kind: "oidc"; provider: AuthProvider; config: OidcConfig }
  | { kind: "mock"; provider: AuthProvider }
  | { kind: "invalid"; error: Error };

// Decided once, at mount: the configuration is baked into the bundle.
function chooseAuth(onSessionEnded: (reason: string) => void): Auth {
  let config: OidcConfig | null;
  try {
    config = readOidcConfig();
  } catch (e) {
    const error =
      e instanceof Error ? e : new OidcConfigError("EXPO_PUBLIC_FORGE_OIDC_*", String(e));
    console.error(
      `[auth] native sign-in is misconfigured and the app will stay signed out: ${error.message}`,
    );
    return { kind: "invalid", error };
  }
  if (config) {
    return { kind: "oidc", config, provider: createNativeAuthProvider(config, { onSessionEnded }) };
  }
  return { kind: "mock", provider: createSessionAuthProvider() };
}

const SIGNED_OUT: Identity = { authenticated: false };

function toIdentity(user: AuthUser | null): Identity {
  return user
    ? { authenticated: true, email: user.email, name: user.name, subject: user.id }
    : SIGNED_OUT;
}{{else}}import { fetchIdentity, signOut as apiSignOut, type Identity } from "./native-login";
import { createSessionAuthProvider, isMockMode } from "./session-provider";
import { AuthContext, type AuthContextValue } from "./use-auth";{{end}}

export function AuthContextProvider({ children }: { children: ReactNode }) {
  const [identity, setIdentity] = useState<Identity>({ authenticated: false });
  const [isLoading, setIsLoading] = useState(true);

{{- if eq .Platform "react-native"}}
  const queryClient = useQueryClient();
  // The provider's own "your session ended" signal (a refresh token the IdP
  // no longer honours, a different account signing in). The provider is built
  // once, so it fans out to whatever listener the effect below has registered.
  const [endedListeners] = useState(() => new Set<(reason: string) => void>());
  // Held in state so it is constructed ONCE. Building it in the render body
  // makes a fresh provider on every render, and the callbacks below close
  // over whichever one they were created with — so a logout would move a
  // session object that nothing subsequently reads.
  const [auth] = useState(() => chooseAuth((reason) => endedListeners.forEach((fn) => fn(reason))));
  const provider = auth.kind === "invalid" ? null : auth.provider;
  const configError = auth.kind === "invalid" ? auth.error : null;
  const requiresSignIn = auth.kind !== "mock";

  // Who is signed in right now, readable from async code without a stale
  // closure. Only commitIdentity writes it, alongside the state.
  const identityRef = useRef<Identity>(SIGNED_OUT);
  const commitIdentity = useCallback((next: Identity) => {
    identityRef.current = next;
    setIdentity(next);
  }, []);
  const ending = useRef<Promise<void> | null>(null);
  // Ends the previous account's session: epoch bump → abort in-flight →
  // cancel queries → clear the React Query cache. Callers that overlap share
  // one run.
  const endOldSession = useCallback((): Promise<void> => {
    ending.current ??= endSession(queryClient).finally(() => {
      ending.current = null;
    });
    return ending.current;
  }, [queryClient]);
  // The ONE place a user becomes the app's identity. A different `sub` than
  // the one on screen ends the old session first, so nothing of the previous
  // account is in the cache when the new one's screens mount.
  const applyUser = useCallback(
    async (user: AuthUser | null) => {
      const previous = identityRef.current.subject;
      if (previous && user && previous !== user.id) await endOldSession();
      commitIdentity(toIdentity(user));
    },
    [endOldSession, commitIdentity],
  );
{{- else}}
  // The fixture session, in mock mode only — see "Mock mode is the one
  // exception" above. Decided once, at mount: the mode is runtime config,
  // and it does not change under a running page. Held in state for the same
  // reason the React Native tree holds its provider there — a logout must
  // move the one session the callbacks below read.
  const [mockSession] = useState(() => (isMockMode() ? createSessionAuthProvider() : null));
{{- end}}
  const refresh = useCallback(async () => {
{{- if eq .Platform "react-native"}}
    if (!provider) {
      commitIdentity(SIGNED_OUT);
      setIsLoading(false);
      return;
    }
    if (auth.kind === "oidc") {
      // Re-ask the provider: getToken() renews an expired token, and a grant
      // the IdP revoked ends the session (-> sessionEnded -> signed out). An
      // offline failure keeps the session as it is.
      try {
        await provider.getToken();
      } catch {
        // Transient; the identity below is still the last known one.
      }
    }
    await applyUser(provider.getUser());
    setIsLoading(false);
  }, [auth, provider, applyUser, commitIdentity]);
{{- else}}
    if (mockSession) {
      const user = mockSession.getUser();
      setIdentity({
        authenticated: user !== null,
        email: user?.email,
        name: user?.name,
        subject: user?.id,
      });
    } else {
      setIdentity(await fetchIdentity());
    }
    setIsLoading(false);
  }, [mockSession]);
{{- end}}

{{- if eq .Platform "react-native"}}
  // Mock: reads the fixture session once. OIDC: restores the session an
  // earlier launch left in the keystore (renewing it when it lapsed) while
  // `isLoading` is true, so a signed-in user never flashes the sign-in screen.
{{- else}}
  // ONE request on mount, to this app's own origin — none in mock mode.
  // Compare with what this replaced: a discovery fetch, an authorize
  // redirect, and a hidden iframe that sat on a five-second timeout whenever
  // there was no session to restore.
{{- end}}
  //
  // Awaited inside an async IIFE rather than called bare. `refresh` sets
  // state, and an effect body that updates state synchronously forces a
  // second render pass before the browser paints. Awaiting first moves both
  // setState calls into a continuation — the effect body itself only starts
  // the work, which is what an effect is for.
{{- if eq .Platform "react-native"}}
  useEffect(() => {
    let cancelled = false;
    void (async () => {
      if (auth.kind === "oidc" && auth.provider.restore) {
        try {
          const user = await auth.provider.restore();
          if (!cancelled) await applyUser(user);
        } catch (e) {
          // Keystore unavailable or unreadable: signed out. signIn() will hit
          // the same error and the sign-in screen names it.
          console.warn("[auth] could not restore the saved session:", e);
          if (!cancelled) commitIdentity(SIGNED_OUT);
        }
        if (!cancelled) setIsLoading(false);
        return;
      }
      await refresh();
    })();
    return () => {
      cancelled = true;
    };
  }, [auth, refresh, applyUser, commitIdentity]);

  // Bridge the transport to the provider: every request asks it for the
  // current token (renewed when due), and a 401 asks it to renew once more
  // before the transport replays the request. Layout effect, so it is in
  // place before any child's effect can fire a query. Mock mode wires
  // nothing: its fixture token is accepted by no server, so the scaffold
  // sends no Authorization header rather than one that is sure to be refused.
  useLayoutEffect(() => {
    if (auth.kind !== "oidc") return;
    const { provider: p } = auth;
    setAuthTokenGetter(() => p.getToken());
    setTokenRejectedHandler(p.onTokenRejected ? (token) => p.onTokenRejected!(token) : null);
    return () => {
      setAuthTokenGetter(async () => null);
      setTokenRejectedHandler(null);
    };
  }, [auth]);

  // The provider ended the session without being asked (invalid_grant, an
  // expired token with no refresh token) or switched accounts: clear the old
  // account's cache, and show signed-out unless a new account is arriving.
  useEffect(() => {
    const onEnded = (reason: string) => {
      void (async () => {
        await endOldSession();
        if (reason !== "account_changed") commitIdentity(SIGNED_OUT);
      })();
    };
    endedListeners.add(onEnded);
    return () => {
      endedListeners.delete(onEnded);
    };
  }, [endedListeners, endOldSession, commitIdentity]);
{{- else}}
  useEffect(() => {
    void (async () => {
      await refresh();
    })();
  }, [refresh]);
{{- end}}

  // A session can lapse mid-use: the cookie expires, or the server revokes it.
  // The transport emits `auth:expired` when an RPC fails Unauthenticated (HTTP
  // 401; see src/lib/connect.ts). Re-ask the server who is signed in rather
  // than trusting the one failure: when the session really is gone, identity
  // flips to signed-out and RouteGuard sends the user to sign-in with a
  // returnTo; when it is not (one rpc's own auth rule), nothing changes. A
  // burst of failing queries shares one check.
  const bus = useContext(EventBusContext);
  const expiryCheck = useRef<Promise<void> | null>(null);
  useEffect(() => {
    if (!bus) return;
    return bus.on("auth:expired", () => {
      expiryCheck.current ??= refresh().finally(() => {
        expiryCheck.current = null;
      });
    });
  }, [bus, refresh]);

  const logout = useCallback(async () => {
{{- if eq .Platform "react-native"}}
    // Cache first: stop everything from the account that is leaving, then
    // revoke and wipe. The identity flips even if the keystore wipe throws —
    // the in-memory session is already gone.
    await endOldSession();
    try {
      await provider?.logout();
    } finally {
      commitIdentity(SIGNED_OUT);
    }
  }, [provider, endOldSession, commitIdentity]);

  const signIn = useCallback(async (): Promise<AuthUser | null> => {
    if (auth.kind === "invalid") throw auth.error;
    if (auth.kind === "mock" || !auth.provider.signIn) {
      // Nothing to sign in to: re-read whoever the provider already is.
      await refresh();
      return auth.provider.getUser();
    }
    const user = await auth.provider.signIn();
    if (user) await applyUser(user);
    return user;
  }, [auth, refresh, applyUser]);
{{- else}}
    if (mockSession) {
      // Ends the FIXTURE session, locally, so a signed-out state can be
      // built against. There is no server session to end in pure mock, and
      // in hybrid the fixture was never what the server saw. A reload
      // restores it.
      await mockSession.logout();
      setIdentity({ authenticated: false });
      return;
    }
    setIdentity(await apiSignOut());
  }, [mockSession]);
{{- end}}

  const value: AuthContextValue = {
    identity,
    isAuthenticated: identity.authenticated,
    isLoading,
    refresh,
    logout,
{{- if eq .Platform "react-native"}}
    requiresSignIn,
    configError,
    signIn,
{{- end}}
  };

  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
}
