# dependencies
node_modules/

# build output
dist/
build/

# ── Generated code (regenerated by buf generate / forge generate) ──
# Proto TypeScript client code
src/gen/
# Pre-`_gen` per-service React Query hooks, from a tree generated before
# forge renamed the emitter's output. Nothing writes these names anymore;
# the rule stays so an un-upgraded checkout still ignores its leftovers.
# The current `<svc>-hooks_gen.ts` files and the `index.ts` barrel are
# committed like every other Tier-1 output — `forge ci verify-generated`
# diffs a fresh generate against the checkout and cannot see an ignored
# file. Do NOT widen this to `src/hooks/*_gen.ts` or `src/lib/*_gen.ts`:
# apiurl_gen.ts and config_gen.ts are forge-emitted but ARE committed.
src/hooks/*-hooks.ts
# Generated route tree (declarative file-based router output, if used)
src/routes/routeTree.gen.ts

