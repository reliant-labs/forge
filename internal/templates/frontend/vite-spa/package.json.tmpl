{
  "name": "{{.FrontendName}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "// vite range note": "devDependencies.vite admits 7 deliberately. Everything this scaffold pairs vite with already resolves 7 — @tailwindcss/vite and @vitejs/plugin-react declare it as their peer, and vitest 3 depends on it directly. Pinning ^6 alone did not keep vite 7 out; it only guaranteed a SECOND copy beside it, and in a project that also has a Next.js frontend npm hoisted 7 to the root and nested 6 under this frontend. Two copies of vite are two copies of its TYPES, so `tsc --noEmit` failed vite.config.ts with TS2769 'Plugin<any> is not assignable to PluginOption' — the plugins came from one copy and defineConfig from the other. This note sits at the TOP LEVEL because npm rejects a comment key inside devDependencies with EINVALIDPACKAGENAME.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.5.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-web": "^2.0.0",
    "@hookform/resolvers": "^3.9.0",
    "@opentelemetry/api": "^1.9.0",
    "@reliantlabs/forge-web-runtime": "^0.2.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-router": "^1.84.0",
{{- if .Workspaces}}
    "{{.APIPackage}}": "workspace:*",
    "{{.HooksPackage}}": "workspace:*",
    "{{.UIWebPackage}}": "workspace:*",
{{- end}}
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.53.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.5.0",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/router-devtools": "^1.84.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.25.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.0.0 || ^7.0.0",
    "vitest": "^3.1.0"
  }
}
