// yours: scaffolded once, never touched again — forge will not overwrite this file
//
// Tanstack-router setup for the {{.FrontendName}} SPA. Forge writes this
// file once at scaffold time and never overwrites it. New routes added by
// `forge scaffold page <Entity>` are appended in the marker block below.
//
// Routing model
// -------------
// We use the code-based router (createRootRoute / createRoute / addChildren)
// rather than file-based routing. The code-based form keeps the route tree
// inspectable in one place and lets the page generator stitch new entity
// routes into the same array without touching anything else.
//
// Common edits:
//   - Replace <App /> with your own root layout
//   - Add static routes (login, settings) above the FORGE-ROUTES marker
//   - Filter or reorder ALL_ROUTES in the marker block
//
// Conventions
//   - Search-param validation lives on the route via `validateSearch: schema`.
//     Read it inside the component with `useSearch({ from: '/<route-id>' })`.
//   - Path params: `parseParams: z.object({...}).parse` on the route.

import {
  createRootRoute,
  createRoute,
  createRouter,
  Outlet,
  useRouterState,
} from "@tanstack/react-router";

import { AuthCallbackScreen, SignInScreen } from "@/lib/auth/auth-screens";
import { useAuth } from "@/lib/auth/context";
import { RouteGuard } from "@/lib/auth/route-guard";

import App from "./App";

// Root route — renders the app shell (<App />) and an <Outlet /> for
// matched children.
//
// The shell is wrapped in the route guard, so an anonymous visitor is sent to
// the sign-in screen instead of getting a rendered page whose every RPC then
// answers 401. The guard is framework-agnostic and shared byte-for-byte with
// the Next.js scaffold (`@/lib/auth/route-guard`); this supplies the TanStack
// Router bindings for "what path are we on" and "how do I navigate". It is a
// no-op when no identity provider is configured — see that file, and edit it
// (or delete this wrapper) to change which routes are public.
export const rootRoute = createRootRoute({
  component: function RootShell() {
    const pathname = useRouterState({ select: (s) => s.location.pathname });
    return (
      <RouteGuard
        pathname={pathname}
        navigate={(path) => void router.navigate({ to: path, replace: true })}
      >
        <App>
          <Outlet />
        </App>
      </RouteGuard>
    );
  },
});

// Index route — the welcome / dashboard landing page. Replace with your own
// dashboard component once you have services with CRUD entities and have
// run `forge generate` to scaffold them.
const indexRoute = createRoute({
  getParentRoute: () => rootRoute,
  path: "/",
  component: function Index() {
    return (
      <div className="mx-auto max-w-3xl p-8">
        <h1 className="text-3xl font-bold tracking-tight text-ink">
          Welcome to {{.FrontendName}}
        </h1>
        <p className="mt-3 text-sm text-ink-muted">
          This is a Vite + React + tanstack-router scaffold generated by
          forge. Add a service with CRUD RPCs and run
          {" "}<code className="rounded bg-surface-muted px-1.5 py-0.5 font-mono text-xs text-ink">forge generate</code>{" "}
          to populate entity routes.
        </p>
      </div>
    );
  },
});

// ── Auth routes ────────────────────────────────────────────────────────
//
// The two screens the OIDC authorization-code flow needs. Both render
// components from `@/lib/auth/auth-screens`, which the Next.js scaffold
// shares byte-for-byte — only this navigation adapter differs.
//
// Delete both routes if your product is gated at the edge and never shows a
// sign-in page of its own. If you keep them, register
// `<origin>/auth/callback` as an allowed redirect URI with your IdP.
const signInRoute = createRoute({
  getParentRoute: () => rootRoute,
  path: "/auth/sign-in",
  component: function SignIn() {
    const { login, isAuthenticated } = useAuth();
    // Where the visitor was headed before the route guard sent them here.
    // Read from the raw query string rather than a typed search schema: the
    // guard is optional and this param may simply be absent.
    const returnTo =
      new URLSearchParams(window.location.search).get("returnTo") || "/";
    return (
      <SignInScreen
        login={login}
        isAuthenticated={isAuthenticated}
        returnTo={returnTo}
        // `replace`: the sign-in page is a waypoint, so Back should not
        // return a signed-in user to a page that bounces them forward.
        navigate={(path) => void router.navigate({ to: path, replace: true })}
      />
    );
  },
});

const authCallbackRoute = createRoute({
  getParentRoute: () => rootRoute,
  path: "/auth/callback",
  component: function AuthCallback() {
    return (
      <AuthCallbackScreen
        // Read straight off the URL rather than through validateSearch: the
        // provider's params (code/state, or error/error_description) are two
        // mutually exclusive shapes, and the screen has to report a malformed
        // callback as an error rather than have the router reject the
        // navigation before it can.
        search={window.location.search}
        // `replace`, so Back never returns to a URL holding a spent code.
        navigate={(path) => void router.navigate({ to: path, replace: true })}
      />
    );
  },
});

// ── FORGE-ROUTES: BEGIN (managed by `forge scaffold page` and `forge generate`) ──
// Entity routes are appended below this marker. Hand-editing inside this
// block is allowed, but `forge generate` may re-stitch entries — keep the
// markers intact.
//
// Format expected by the page generator: one `createRoute({...})` call
// per entity, assigned to a const, followed by an entry pushed onto
// `generatedRoutes`. Example:
//
//   const tasksListRoute = createRoute({
//     getParentRoute: () => rootRoute,
//     path: "/tasks",
//     component: lazy(() => import("@/pages/tasks/List")),
//   });
//   generatedRoutes.push(tasksListRoute);
//
// `unknown[]` keeps the array assignable without forcing every entry
// through a single concrete route generic — tanstack-router types each
// `createRoute` call against its own search/param shape, and a single
// homogenous element type would force every entity route into the same
// shape.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const generatedRoutes: any[] = [];
// ── FORGE-ROUTES: END ──

const routeTree = rootRoute.addChildren([
  indexRoute,
  signInRoute,
  authCallbackRoute,
  ...generatedRoutes,
]);

export const router = createRouter({ routeTree });

// Register router type for autocomplete and type-safe Link / navigate.
declare module "@tanstack/react-router" {
  interface Register {
    router: typeof router;
  }
}
