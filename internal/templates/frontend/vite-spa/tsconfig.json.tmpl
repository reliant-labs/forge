{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "useDefineForClassFields": true,
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
{{- if .Workspaces}}
      "@/components/ui/*": ["../../packages/ui-web/src/components/ui/*"],
{{- end}}
      "@connectrpc/connect": ["./node_modules/@connectrpc/connect"],
      "@bufbuild/protobuf": ["./node_modules/@bufbuild/protobuf"],
      "@opentelemetry/api": ["./node_modules/@opentelemetry/api"],
      "@/*": ["./src/*"]
    }
  },
  "// peer dedupe note": "The three @connectrpc/@bufbuild/@opentelemetry entries in paths pin @reliantlabs/forge-web-runtime's peerDependencies to THIS app's copy, mirroring `resolve.dedupe` in vite.config.ts. A dev build of forge bridges the runtime with a `file:` specifier, which npm materialises as a symlink into the forge checkout; that checkout carries its own node_modules, so the runtime's bare imports resolve there while this app's resolve here. The dedupe in vite.config.ts fixes the BUNDLE, but `tsc --noEmit` does not run Vite: typecheck saw two nominally-distinct copies of the same package and failed with TS2322 'Type Transport is not assignable to type Transport' in src/lib/mock-transport_gen.ts. Keep the list in step with vite.config.ts. This note sits at the top level, NOT inside compilerOptions, because tsc validates that object and rejects an unknown key there with TS5023.",
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
