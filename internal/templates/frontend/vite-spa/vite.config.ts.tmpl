import fs from "node:fs";
import path from "node:path";
import react from "@vitejs/plugin-react";
import tailwindcss from "@tailwindcss/vite";
// `vitest/config` re-exports vite's defineConfig with the `test` block typed.
// Importing it from "vite" instead type-errors on `test`, and this file is in
// the tsconfig `include` list.
import { defineConfig } from "vitest/config";

// The libraries @reliant-labs/web-runtime declares as peerDependencies —
// read from the installed package so this list can never drift from what the
// runtime actually asks the app to supply.
//
// peerDependencies states the contract: "the consuming app supplies this
// copy". npm honours it for a registry install (one hoisted copy at the app
// root) but CANNOT honour it for the `file:` specifier a dev build of forge
// writes to bridge a local forge checkout. That specifier is materialised as
// a SYMLINK, the checkout behind it is a working tree carrying its own
// node_modules, and a bundler resolves a module's bare imports by walking up
// from that module's own location — so the runtime binds @connectrpc/connect,
// @bufbuild/protobuf and @opentelemetry/api out of the forge checkout while
// this app binds its own. Two copies of every shared library in one bundle,
// each with its own classes, module-level state and registries, and every
// byte of them shipped twice. It typechecks and builds perfectly green, so no
// type-level or build-level gate can see it; `resolve.dedupe` below is what
// forces the single copy the contract promised.
const webRuntimePeers: string[] = Object.keys(
  JSON.parse(
    fs.readFileSync(
      path.join(
        __dirname,
        "node_modules",
        "@reliant-labs",
        "web-runtime",
        "package.json",
      ),
      "utf8",
    ),
  ).peerDependencies ?? {},
);

// Vite config for the SPA scaffold. Tailwind v4 plugin keeps the CSS
// pipeline first-party (no PostCSS config needed). The path aliases mirror
// the tsconfig "paths" entries so editor and runtime resolution agree.
export default defineConfig({
  plugins: [react(), tailwindcss()],
  resolve: {
    // Resolve every runtime peer from this project root, whatever the
    // importer. A registry install already resolves that way, so this is a
    // no-op there and a fix only where the dev bridge is live.
    dedupe: webRuntimePeers,
    alias: {
{{- if .Workspaces}}
      // In workspaces mode the shared component library lives at
      // packages/ui-web/. Redirect `@/components/ui/*` so existing imports
      // keep working without rewriting every page that consumes them.
      // Scoped to /ui/ so non-ui paths (e.g. the owned
      // `@/components/nav`) keep resolving against the local src tree.
      "@/components/ui": path.resolve(__dirname, "../../packages/ui-web/src/components/ui"),
{{- end}}
      "@": path.resolve(__dirname, "./src"),
    },
  },
  server: {
    port: 5173,
    host: true,
  },
  // Vitest reads THIS file when a project has no vitest.config.ts. The
  // scaffold ships component tests that mount into the DOM
  // (src/components/*.test.tsx, shared with the Next.js tree), so the jsdom
  // environment is not optional — without it `npm test` fails on arrival
  // with "document is not defined".
  test: {
    environment: "jsdom",
    include: ["src/**/*.{test,spec}.{ts,tsx}"],
  },
});
