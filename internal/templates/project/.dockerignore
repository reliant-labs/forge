.git
.github
# A local Go workspace can name host paths; the image builds from go.mod
# (the Dockerfile sets GOWORK=off). Kept out so `COPY . .` cannot reintroduce it.
go.work
go.work.sum
docs/
*.md
tmp/
.forge/
coverage.out
.golangci.yml
.gitattributes

# Air hot-reload build outputs
.air/
.air-debug/

# Local env files should not affect image builds.
.env
.env.*
!.env.example

# Build artifacts
bin/
dist/

# Test output
*.test
*.out

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Frontends live under frontends/<name>; Docker patterns without ** only
# match the context root. Exclude installs and outputs at every depth so a
# local frontend build cannot inflate or invalidate the backend image context.
**/node_modules/
**/.next/
**/.next-prod/
**/.turbo/
**/out/
**/dist/
**/coverage/
**/*.tsbuildinfo
