services:
  # The app's database as a CONTAINER — available, but NOT what the
  # scaffolded dev environment runs.
  #
  # `deploy/kcl/dev/main.k` declares postgres as a `forge.HostInfra`, so
  # `forge env up` starts a real postgres binary as a host process and never
  # touches this service. The reasoning is there, in the file that makes the
  # choice; the short version is that a dev loop whose own code runs on the
  # host should not require a container runtime underneath it, and on a small
  # cloud VM docker costs hundreds of megabytes before the project starts.
  #
  # To use this instead, change that one declaration:
  #
  #     deploy = forge.Compose {service = "postgres"}
  #
  # and set the DSN's port to match the one published below. Nothing else
  # changes; the app cannot tell the difference.
  postgres:
    image: postgres:17-alpine
    restart: unless-stopped
    mem_limit: 512m
    cpus: 0.5
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-{{.ProjectName}}}
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-postgres}
    ports:
      # Fixed, loopback-bound host port so the host-side dev loop
      # (`forge env up dev`, psql, DATABASE_URL) reaches postgres without
      # inspecting `docker compose ps` for a random mapping. Override
      # with POSTGRES_PORT if 5432 is taken.
      - "127.0.0.1:${POSTGRES_PORT:-5432}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres}"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - {{.ProjectName}}-net

  app:
    build:
      context: .
      target: dev
    restart: unless-stopped
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@postgres:5432/${POSTGRES_DB:-{{.ProjectName}}}?sslmode=disable
      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4317
      OTEL_SERVICE_NAME: {{.ProjectName}}
      ENVIRONMENT: development
      LOG_LEVEL: debug
      LOG_FORMAT: text
      AUTO_MIGRATE: "true"
      # pprof is on by default and bound to LOOPBACK by the config
      # default (127.0.0.1:6060). Loopback inside a container is the
      # container's own netns, so nothing outside it — not the `alloy`
      # profile scrape below, not a published port — can reach it. This
      # is the deliberate container-boundary override, and it is safe
      # because it is confined to this compose network: no port for it
      # is published to the host, and the k8s manifests give it no
      # Service. `docker compose exec app` or a published port of your
      # own is how you reach it by hand.
      PPROF_ADDR: "0.0.0.0:6060"
      # ── Identity (see the `idp` service below) ────────────────────────
      #
      # These are PASSTHROUGH with an empty default, and empty is the
      # CLOSED state, not an off switch: with no key material the
      # validator SetupAuth builds rejects every credential it is shown.
      # Nothing here decides WHETHER this server authenticates — that is
      # AuthDeps{AnonymousOK: false} plus the protos' auth_required
      # declarations, both in source. There is deliberately no
      # AUTH_ENABLED.
      #
      # Bringing the environment up writes both JWT_ISSUER and
      # JWT_JWKS_URL, and against the dev IdP they name the SAME origin
      # (http://localhost:${IDP_PORT}) — the one the browser uses. They
      # stay two fields because a real deployment can need them to
      # differ; here they do not, so discovery would work too.
      #
      # THIS CONTAINER is the exception, and it is why the dev loop for
      # a project with an IdP is `forge env up` (host processes) rather
      # than `docker compose up app`. Zitadel resolves WHICH instance a
      # request is for from the request's Host header, and the instance
      # only knows the domain it was configured with (`localhost`). A
      # fetch from inside this network to http://idp:8080 is answered
      # "Instance not found" — so an in-network JWKS URL does not work,
      # and no URL can carry the override. A host process reaches the
      # IdP at the same localhost URL the browser does, which is the
      # configuration forge writes.
      JWT_ISSUER: ${JWT_ISSUER-}
      JWT_JWKS_URL: ${JWT_JWKS_URL-}
      JWT_AUDIENCE: ${JWT_AUDIENCE-}
      OIDC_CLIENT_ID: ${OIDC_CLIENT_ID-}
      OIDC_REDIRECT_URI: ${OIDC_REDIRECT_URI-}
      OIDC_SCOPES: ${OIDC_SCOPES-}
    ports:
      - "0:8080"
      - "0:6060"
    volumes:
      - .:/app
      - go_mod_cache:/go/pkg/mod
      - go_build_cache:/root/.cache/go-build
    depends_on:
      postgres:
        condition: service_healthy
      otel-collector:
        condition: service_started
{{- if .HasFrontend}}
      # required: false is LOAD-BEARING, not politeness. It is what lets
      # `docker compose up app` start without waiting on the IdP — the app
      # does not need it to boot (its identity env is passthrough-empty
      # until the application is registered), and gating the app's start on
      # a second web server's 60s first-boot would slow every `up` for a
      # dependency it can tolerate arriving late.
      idp:
        condition: service_healthy
        required: false
{{- end}}
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:8080/healthz || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 15s
    networks:
      - {{.ProjectName}}-net

  app-debug:
    build:
      context: .
      target: debug
    restart: unless-stopped
    environment:
      DATABASE_URL: postgres://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD:-postgres}@postgres:5432/${POSTGRES_DB:-{{.ProjectName}}}?sslmode=disable
      OTEL_EXPORTER_OTLP_ENDPOINT: http://otel-collector:4317
      OTEL_SERVICE_NAME: {{.ProjectName}}
      ENVIRONMENT: development
    ports:
      - "0:8080"
      - "0:2345"
    security_opt:
      - "apparmor=unconfined"
    cap_add:
      - SYS_PTRACE
    depends_on:
      postgres:
        condition: service_healthy
      otel-collector:
        condition: service_started
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://localhost:8080/healthz || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 30s
    profiles:
      - debug
    networks:
      - {{.ProjectName}}-net

{{- if .HasFrontend}}
  # Zitadel — an OIDC identity provider, so a developer can complete a REAL
  # browser sign-in locally instead of hand-minting HS256 tokens.
  #
  # AVAILABLE, but NOT what the scaffolded dev environment runs — the same
  # status the `postgres` service above has.
  #
  # `deploy/kcl/dev/main.k` declares the IdP as a `forge.HostInfra` with
  # `engine = "zitadel"`, so `forge env up` downloads the pinned Zitadel binary
  # once and supervises it as a host process. That is what makes a
  # scaffolded project start ZERO containers: Zitadel is a single static Go
  # binary, and a dev loop whose own code runs on the host should not need a
  # container runtime for its dependencies either.
  #
  # To use this instead, change that one declaration:
  #
  #     deploy = forge.Compose {
  #         service = "idp"
  #         env = {"IDP_PORT": str(_idp_port)}
  #     }
  #
  # Everything else is unchanged — same steps file, same port, same
  # provisioning job — because all of it reads the same `_idp_port`.
  #
  # It is scaffolded HERE because this project declares a frontend. A
  # project with no browser (API-key auth, a worker, a CLI) never gets
  # this service written at all, so it never pays for a second web server
  # it would not call.
  #
  # The instance is DECLARED, not provisioned by hand. `idp-steps.yaml`
  # next to this file describes the instance, the organization, the admin
  # user and the service account, and Zitadel converges to it on first
  # boot — including writing the service account's personal access token to
  # ./.forge/idp/pat.txt.
  #
  # The app's identity env stays EMPTY by default rather than defaulting to
  # these URLs, and that is deliberate: a configured-but-unreachable JWKS
  # endpoint makes the server REFUSE TO START (pkg/auth fetches keys at
  # boot). The values are converged into deploy/kcl/dev/config.k once the
  # application is registered — see below. Empty means "no key material" —
  # closed, and bootable.
  #
  # One value CANNOT be declared: an OIDC client's `client_id` is generated
  # by the server when the application is registered, so the browser cannot
  # be told what to send until it exists. Zitadel's FirstInstance schema has
  # no Project/Application section, so there is nowhere in THIS file to put
  # it. forge converges it instead: bringing the environment up registers
  # the application over the IdP's own API (using the PAT above) and writes
  # the client id — plus the issuer/JWKS/audience both halves must agree on
  # — into the env's KCL config. It adopts an existing
  # registration rather than creating a second one, so it is a no-op once
  # correct — and bringing the environment up is the only thing that runs
  # it, so there is no second path to forget.
  #
  # Pinned MINOR.PATCH, never `latest`: an IdP that silently changes
  # version under a dev stack turns "login broke today" into an
  # archaeology exercise. Bump deliberately.
  idp:
    image: ghcr.io/zitadel/zitadel:v4.16.2
    restart: unless-stopped
    # Backed by `idp-db` below — a postgres container of the IdP's OWN,
    # NOT the app's database.
    #
    # It used to share the app's postgres in a separate `zitadel`
    # database, which was the right call when both were containers on one
    # compose network. They are not any more: the app's postgres runs as a
    # HOST PROCESS by default (see deploy/kcl/dev/main.k), and pointing a
    # container at it would mean reaching back out through the docker
    # host gateway — a different address on Linux than on macOS, on a port
    # that moves when the host port does. That is a lot of coupling to
    # save a container on the ONE service in this stack that is already a
    # container.
    #
    # The cost is ~256 MB and a second volume while the IdP is running.
    # The benefit is that the IdP's storage is entirely its own: it starts,
    # stops and resets without touching the app's database, and nothing
    # about where the app's postgres lives can break the sign-in loop.
    command:
      - start-from-init
      - --masterkey
      - ${IDP_MASTERKEY:-MasterkeyNeedsToHave32Characters}
      - --tlsMode
      - disabled
      - --steps
      - /steps.yaml
    environment:
      # `idp-db` is the compose service name below — an in-network address,
      # so no host port is involved and nothing here moves when the app's
      # postgres does.
      ZITADEL_DATABASE_POSTGRES_HOST: idp-db
      ZITADEL_DATABASE_POSTGRES_PORT: "5432"
      ZITADEL_DATABASE_POSTGRES_DATABASE: zitadel
      ZITADEL_DATABASE_POSTGRES_USER_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_USER_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE: disable
      ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD: postgres
      ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE: disable
      # Plain HTTP, because this is a local dev loop with no certificate.
      # Both are required: ExternalSecure alone still serves TLS.
      ZITADEL_EXTERNALSECURE: "false"
      ZITADEL_TLS_ENABLED: "false"
      # EXTERNALDOMAIN/EXTERNALPORT are the address the BROWSER uses, and
      # they are what Zitadel mints tokens under — the `iss` your server
      # then enforces. They are also how Zitadel decides which instance a
      # request is FOR: it matches the request's Host header against the
      # instance's registered domains and answers "Instance not found" to
      # anything else. That is why nothing in this stack reaches the IdP
      # at `http://idp:8080` — see the `auth/dev-loop` skill.
      ZITADEL_EXTERNALDOMAIN: localhost
      ZITADEL_EXTERNALPORT: ${IDP_PORT:-8080}
      # The declarative boot writes the service account's PAT here, which
      # is what lets forge register the application
      # without a console visit or a seeded secret read out of the IdP's
      # own database.
      ZITADEL_FIRSTINSTANCE_PATPATH: /pat/pat.txt
      # Serve the BUILT-IN (v1) sign-in pages. Zitadel v4 defaults this to
      # `true`, which routes /oauth/v2/authorize at a login UI that ships
      # as a SEPARATE container (ghcr.io/zitadel/zitadel-login) — with
      # that container absent the sign-in page 404s, so the redirect flow
      # dead-ends after a correct-looking authorization request. The v1
      # pages are served by this container and complete the same flow, so
      # one container is the whole IdP. If you later want the v2 login
      # experience, add that image and set this back to true.
      ZITADEL_DEFAULTINSTANCE_FEATURES_LOGINV2_REQUIRED: "false"
      # Do not interrupt the first sign-in with a passkey/2FA enrollment
      # prompt. It is skippable, but it is a screen between a developer
      # and the thing they are actually testing, and a local instance has
      # no SMTP or WebAuthn origin to complete it against.
      #
      # BOTH are needed and they are not the same knob. ForceMFA (already
      # false by default) decides whether MFA is REQUIRED; these decide
      # whether the enrollment NUDGE is shown. PasswordlessType 0 drops
      # the passkey offer, and MfaInitSkipLifetime 0s stops the "set up
      # 2FA" interstitial — with only the first, the sign-in still lands
      # on a 2-Factor Setup screen instead of the callback.
      #
      # A DEV default, not a recommendation: your real IdP is a different
      # issuer and should absolutely prompt.
      ZITADEL_DEFAULTINSTANCE_LOGINPOLICY_PASSWORDLESSTYPE: "0"
      ZITADEL_DEFAULTINSTANCE_LOGINPOLICY_MFAINITSKIPLIFETIME: 0s
    volumes:
      - ./idp-steps.yaml:/steps.yaml:ro
      - ./.forge/idp:/pat
    ports:
      # Loopback-bound and FIXED — this one genuinely cannot float. The
      # issuer in every token Zitadel mints is derived from the origin it
      # is reached on, and both halves of auth have to name that same
      # origin in advance (the browser's oidc_issuer and the backend's
      # jwt_issuer), so a port assigned at launch would leave two
      # declarations pointing nowhere. Override it with IDP_PORT when it
      # collides, and move the declared issuer with it.
      #
      # The FRONTEND's port is a different matter and is NOT pinned: the
      # app registered here runs in dev mode, where Zitadel matches
      # redirect URIs as globs, so the idp-provision job (deploy/kcl/
      # workloads.k) registers http://localhost:*/auth/callback and the
      # frontend keeps whatever port the kernel gives it.
      #
      # Zitadel needs ONE port — its console, APIs and OIDC endpoints are
      # all served here.
      - "127.0.0.1:${IDP_PORT:-8080}:8080"
    depends_on:
      idp-db:
        condition: service_healthy
    healthcheck:
      # /debug/ready is Zitadel's own unauthenticated readiness route. It
      # reports READY rather than merely listening, which matters on the
      # first boot: the declarative setup (schema, instance, org, admin
      # user, PAT) runs before it starts serving. The image is distroless
      # — no wget, no curl, no shell — so probe with the zitadel binary
      # that is guaranteed present.
      test: ["CMD", "/app/zitadel", "ready"]
      interval: 5s
      timeout: 5s
      retries: 30
      start_period: 60s
    networks:
      - {{.ProjectName}}-net

  # The dev IdP's OWN database. Deliberately not the app's.
  #
  # NO PUBLISHED PORT: nothing outside the compose network ever connects to
  # it, so it takes no host port and cannot collide with anything — which
  # also means there is no second port to declare in KCL. The IdP reaches it
  # at `idp-db:5432` on this network.
  #
  # It is only running while the IdP is. `forge env up` starts the IdP, which
  # `depends_on` this and waits for its healthcheck, so it comes and goes
  # with the one service that uses it. A project that drops the IdP from
  # deploy/kcl/dev/main.k starts neither.
  idp-db:
    image: postgres:17-alpine
    restart: unless-stopped
    mem_limit: 256m
    cpus: 0.5
    environment:
      # Fixed, not ${VAR}-driven: these credentials are reachable only from
      # inside this network, they are referenced by the `idp` service above,
      # and making them configurable would be two more values to keep in
      # agreement for no gain.
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      # Zitadel creates its own `zitadel` database on first boot (hence the
      # ADMIN credentials it is given), so this is just the maintenance DB
      # it connects to in order to do that.
      POSTGRES_DB: postgres
    volumes:
      - idp_db_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - {{.ProjectName}}-net
{{- end}}

  # Official ClickStack collector. Do not replace it with otelcol-contrib:
  # ClickStack's collector owns the HyperDX-compatible ClickHouse schemas.
  # Pin source: HyperDX 2.40.0 / hyperdxio/hyperdx@0846f3b2a9d320f83c35fdb36651a67be477f8e4,
  # docker/otel-collector + packages/otel-collector (MIT). The pinned index
  # digest is below; verify the amd64 manifest sha256:fcf8dc7e2f79a99833adfd54cafacfd7857a42d3c12039cbc57a454a70960bf7 before platform changes.
  otel-collector:
    image: clickhouse/clickstack-otel-collector:2.40.0@sha256:0e7dc29f8f6074afd106b96d53e5b98f1150e8882d926a20c03c6f680bd929ec
    restart: unless-stopped
    environment:
      CLICKHOUSE_ENDPOINT: "tcp://clickhouse:9000?dial_timeout=10s"
      HYPERDX_OTEL_EXPORTER_CLICKHOUSE_DATABASE: default
      HYPERDX_LOG_LEVEL: info
      OPAMP_SERVER_URL: "http://hyperdx:4320"
      HYPERDX_OTEL_EXPORTER_CREATE_LEGACY_SCHEMA: "true"
    ports:
      - "127.0.0.1:${OTLP_GRPC_PORT:-4317}:4317"
    depends_on:
      clickhouse:
        condition: service_started
    healthcheck:
      test: ["CMD", "/healthcheck"]
      interval: 5s
      timeout: 3s
      retries: 30
    networks:
      - {{.ProjectName}}-net

  # ClickStack storage. Pin source: ClickHouse/clickstack main (2026-10-08).
  clickhouse:
    image: clickhouse/clickhouse-server:26.1-alpine@sha256:369bd68942569e0effdf0aa68b4f844a74d97b73e281cf8012ce90e9865cc411
    restart: unless-stopped
    environment:
      CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT: 1
    ports:
      - "0:8123" # status checks query the official storage directly
    volumes:
      - clickhouse_data:/var/lib/clickhouse
      - clickhouse_logs:/var/log/clickhouse-server
    networks:
      - {{.ProjectName}}-net

  # HyperDX needs Mongo for application state. MongoDB 5.0 in official
  # ClickStack 2.19.0 Compose is EOL and is not production-suitable. Local
  # Forge uses this pinned supported Mongo 8.0 image; the ClickStack upstream
  # does not publish a compatibility matrix, so TestClickStackMongoCompatibility
  # is the required follow-up gate before upgrading HyperDX or Mongo.
  mongo:
    image: mongo:8.0.14-noble@sha256:877fa303326645cd0e50a3833fce2f3c03d6eb4aac82c97a02e98879f51126d3
    restart: unless-stopped
    volumes:
      - hyperdx_mongo_data:/data/db
    networks:
      - {{.ProjectName}}-net

  # HyperDX UI/API. Pin source: HyperDX CODE_VERSION=2.40.0. The UI gets a
  # dynamic host port; this is an operator UI,
  # not an application dependency or generated dashboard API contract.
  hyperdx:
    image: docker.hyperdx.io/hyperdx/hyperdx:2.40.0@sha256:2fcba6813f5c935f6a3e04123ffe62ab3baf0c1cd53f279b1ec9e300343ddf60
    restart: unless-stopped
    ports:
      - "0:8080"
    environment:
      FRONTEND_URL: http://localhost:8080
      HYPERDX_API_KEY: local-forge-development-key
      HYPERDX_API_PORT: 8000
      HYPERDX_APP_PORT: 8080
      HYPERDX_APP_URL: http://localhost
      HYPERDX_LOG_LEVEL: info
      MINER_API_URL: "http://miner:5123"
      MONGO_URI: "mongodb://mongo:27017/hyperdx"
      SERVER_URL: http://127.0.0.1:8000
      OPAMP_PORT: 4320
      OTEL_EXPORTER_OTLP_ENDPOINT: "http://otel-collector:4318"
      OTEL_SERVICE_NAME: hdx-oss-app
      DEFAULT_CONNECTIONS: '[{"name":"Local ClickHouse","host":"http://clickhouse:8123","username":"default","password":""}]'
    depends_on:
      clickhouse:
        condition: service_started
      mongo:
        condition: service_started
    networks:
      - {{.ProjectName}}-net

  # Profiles are intentionally separate: ClickStack does not provide a proven
  # profiles backend. Alloy sends only pprof profiles to this pinned backend.
  pyroscope:
    image: grafana/pyroscope:1.14.0@sha256:0f63959ffcf217e7046d8f7a3d20cf6909f2924f885fc2f0eec58f87f9acf749
    restart: unless-stopped
    command: ["-target=all"]
    volumes:
      - pyroscope_data:/var/lib/pyroscope
    networks:
      - {{.ProjectName}}-net

  alloy:
    image: grafana/alloy:v1.10.2@sha256:bcf27f18c4402869af112fb39e35e1db3804a404686f4caa20bdf77814219223
    restart: unless-stopped
    volumes:
      - ./deploy/alloy-config.alloy:/etc/alloy/config.alloy:ro
    command: ["run", "/etc/alloy/config.alloy"]
    depends_on:
      pyroscope:
        condition: service_started
    networks:
      - {{.ProjectName}}-net

volumes:
  postgres_data:
  go_mod_cache:
  go_build_cache:
  clickhouse_data:
  clickhouse_logs:
  hyperdx_mongo_data:
  pyroscope_data:
{{- if .HasFrontend}}
  idp_db_data:
{{- end}}

networks:
  {{.ProjectName}}-net:
    driver: bridge
