    check:
        failureThreshold >= 1, "Probes.failureThreshold must be at least 1"
        initialDelaySeconds >= 0, "Probes.initialDelaySeconds must be at least 0"
        livenessPath == Undefined or regex.match(livenessPath, "^/.*$"), "Probes.livenessPath must match ^/.*$"
        livenessPath == Undefined or len(livenessPath) <= 2048, "Probes.livenessPath must be at most 2048 characters"
        periodSeconds >= 1, "Probes.periodSeconds must be at least 1"
        port == Undefined or port >= 1, "Probes.port must be at least 1"
        port == Undefined or port <= 65535, "Probes.port must be at most 65535"
        readinessPath == Undefined or regex.match(readinessPath, "^/.*$"), "Probes.readinessPath must match ^/.*$"
        readinessPath == Undefined or len(readinessPath) <= 2048, "Probes.readinessPath must be at most 2048 characters"
        timeoutSeconds >= 1, "Probes.timeoutSeconds must be at least 1"

