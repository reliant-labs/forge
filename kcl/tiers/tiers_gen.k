schema StaticSite:
    """StaticSiteSpec is a site served from an object-storage bucket, optionally behind a CDN."""
    basePath?: str
    bucket?: str
    cdn?: StaticSiteCDN
    domains?: [str]
    entrypoints?: [str]
    keepReleases?: int
    liveDigest?: str
    previousDigest?: str
