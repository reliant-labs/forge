schema Probes:
    """Probes are a workload's readiness and liveness probes, declared ONCE."""
    failureThreshold: int = 3
    initialDelaySeconds: int = 0
    livenessPath?: str
    periodSeconds: int = 5
    port?: int
    readinessPath?: str
    tcp?: bool
