# ml.k: the ML stack of this env's cluster.
#
# Generated by `forge ml discover` on 2026-11-25 from kube context "gke_acme-ml_us-central1_gpu".
# This file is yours to edit. It adopts what discovery found running (forge never
# upgrades, reconfigures or removes what it did not install) and writes each
# suggested install commented out, under the id of the finding that suggests it.
#
# Wire it into this env's main.k:
#
#     import .ml
#
#     forge.Bundle {
#         ml_stacks = ml.ml_stacks
#     }
import forge

ml_stacks = [forge.MLStack {
    cluster = forge.ClusterTarget {cluster = "gke_acme-ml_us-central1_gpu", namespace = "forge-ml"}
    # What discovery found running that forge did not install: the KCL refuses
    # a forge.Install of any of these kinds.
    observed = [
        "dcgm-exporter"
        "gmp"
        "gpu-operator"
        "kserve"
        "kueue"
        "node-problem-detector"
        "nvidia-device-plugin"
        "vllm"
    ]
    observed_at = "2026-11-25"
    accelerators = [
        # 16 × NVIDIA-A100-SXM4-40GB (nvidia.com/gpu) on 2 nodes, pool a100-pool
        forge.Accelerators {
            vendor = "nvidia"
            metrics = forge.Adopt {
                kind = "dcgm-exporter"
                namespace = "gpu-operator"
                version = "3.3.9-3.6.1-ubuntu22.04"
                note = "managed by the GPU Operator"
                selector = {"app": "nvidia-dcgm-exporter"}
                port = 9400
                # The fields discovery found it exporting (version-default: dcgm-exporter 3.3.9-3.6.1 etc/dcp-metrics-included.csv (default of 3.3.9-3.6.1-ubuntu22.04)).
                allow = [
                    "DCGM_FI_DEV_CORRECTABLE_REMAPPED_ROWS"
                    "DCGM_FI_DEV_DEC_UTIL"
                    "DCGM_FI_DEV_ENC_UTIL"
                    "DCGM_FI_DEV_FB_FREE"
                    "DCGM_FI_DEV_FB_USED"
                    "DCGM_FI_DEV_GPU_TEMP"
                    "DCGM_FI_DEV_GPU_UTIL"
                    "DCGM_FI_DEV_MEMORY_TEMP"
                    "DCGM_FI_DEV_MEM_CLOCK"
                    "DCGM_FI_DEV_MEM_COPY_UTIL"
                    "DCGM_FI_DEV_NVLINK_BANDWIDTH_TOTAL"
                    "DCGM_FI_DEV_PCIE_REPLAY_COUNTER"
                    "DCGM_FI_DEV_POWER_USAGE"
                    "DCGM_FI_DEV_ROW_REMAP_FAILURE"
                    "DCGM_FI_DEV_SM_CLOCK"
                    "DCGM_FI_DEV_TOTAL_ENERGY_CONSUMPTION"
                    "DCGM_FI_DEV_UNCORRECTABLE_REMAPPED_ROWS"
                    "DCGM_FI_DEV_VGPU_LICENSE_STATUS"
                    "DCGM_FI_DEV_XID_ERRORS"
                    "DCGM_FI_DRIVER_VERSION"
                    "DCGM_FI_PROF_DRAM_ACTIVE"
                    "DCGM_FI_PROF_GR_ENGINE_ACTIVE"
                    "DCGM_FI_PROF_PCIE_RX_BYTES"
                    "DCGM_FI_PROF_PCIE_TX_BYTES"
                    "DCGM_FI_PROF_PIPE_TENSOR_ACTIVE"
                ]
            }
        }
    ]
    node_health = forge.Adopt {kind = "node-problem-detector", note = "managed by GKE"}
    queue = forge.Adopt {kind = "kueue", namespace = "kueue-system", version = "v0.10.1"}
    serving = [forge.Adopt {kind = "kserve", namespace = "kserve", version = "v0.14.1"}]
    monitoring = [forge.Adopt {kind = "gmp", note = "managed by GKE"}]
    # Model servers found (workloads, not stack components):
    #   vllm Deployment/llm/llama-predictor
    # Dismiss a finding until a date:
    # decisions = [forge.RecommendationDecision {id = "<finding id>", reason = "<why>", expires = "YYYY-MM-DD"}]
}]
