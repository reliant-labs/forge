{
  "name": "@reliant-labs/web-runtime",
  "version": "0.3.0",
  "description": "The forge frontend runtime: Connect interceptor stack, session, error boundary, toast queue, <Resource> container, W3C trace propagation and client RUM. The web twin of forge/pkg.",
  "license": "BUSL-1.1",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "interceptors",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./interceptors": {
      "types": "./dist/interceptors.d.ts",
      "default": "./dist/interceptors.js"
    },
    "./mock-transport": {
      "types": "./dist/mock-transport.d.ts",
      "default": "./dist/mock-transport.js"
    },
    "./otel": {
      "types": "./dist/otel.d.ts",
      "default": "./dist/otel.js"
    },
    "./service-hooks": {
      "types": "./dist/service-hooks.d.ts",
      "default": "./dist/service-hooks.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.react18.json --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepare": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "vitest run"
  },
  "// peerDependencies note": "@opentelemetry/api is REQUIRED (trace.ts propagates traceparent on every RPC — always on, no collector). The eight SDK packages below it are OPTIONAL: they are imported only by the './otel' subpath, which only the Next.js scaffold reaches. A Vite-SPA or React-Native frontend installs @opentelemetry/api alone and imports the barrel, and must not be told it is missing dependencies it will never resolve.",
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.5.0",
    "@connectrpc/connect": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-web": "^0.54.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/instrumentation": "^0.200.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-web": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": { "optional": true },
    "@opentelemetry/auto-instrumentations-web": { "optional": true },
    "@opentelemetry/core": { "optional": true },
    "@opentelemetry/exporter-trace-otlp-http": { "optional": true },
    "@opentelemetry/instrumentation": { "optional": true },
    "@opentelemetry/resources": { "optional": true },
    "@opentelemetry/sdk-trace-base": { "optional": true },
    "@opentelemetry/sdk-trace-web": { "optional": true },
    "@opentelemetry/semantic-conventions": { "optional": true }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.5.0",
    "@connectrpc/connect": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-web": "^0.54.0",
    "@opentelemetry/core": "^2.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/instrumentation": "^0.200.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-web": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@tanstack/react-query": "^5.59.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-18": "npm:@types/react@~18.3.0",
    "react": "^19.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
